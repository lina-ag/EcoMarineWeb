<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport IA Survzones</title>
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            color: #0f172a;
            font-size: 12px;
            line-height: 1.6;
            margin: 24px;
        }

        h1 {
            font-size: 22px;
            margin: 0 0 8px;
            color: #0f172a;
        }

        .subtitle {
            margin: 0 0 18px;
            color: #475569;
        }

        .meta {
            margin-bottom: 20px;
            padding: 12px 16px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
        }

        .meta p {
            margin: 4px 0;
        }

        .report-box {
            padding: 18px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #f8fafc;
            white-space: pre-wrap;
        }

        .footer {
            margin-top: 24px;
            font-size: 10px;
            color: #64748b;
            text-align: right;
        }
    </style>
</head>
<body>
    <h1>Rapport IA des surveillances</h1>
    <p class="subtitle">Synthese automatique des donnees de surveillance des zones marines</p>

    <div class="meta">
        <p><strong>Date de generation :</strong> {{ generatedAt|date('d/m/Y H:i') }}</p>
        <p><strong>Nombre de surveillances analysees :</strong> {{ survzones|length }}</p>
    </div>

    <div class="report-box">{{ rapport }}</div>

    <div class="footer">
        EcoMarine - Rapport IA Survzone
    </div>
</body>
</html>
