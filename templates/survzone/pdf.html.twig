<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; font-size: 13px; color: #222; }
        h1 { text-align: center; color: #0e7490; margin-bottom: 20px; }
        .date { text-align: right; font-size: 11px; color: #666; margin-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; }
        thead { background-color: #0e7490; color: white; }
        th { padding: 10px; text-align: left; }
        td { padding: 8px 10px; border-bottom: 1px solid #e0e0e0; }
        tr:nth-child(even) { background-color: #f0f9ff; }
        .observation { max-width: 300px; word-wrap: break-word; }
    </style>
</head>
<body>
    <h1>Historique des Surveillances de Zones</h1>
    <div class="date">Généré le {{ "now"|date("d/m/Y à H:i") }}</div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Zone</th>
                <th>Observation</th>
            </tr>
        </thead>
        <tbody>
        {% for survzone in survzones %}
            <tr>
                <td>{{ survzone.idSurv }}</td>
                <td>{{ survzone.dateSurv ? survzone.dateSurv|date('d/m/Y') : '-' }}</td>
                <td>{{ survzone.zone.nomZone }}</td>
                <td class="observation">{{ survzone.observation }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" style="text-align:center;">Aucune surveillance enregistrée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>