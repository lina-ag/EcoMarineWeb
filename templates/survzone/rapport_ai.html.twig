{% extends 'base.html.twig' %}

{% block title %}Rapport IA - Surveillances{% endblock %}

{% block body %}
<section class="glass-card">
    <div class="card-header ai-header">
        <div>
            <h2 class="card-title">Rapport IA des Surveillances</h2>
            <p class="card-subtitle">Genere automatiquement a partir des donnees de surveillance</p>
        </div>

        <div class="ai-actions">
            <a href="{{ path('app_survzone_rapport_ai_export_pdf') }}" class="btn btn-primary">Exporter PDF</a>
            <a href="{{ path('app_survzone_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <div class="rapport-meta">
        <span>{{ survzones|length }} surveillance(s) analysee(s)</span>
    </div>

    <div class="rapport-content">{{ rapport }}</div>
</section>

<style>
    .ai-header {
        gap: 16px;
    }

    .ai-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .rapport-meta {
        margin-top: 10px;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .rapport-content {
        background: rgba(15, 23, 42, 0.28);
        border-radius: 14px;
        padding: 28px;
        margin-top: 20px;
        line-height: 1.8;
        white-space: pre-wrap;
        color: #e2e8f0;
        font-size: 14px;
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    @media (max-width: 768px) {
        .ai-header,
        .ai-actions {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>
{% endblock %}
