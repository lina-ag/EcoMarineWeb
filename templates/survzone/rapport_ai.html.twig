{% extends 'base.html.twig' %}

{% block title %}Rapport IA — Surveillances{% endblock %}

{% block body %}
<section class="glass-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">🤖 Rapport IA des Surveillances</h2>
            <p class="card-subtitle">Généré automatiquement par Google Gemini</p>
        </div>
        <a href="{{ path('app_survzone_index') }}" class="btn btn-secondary">← Retour</a>
    </div>

    <div class="rapport-content" style="
        background: rgba(15, 23, 42, 0.28);
        border-radius: 14px;
        padding: 28px;
        margin-top: 20px;
        line-height: 1.8;
        white-space: pre-wrap;
        color: #e2e8f0;
        font-size: 14px;
        border: 1px solid rgba(148, 163, 184, 0.18);
    ">{{ rapport }}</div>
</section>
{% endblock %}