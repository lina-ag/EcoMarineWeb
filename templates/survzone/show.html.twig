{% extends 'base.html.twig' %}

{% block title %}{{ 'survzone.show_title'|trans({'%id%': survzone.idSurv}) }}{% endblock %}

{% block body %}
<section class="glass-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">{{ 'survzone.show_title'|trans({'%id%': survzone.idSurv}) }}</h2>
            <p class="card-subtitle">{{ 'survzone.show_subtitle'|trans }}</p>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <tbody>
                <tr>
                    <th>{{ 'common.id'|trans }}</th>
                    <td>{{ survzone.idSurv }}</td>
                </tr>

                <tr>
                    <th>{{ 'survzone.fields.date'|trans }}</th>
                    <td>{{ survzone.dateSurv ? survzone.dateSurv|date('Y-m-d') : '' }}</td>
                </tr>

                <tr>
                    <th>{{ 'survzone.fields.observation'|trans }}</th>
                    <td>{{ survzone.observation }}</td>
                </tr>

                <tr>
                    <th>{{ 'survzone.fields.zone'|trans }}</th>
                    <td>{{ survzone.zone ? survzone.zone.nomZone : 'zonep.not_found'|trans }}</td>
                </tr>

                <tr>
                    <th>{{ 'survzone.fields.zone_id'|trans }}</th>
                    <td>{{ survzone.zone ? survzone.zone.idZone : '---' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="btn-group">
        <a href="{{ path('app_survzone_index') }}" class="btn btn-secondary">
            {{ 'common.back_to_list'|trans }}
        </a>

        <a href="{{ path('app_survzone_edit', {'idSurv': survzone.idSurv}) }}" class="btn btn-primary">
            {{ 'common.edit'|trans }}
        </a>

        {{ include('survzone/_delete_form.html.twig') }}
    </div>
</section>
{% endblock %}