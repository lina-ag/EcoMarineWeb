{% extends 'base.html.twig' %}

{% block title %}{{ 'survzone.title'|trans }}{% endblock %}

{% block body %}
    <section class="glass-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">{{ 'survzone.title'|trans }}</h2>
                <p class="card-subtitle">{{ 'survzone.no_records'|trans }}</p>
            </div>
            <a href="{{ path('app_survzone_rapport_ai') }}" class="btn btn-ai">🤖 Rapport IA</a>
            <a href="{{ path('app_survzone_export_excel') }}" class="btn btn-pdf">Export Excel</a>
            <a href="{{ path('app_survzone_export_pdf') }}" class="btn btn-pdf">{{ 'common.export_pdf'|trans }}</a>
            <a href="{{ path('app_survzone_new') }}" class="btn btn-create">{{ 'common.create'|trans }}</a>
        </div>

        <form method="get" action="{{ path('app_survzone_index') }}" class="search-box">
            <input type="hidden" name="tri" value="{{ sortBy }}">
            <input type="hidden" name="sens" value="{{ order }}">
            <div class="search-autocomplete">
                <input
                    type="text"
                    id="searchInput"
                    name="search"
                    value="{{ search|default('') }}"
                    placeholder="{{ 'survzone.search_placeholder'|trans }}"
                    class="search-input"
                    autocomplete="off"
                    aria-autocomplete="list"
                    aria-expanded="false"
                    aria-controls="survzoneAutocompleteList"
                    aria-haspopup="listbox"
                >
                <div id="survzoneAutocompleteList" class="autocomplete-panel" role="listbox" hidden></div>
            </div>
            {% if search is defined and search %}
                <a href="{{ path('app_survzone_index') }}" class="btn btn-reset">{{ 'common.reset'|trans }}</a>
            {% endif %}
        </form>

        {{ include('survzone/_results.html.twig') }}
    </section>

    <style>
        /* ===== CARD HEADER ===== */
        .card-header {
            display: flex !important;
            align-items: center !important;
            gap: 10px !important;
            flex-wrap: wrap !important;
        }

        .card-header > div { flex: 1; }

        /* ===== BOUTONS HEADER ===== */
        .btn-ai, .btn-pdf, .btn-create, .btn-reset {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            height: 38px !important;
            padding: 0 16px !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            border-radius: 10px !important;
            white-space: nowrap !important;
            text-decoration: none !important;
            border: none !important;
            cursor: pointer !important;
            transition: all 0.2s ease !important;
            min-height: unset !important;
            min-width: unset !important;
        }

        .btn-ai {
            background: linear-gradient(135deg, #7c3aed, #6d28d9) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4) !important;
        }

        .btn-ai:hover {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed) !important;
            transform: translateY(-1px) !important;
            color: #ffffff !important;
        }

        .btn-pdf {
            background: rgba(30, 41, 59, 0.85) !important;
            color: #e2e8f0 !important;
            border: 1px solid rgba(148, 163, 184, 0.3) !important;
        }

        .btn-pdf:hover {
            background: rgba(51, 65, 85, 0.95) !important;
            color: #f8fafc !important;
            transform: translateY(-1px) !important;
        }

        .btn-create {
            background: linear-gradient(135deg, #0ea5e9, #0284c7) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(14, 165, 233, 0.4) !important;
        }

        .btn-create:hover {
            background: linear-gradient(135deg, #38bdf8, #0ea5e9) !important;
            transform: translateY(-1px) !important;
            color: #ffffff !important;
        }

        .btn-reset {
            background: rgba(30, 41, 59, 0.85) !important;
            color: #e2e8f0 !important;
            border: 1px solid rgba(148, 163, 184, 0.3) !important;
        }

        .btn-reset:hover {
            background: rgba(51, 65, 85, 0.95) !important;
            color: #f8fafc !important;
        }

        /* ===== SEARCH BOX ===== */
        .search-box {
            margin: 16px 0 12px 0;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .search-autocomplete {
            position: relative;
            width: 300px;
        }

        .search-input {
            width: 100% !important;
            height: 40px !important;
            border-radius: 10px !important;
            border: 1px solid rgba(148, 163, 184, 0.25) !important;
            background: rgba(15, 23, 42, 0.35) !important;
            color: #e2e8f0 !important;
            font-size: 13px !important;
            padding: 8px 14px !important;
            outline: none !important;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12) !important;
            transition: border-color 0.2s, box-shadow 0.2s !important;
            min-width: unset !important;
            min-height: unset !important;
        }

        .search-input::placeholder { color: #94a3b8 !important; }

        .search-input:focus {
            border-color: rgba(56, 189, 248, 0.5) !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
        }

        .autocomplete-panel {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            z-index: 30;
            overflow: hidden;
            border-radius: 14px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: rgba(15, 23, 42, 0.98);
            box-shadow: 0 18px 38px rgba(2, 6, 23, 0.34);
            backdrop-filter: blur(12px);
        }

        .autocomplete-item {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 11px 14px;
            border: 0;
            background: transparent;
            color: #e2e8f0;
            font-size: 13px;
            text-align: left;
            cursor: pointer;
            transition: background-color 0.16s ease, color 0.16s ease;
        }

        .autocomplete-item:hover,
        .autocomplete-item.is-active {
            background: rgba(56, 189, 248, 0.15);
            color: #f8fafc;
        }

        .autocomplete-empty {
            padding: 11px 14px;
            color: #94a3b8;
            font-size: 13px;
        }

        /* ===== BOUTONS VOIR/MODIFIER INLINE ===== */
        .data-table tbody tr td:last-child {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            flex-wrap: nowrap !important;
            padding: 8px 10px !important;
        }

        .data-table tbody tr td:last-child a {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            height: 30px !important;
            padding: 0 12px !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            border-radius: 8px !important;
            white-space: nowrap !important;
            text-decoration: none !important;
            min-height: unset !important;
            min-width: unset !important;
            transition: all 0.2s ease !important;
        }

        .data-table tbody tr td:last-child .btn-secondary {
            background: rgba(30, 41, 59, 0.8) !important;
            color: #e2e8f0 !important;
            border: 1px solid rgba(148, 163, 184, 0.3) !important;
        }

        .data-table tbody tr td:last-child .btn-secondary:hover {
            background: rgba(51, 65, 85, 0.95) !important;
            color: #f8fafc !important;
        }

        .data-table tbody tr td:last-child .btn-primary {
            background: linear-gradient(135deg, #0ea5e9, #0284c7) !important;
            color: #ffffff !important;
            border: none !important;
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.35) !important;
        }

        .data-table tbody tr td:last-child .btn-primary:hover {
            background: linear-gradient(135deg, #38bdf8, #0ea5e9) !important;
            color: #ffffff !important;
        }

        /* ===== THEAD ===== */
        thead a {
            color: inherit !important;
            text-decoration: none !important;
            display: flex !important;
            align-items: center !important;
            gap: 4px !important;
        }

        thead a:hover { color: #38bdf8 !important; }
    </style>

    <script>
        const searchInput = document.getElementById('searchInput');
        const autocompleteList = document.getElementById('survzoneAutocompleteList');
        let searchTimer;
        let autocompleteTimer;
        let activeSuggestionIndex = -1;
        let currentSuggestions = [];

        function getSearchValue(fallback = '') {
            return (searchInput.value || fallback || '').trim();
        }

        function buildSearchUrl(value = getSearchValue()) {
            const url = new URL('{{ path('app_survzone_index') }}', window.location.origin);
            url.searchParams.set('tri', '{{ sortBy }}');
            url.searchParams.set('sens', '{{ order }}');
            url.searchParams.set('search', value);
            url.searchParams.set('page', '1');
            return url;
        }

        function refreshResults(value = getSearchValue()) {
            const url = buildSearchUrl(value);
            fetch(url.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            })
            .then((response) => response.text())
            .then((html) => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const nextResults = doc.getElementById('survzoneResults');
                if (nextResults) {
                    document.getElementById('survzoneResults').innerHTML = nextResults.innerHTML;
                    window.history.replaceState({}, '', url.toString());
                }
            });
        }

        function queueRefresh(value) {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => refreshResults(value), 250);
        }

        function updateSuggestions(items) {
            currentSuggestions = items;
            activeSuggestionIndex = -1;
            autocompleteList.innerHTML = '';

            if (!items.length) {
                closeSuggestions();
                return;
            }

            items.forEach((item, index) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'autocomplete-item';
                button.setAttribute('role', 'option');
                button.dataset.index = String(index);
                button.textContent = item.value || item.text || '';
                button.addEventListener('mousedown', (event) => {
                    event.preventDefault();
                    applySuggestion(index);
                });
                autocompleteList.appendChild(button);
            });

            openSuggestions();
        }

        function fetchSuggestions(value) {
            const query = (value || '').trim();
            if (query.length < 1) {
                updateSuggestions([]);
                return;
            }

            const url = new URL('{{ path('app_survzone_search_autocomplete') }}', window.location.origin);
            url.searchParams.set('query', query);

            fetch(url.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            })
            .then((response) => response.json())
            .then((data) => {
                if (query !== getSearchValue()) {
                    return;
                }

                updateSuggestions(data.results || []);
            })
            .catch(() => updateSuggestions([]));
        }

        function queueSuggestions(value) {
            clearTimeout(autocompleteTimer);
            autocompleteTimer = setTimeout(() => fetchSuggestions(value), 150);
        }

        function openSuggestions() {
            autocompleteList.hidden = false;
            searchInput.setAttribute('aria-expanded', 'true');
        }

        function closeSuggestions() {
            autocompleteList.hidden = true;
            searchInput.setAttribute('aria-expanded', 'false');
            activeSuggestionIndex = -1;
            syncActiveSuggestion();
        }

        function syncActiveSuggestion() {
            autocompleteList.querySelectorAll('.autocomplete-item').forEach((item, index) => {
                item.classList.toggle('is-active', index === activeSuggestionIndex);
            });
        }

        function applySuggestion(index) {
            const suggestion = currentSuggestions[index];
            if (!suggestion) {
                return;
            }

            searchInput.value = suggestion.value || suggestion.text || '';
            closeSuggestions();
            refreshResults(searchInput.value);
        }

        searchInput.addEventListener('input', function () {
            queueRefresh(this.value);
            queueSuggestions(this.value);
        });

        searchInput.addEventListener('change', function () {
            refreshResults(this.value);
        });

        searchInput.addEventListener('focus', function () {
            if (this.value.trim() !== '') {
                fetchSuggestions(this.value);
            }
        });

        searchInput.addEventListener('keydown', function (event) {
            if (autocompleteList.hidden || !currentSuggestions.length) {
                return;
            }

            if (event.key === 'ArrowDown') {
                event.preventDefault();
                activeSuggestionIndex = (activeSuggestionIndex + 1) % currentSuggestions.length;
                syncActiveSuggestion();
                return;
            }

            if (event.key === 'ArrowUp') {
                event.preventDefault();
                activeSuggestionIndex = activeSuggestionIndex <= 0
                    ? currentSuggestions.length - 1
                    : activeSuggestionIndex - 1;
                syncActiveSuggestion();
                return;
            }

            if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                event.preventDefault();
                applySuggestion(activeSuggestionIndex);
                return;
            }

            if (event.key === 'Escape') {
                closeSuggestions();
            }
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.search-autocomplete')) {
                closeSuggestions();
            }
        });
    </script>
{% endblock %}
