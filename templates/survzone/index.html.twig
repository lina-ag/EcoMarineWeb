{% extends 'base.html.twig' %}

{% block title %}{{ 'survzone.title'|trans }}{% endblock %}

{% block body %}
    <section class="glass-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">{{ 'survzone.title'|trans }}</h2>
                <p class="card-subtitle">{{ 'survzone.no_records'|trans }}</p>
            </div>
            <a href="{{ path('app_survzone_rapport_ai') }}" class="btn btn-primary">🤖 Rapport IA</a>
            <a href="{{ path('app_survzone_export_pdf') }}" class="btn btn-secondary">{{ 'common.export_pdf'|trans }}</a>
            <a href="{{ path('app_survzone_new') }}" class="btn btn-primary">{{ 'common.create'|trans }}</a>
        </div>

        <form method="get" action="{{ path('app_survzone_index') }}" class="search-box">
            <input type="hidden" name="tri" value="{{ sortBy }}">
            <input type="hidden" name="sens" value="{{ order }}">
            <input
                type="text"
                id="searchInput"
                name="search"
                value="{{ search|default('') }}"
                placeholder="{{ 'survzone.search_placeholder'|trans }}"
                class="search-input"
                autocomplete="off"
                data-controller="symfony--ux-autocomplete--autocomplete"
                data-symfony--ux-autocomplete--autocomplete-url-value="{{ path('app_survzone_search_autocomplete') }}"
                data-symfony--ux-autocomplete--autocomplete-min-characters-value="1"
                data-symfony--ux-autocomplete--autocomplete-preload-value="focus"
            >
            {% if search is defined and search %}
                <a href="{{ path('app_survzone_index') }}" class="btn btn-secondary">{{ 'common.reset'|trans }}</a>
            {% endif %}
        </form>

        {{ include('survzone/_results.html.twig') }}

    </section>

    <style>
        .search-box {
            margin: 24px 0 18px 0;
            display: flex;
            justify-content: flex-start;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-input,
        .search-box .ts-wrapper.single .ts-control,
        .search-box .ts-wrapper.multi .ts-control {
            min-width: min(100%, 420px);
            min-height: 48px;
            border-radius: 14px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: rgba(15, 23, 42, 0.28);
            color: #e2e8f0;
            font-size: 14px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .search-input {
            padding: 12px 16px;
            outline: none;
        }

        .search-input::placeholder {
            color: #94a3b8;
        }

        .search-input:focus,
        .search-box .ts-wrapper.focus .ts-control,
        .search-box .ts-wrapper.single.focus .ts-control {
            border-color: rgba(56, 189, 248, 0.5);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.16);
        }

        .search-box .ts-wrapper {
            min-width: min(100%, 420px);
        }

        .search-box .ts-wrapper .ts-control {
            padding: 8px 14px;
        }

        .search-box .ts-wrapper .ts-control input {
            color: #e2e8f0;
            font-size: 14px;
        }

        .search-box .ts-wrapper .ts-control input::placeholder {
            color: #94a3b8;
        }

        .search-box .ts-wrapper.single .ts-control:after {
            border-color: #7dd3fc transparent transparent transparent;
        }

        .search-box .ts-wrapper.single.dropdown-active .ts-control:after {
            border-color: transparent transparent #7dd3fc transparent;
        }

        .search-box .ts-dropdown {
            margin-top: 8px;
            border-radius: 14px;
            border: 1px solid rgba(148, 163, 184, 0.16);
            background: rgba(15, 23, 42, 0.96);
            color: #e2e8f0;
            overflow: hidden;
            box-shadow: 0 18px 40px rgba(2, 6, 23, 0.35);
        }

        .search-box .ts-dropdown .option,
        .search-box .ts-dropdown .create,
        .search-box .ts-dropdown .no-results {
            padding: 12px 14px;
            font-size: 14px;
        }

        .search-box .ts-dropdown .active {
            background: rgba(56, 189, 248, 0.16);
            color: #f8fafc;
        }

        .search-box .btn.btn-secondary {
            min-height: 48px;
            border-radius: 14px;
            padding: 0 18px;
            font-weight: 600;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.16);
        }

        thead a { color: inherit; text-decoration: none; display: flex; align-items: center; gap: 4px; }
        thead a:hover { color: var(--emerald-light, #38bdf8); }
    </style>

    <script>
        const searchInput = document.getElementById('searchInput');
        let searchTimer;

        function getSearchValue(fallback = '') {
            if (searchInput.tomselect) {
                const selectedValue = searchInput.tomselect.getValue();
                const typedValue = searchInput.tomselect.control_input ? searchInput.tomselect.control_input.value : '';

                return (typedValue || selectedValue || fallback || '').trim();
            }

            return (searchInput.value || fallback || '').trim();
        }

        function buildSearchUrl(value = getSearchValue()) {
            const url = new URL('{{ path('app_survzone_index') }}', window.location.origin);
            url.searchParams.set('tri', '{{ sortBy }}');
            url.searchParams.set('sens', '{{ order }}');
            url.searchParams.set('search', value);
            url.searchParams.set('page', '1');

            return url;
        }

        function refreshResults(value = getSearchValue()) {
            const url = buildSearchUrl(value);

            fetch(url.toString(), {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
                .then((response) => response.text())
                .then((html) => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const nextResults = doc.getElementById('survzoneResults');

                    if (nextResults) {
                        document.getElementById('survzoneResults').innerHTML = nextResults.innerHTML;
                        window.history.replaceState({}, '', url.toString());
                    }
                });
        }

        function queueRefresh(value) {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => refreshResults(value), 250);
        }

        searchInput.addEventListener('input', function () {
            queueRefresh(this.value);
        });

        function attachTomSelectListeners() {
            if (!searchInput.tomselect) {
                window.setTimeout(attachTomSelectListeners, 100);
                return;
            }

            searchInput.tomselect.on('type', function (value) {
                queueRefresh(value);
            });

            searchInput.tomselect.on('change', function (value) {
                refreshResults(value);
            });

            searchInput.tomselect.on('clear', function () {
                refreshResults('');
            });

            if (searchInput.tomselect.control_input) {
                searchInput.tomselect.control_input.addEventListener('input', function () {
                    queueRefresh(this.value);
                });
            }
        }

        attachTomSelectListeners();
    </script>
{% endblock %}