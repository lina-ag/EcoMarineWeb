<form method="post" action="{{ path('app_survzone_delete', {'idSurv': survzone.idSurv}) }}" onsubmit="return confirm('{{ 'survzone.confirm_delete'|trans({'{date}': survzone.dateSurv ? survzone.dateSurv|date('Y-m-d') : '-'})|e('js') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ survzone.idSurv) }}">
    <button class="btn btn-secondary" type="submit">{{ 'common.delete'|trans }}</button>
</form>
