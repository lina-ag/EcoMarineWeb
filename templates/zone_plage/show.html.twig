{% extends 'base.html.twig' %}

{% block title %}Zone Plage{% endblock %}

{% block body %}
<link rel="stylesheet" href="/assets_admin/module-plage.css">

<section class="module-shell">
    <div class="module-hero glass-card">
        <div class="module-title-wrap">
            <h1>{{ zone_plage.nom }}</h1>
            <p>Détail complet de la zone de plage.</p>
        </div>
        <div class="module-actions">
            <a href="{{ path('app_zone_plage_edit', {'id_zone': zone_plage.id_zone}) }}" class="btn btn-primary">Modifier</a>
            <a href="{{ path('app_zone_plage_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <div class="glass-card">
        <table class="details-table">
            <tr><th>ID</th><td>{{ zone_plage.idZone }}</td></tr>
            <tr><th>Nom</th><td>{{ zone_plage.nom }}</td></tr>
            <tr><th>Localisation</th><td>{{ zone_plage.localisation }}</td></tr>
            <tr><th>Statut</th><td>{{ zone_plage.statut }}</td></tr>
        </table>
    </div>
</section>
{% endblock %}
