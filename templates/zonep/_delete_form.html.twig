<form method="post" action="{{ path('app_zonep_delete', {'idZone': zonep.idZone}) }}" onsubmit="return confirm('{{ 'zonep.confirm_delete'|trans({'{name}': zonep.nomZone})|e('js') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ zonep.idZone) }}">
    <button class="btn btn-secondary" type="submit">{{ 'common.delete'|trans }}</button>
</form>
