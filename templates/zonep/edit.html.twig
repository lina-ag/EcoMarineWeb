{% extends 'base.html.twig' %}

{% block title %}{{ 'zonep.edit_title'|trans }}{% endblock %}

{% block body %}
    <section class="glass-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">{{ 'zonep.edit_title'|trans }}</h2>
                <p class="card-subtitle">{{ 'zonep.edit_subtitle'|trans }}</p>
            </div>
        </div>

        {{ include('zonep/_form.html.twig', {'button_label': 'common.update'|trans}) }}

        <div class="btn-group">
            <a href="{{ path('app_zonep_index') }}" class="btn btn-secondary">{{ 'common.back_to_list'|trans }}</a>
            {{ include('zonep/_delete_form.html.twig') }}
        </div>
    </section>
{% endblock %}
