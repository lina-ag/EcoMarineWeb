{{ form_start(form, {'attr': {'class': 'reservation-form', 'novalidate': 'novalidate'}}) }}
    <div class="form-grid">
        <div class="form-group-settings">
            {{ form_label(form.nomZone, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nomZone, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.nomZone) }}
        </div>

        <div class="form-group-settings">
            {{ form_label(form.categorieZone, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.categorieZone, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.categorieZone) }}
        </div>

        <div class="form-group-settings full-width">
            {{ form_label(form.status, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.status, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.status) }}
        </div>
    </div>

    <div class="btn-group">
        <button class="btn btn-primary">{{ button_label|default('common.save'|trans) }}</button>
    </div>

    {{ form_rest(form) }}
{{ form_end(form) }}
