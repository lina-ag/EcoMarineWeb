{% extends 'base.html.twig' %}

{% block title %}{{ 'zonep.title'|trans }}{% endblock %}

{% block body %}
<section class="glass-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">{{ 'zonep.title'|trans }}</h2>
            <p class="card-subtitle">{{ 'zonep.no_records'|trans }}</p>
        </div>

        <div style="display:flex; gap:10px;">
            <a href="{{ path('app_zonep_export_pdf') }}" class="btn btn-secondary">
                {{ 'common.export_pdf'|trans }}
            </a>
            <a href="{{ path('app_zonep_new') }}" class="btn btn-primary">
                + {{ 'common.create'|trans }}
            </a>
        </div>
    </div>

    <form method="GET" action="{{ path('app_zonep_index') }}" class="toolbar" id="filterForm">
        <input type="hidden" name="tri" id="triInput" value="{{ sortBy }}">
        <input type="hidden" name="sens" id="sensInput" value="{{ order }}">
        <input type="hidden" name="status" id="statusInput" value="{{ status }}">

        <div class="search-box">
            <input
                type="text"
                name="search"
                id="searchInput"
                value="{{ search }}"
                placeholder="{{ 'zonep.search_placeholder'|trans }}"
                class="search-input"
                autocomplete="off"
            >
        </div>

        <div class="filter-btns">
            <button type="button" class="filter-btn {{ status == '' ? 'active' : '' }}" data-status="">
                Tous
            </button>
            <button type="button" class="filter-btn {{ status == 'Actif' ? 'active' : '' }}" data-status="Actif">
                {{ 'status.actif'|trans }}
            </button>
            <button type="button" class="filter-btn {{ status == 'En surveillance' ? 'active' : '' }}" data-status="En surveillance">
                {{ 'status.en_surveillance'|trans }}
            </button>
            <button type="button" class="filter-btn {{ status == 'En maintenance' ? 'active' : '' }}" data-status="En maintenance">
                {{ 'status.en_maintenance'|trans }}
            </button>
            <button type="button" class="filter-btn {{ status == 'Inactif' ? 'active' : '' }}" data-status="Inactif">
                {{ 'status.inactif'|trans }}
            </button>
        </div>

        {% if search or status %}
            <a href="{{ path('app_zonep_index') }}" class="btn btn-secondary">
                {{ 'common.reset'|trans }}
            </a>
        {% endif %}
    </form>

    {{ include('zonep/_results.html.twig') }}

    <div
        class="zonep-map-panel"
        data-controller="zonep-map"
        data-zonep-map-default-style-value="night"
        data-action="ux:map:connect->zonep-map#registerMap"
    >
        <div class="zonep-map-toolbar">
            <div>
                <h3 class="zonep-map-title">{{ 'zonep.map.title'|trans }}</h3>
                <p class="zonep-map-subtitle">{{ 'zonep.map.subtitle'|trans }}</p>
            </div>

            <div class="zonep-map-switch" role="group" aria-label="{{ 'zonep.map.title'|trans }}">
                <button
                    type="button"
                    class="zonep-map-style-btn is-active"
                    data-zonep-map-target="button"
                    data-style-name="night"
                    data-action="zonep-map#switchStyle"
                    data-zonep-map-style-param="night"
                >
                    {{ 'zonep.map.styles.night'|trans }}
                </button>
                <button
                    type="button"
                    class="zonep-map-style-btn"
                    data-zonep-map-target="button"
                    data-style-name="minimal"
                    data-action="zonep-map#switchStyle"
                    data-zonep-map-style-param="minimal"
                >
                    {{ 'zonep.map.styles.minimal'|trans }}
                </button>
                <button
                    type="button"
                    class="zonep-map-style-btn"
                    data-zonep-map-target="button"
                    data-style-name="satellite"
                    data-action="zonep-map#switchStyle"
                    data-zonep-map-style-param="satellite"
                >
                    {{ 'zonep.map.styles.satellite'|trans }}
                </button>
            </div>
        </div>

        <div id="map-container" class="zonep-map-canvas">
            {{ render_map(map, {'style': 'height: 400px; width: 100%;'}) }}
        </div>
    </div>
</section>

<script>
    let searchTimer;

    function doFetch() {
        const search = document.getElementById('searchInput').value;
        const status = document.getElementById('statusInput').value;
        const tri = document.getElementById('triInput').value;
        const sens = document.getElementById('sensInput').value;

        const url = new URL(window.location.origin + '{{ path('app_zonep_index') }}');
        url.searchParams.set('search', search);
        url.searchParams.set('status', status);
        url.searchParams.set('tri', tri);
        url.searchParams.set('sens', sens);
        url.searchParams.set('page', '1');

        fetch(url.toString(), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.text())
        .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const nextResults = doc.getElementById('zonepResults');

            if (nextResults) {
                document.getElementById('zonepResults').innerHTML = nextResults.innerHTML;
            }

            window.history.pushState({}, '', url.toString());
        });
    }

    document.getElementById('searchInput').addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(doFetch, 300);
    });

    document.querySelectorAll('.filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('statusInput').value = this.dataset.status;

            document.querySelectorAll('.filter-btn')
                .forEach(b => b.classList.remove('active'));

            this.classList.add('active');

            doFetch();
        });
    });
</script>

    <style>
        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 24px 0 16px 0;
            flex-wrap: wrap;
        }
        .search-input {
            padding: 12px 18px;
            border-radius: 12px;
            border: 1px solid var(--glass-border, #e0e0e0);
            background: var(--glass-bg, #fff);
            color: var(--text-primary, #222);
            font-size: 15px;
            min-width: 260px;
            box-shadow: 0 2px 8px rgba(56, 189, 248, 0.04);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .search-input:focus {
            border-color: var(--emerald-light, #38bdf8);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.15);
        }
        .filter-btns { display: flex; gap: 8px; flex-wrap: wrap; }
        .filter-btn {
            padding: 8px 16px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.05);
            color: var(--text-secondary, #94a3b8);
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .filter-btn:hover { background: rgba(255,255,255,0.1); color: var(--text-primary, #f1f5f9); }
        .filter-btn.active {
            background: rgba(56, 189, 248, 0.15);
            color: var(--emerald-light, #38bdf8);
            border-color: rgba(56, 189, 248, 0.3);
            font-weight: 600;
        }
        thead a { color: inherit; text-decoration: none; display: flex; align-items: center; gap: 4px; }
        thead a:hover { color: var(--emerald-light, #38bdf8); }
        .pagination { margin-top: 20px; display: flex; justify-content: center; }
        .badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-actif { background: rgba(52,211,153,0.15); color: #34d399; border: 1px solid rgba(52,211,153,0.3); }
        .badge-surveillance { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); }
        .badge-maintenance { background: rgba(129,140,248,0.15); color: #818cf8; border: 1px solid rgba(129,140,248,0.3); }
        .badge-inactif { background: rgba(248,113,113,0.15); color: #f87171; border: 1px solid rgba(248,113,113,0.3); }
        .zonep-map-panel {
            margin-top: 24px;
            padding: 18px;
            border-radius: 20px;
            background: rgba(15, 23, 42, 0.45);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
        }
        .zonep-map-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }
        .zonep-map-title {
            margin: 0;
            font-size: 18px;
            color: var(--text-primary, #f8fafc);
        }
        .zonep-map-subtitle {
            margin: 6px 0 0;
            color: var(--text-secondary, #94a3b8);
            font-size: 14px;
        }
        .zonep-map-switch {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 6px;
            border-radius: 16px;
            background: rgba(15, 23, 42, 0.72);
            border: 1px solid rgba(148, 163, 184, 0.18);
        }
        .zonep-map-style-btn {
            padding: 10px 14px;
            border: 0;
            border-radius: 12px;
            background: transparent;
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        }
        .zonep-map-style-btn:hover {
            background: rgba(148, 163, 184, 0.12);
            color: #f8fafc;
        }
        .zonep-map-style-btn.is-active {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.28), rgba(14, 165, 233, 0.18));
            color: #f8fafc;
            box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.3);
        }
        .zonep-map-canvas {
            height: 400px;
            width: 100%;
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid rgba(148, 163, 184, 0.18);
        }
        .zonep-map-canvas > div {
            height: 100%;
            width: 100%;
        }
        @media (max-width: 768px) {
            .zonep-map-panel {
                padding: 14px;
            }
            .zonep-map-switch {
                width: 100%;
            }
            .zonep-map-style-btn {
                flex: 1 1 120px;
                text-align: center;
            }
        }
    </style>
{% endblock %}
