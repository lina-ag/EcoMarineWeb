{% extends 'base.html.twig' %}
{% block title %}Zonep index{% endblock %}
{% block body %}
    <section class="glass-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Zones</h2>
                <p class="card-subtitle">Liste des zones et leur statut actuel.</p>
            </div>
            <a href="{{ path('app_zonep_export_pdf') }}" class="btn btn-secondary">Export PDF</a>
            <a href="{{ path('app_zonep_new') }}" class="btn btn-primary">Create new</a>
        </div>

        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Rechercher par nom de zone..." class="search-input">
        </div>

        <div class="table-wrapper">
            <table class="data-table" id="zonepTable">
<thead>
    <tr>
        <th><a href="{{ path('app_zonep_index', {'tri': 'idZone', 'sens': sortBy == 'idZone' and order == 'ASC' ? 'DESC' : 'ASC', 'page': 1}) }}">Id {{ sortBy == 'idZone' ? (order == 'ASC' ? '↑' : '↓') : '↕' }}</a></th>
        <th><a href="{{ path('app_zonep_index', {'tri': 'nomZone', 'sens': sortBy == 'nomZone' and order == 'ASC' ? 'DESC' : 'ASC', 'page': 1}) }}">Nom zone {{ sortBy == 'nomZone' ? (order == 'ASC' ? '↑' : '↓') : '↕' }}</a></th>
        <th><a href="{{ path('app_zonep_index', {'tri': 'categorieZone', 'sens': sortBy == 'categorieZone' and order == 'ASC' ? 'DESC' : 'ASC', 'page': 1}) }}">Categorie {{ sortBy == 'categorieZone' ? (order == 'ASC' ? '↑' : '↓') : '↕' }}</a></th>
        <th><a href="{{ path('app_zonep_index', {'tri': 'status', 'sens': sortBy == 'status' and order == 'ASC' ? 'DESC' : 'ASC', 'page': 1}) }}">Status {{ sortBy == 'status' ? (order == 'ASC' ? '↑' : '↓') : '↕' }}</a></th>
        <th>Actions</th>
    </tr>
</thead>
                <tbody>
                {% for zonep in zoneps %}
                    <tr class="search-row">
                        <td>{{ zonep.idZone }}</td>
                        <td>{{ zonep.nomZone }}</td>
                        <td>{{ zonep.categorieZone }}</td>
                        <td>{{ zonep.status }}</td>
                        <td>
                            <a href="{{ path('app_zonep_show', {'idZone': zonep.idZone}) }}" class="btn btn-secondary">show</a>
                            <a href="{{ path('app_zonep_edit', {'idZone': zonep.idZone}) }}" class="btn btn-primary">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr class="no-results">
                        <td colspan="5">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="pagination">
            {{ knp_pagination_render(zoneps) }}
        </div>
    </section>

    <script>
        document.getElementById('searchInput').addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const rows = document.querySelectorAll('.search-row');
            rows.forEach(function(row) {
                const nomZone = row.cells[1].textContent.toLowerCase();
                row.style.display = nomZone.includes(searchTerm) ? '' : 'none';
            });
            const visibleRows = document.querySelectorAll('.search-row:not([style*="display: none"])');
            const noResults = document.querySelector('.no-results');
            if (noResults) {
                noResults.style.display = visibleRows.length === 0 ? '' : 'none';
            }
        });
    </script>

    <style>
        .search-box {
            margin: 24px 0 16px 0;
            display: flex;
            justify-content: flex-start;
        }
        .search-input {
            padding: 12px 18px;
            border-radius: 12px;
            border: 1px solid var(--glass-border, #e0e0e0);
            background: var(--glass-bg, #fff);
            color: var(--text-primary, #222);
            font-size: 15px;
            min-width: 260px;
            box-shadow: 0 2px 8px rgba(56, 189, 248, 0.04);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .search-input:focus {
            border-color: var(--emerald-light, #38bdf8);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.15);
        }
        thead a {
            color: inherit;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        thead a:hover {
            color: var(--emerald-light, #38bdf8);
        }
        .pagination {
            margin-top: 20px;
            display: flex;
            justify-content: center;
        }
    </style>
{% endblock %}