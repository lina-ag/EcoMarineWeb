<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Liste des réservations</title>
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 11px;
            color: #0f172a;
            margin: 20px;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 20px;
            color: #1e3a8a;
        }

        .meta {
            margin: 0 0 14px;
            color: #475569;
            font-size: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #cbd5e1;
            padding: 5px 7px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #dbeafe;
            color: #1e3a8a;
            font-weight: 700;
        }

        tr:nth-child(even) td {
            background: #f8fafc;
        }
    </style>
</head>
<body>
    <h1>Liste des réservations</h1>
    <p class="meta">Généré le {{ generatedAt|date('d/m/Y H:i') }}</p>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Activité</th>
                <th>Date réservation</th>
                <th>Email</th>
                <th>Nombre personnes</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                {% set reservationStatus = reservation.activiteEcologique ? (reservation.dateReservation and reservation.dateReservation|date('Y-m-d') > "now"|date('Y-m-d') ? 'En attente' : 'Confirmée') : 'Annulée' %}
                <tr>
                    <td>{{ reservation.idReservation }}</td>
                    <td>{{ reservation.nom }}</td>
                    <td>{{ reservation.activiteEcologique ? reservation.activiteEcologique.nomActivite : 'Activité annulée' }}</td>
                    <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '' }}</td>
                    <td>{{ reservation.email }}</td>
                    <td>{{ reservation.nombrePersonnes }}</td>
                    <td>{{ reservationStatus }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucune réservation enregistrée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
