{% set reservation_form_options = {'attr': {'class': 'reservation-form', 'novalidate': 'novalidate'}} %}
{% if form_action is defined and form_action %}
    {% set reservation_form_options = reservation_form_options|merge({'action': form_action}) %}
{% endif %}

{{ form_start(form, reservation_form_options) }}
    {{ form_errors(form) }}
    <div class="form-grid">
        <div class="form-group-settings">
            {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-input', 'placeholder': 'Nom complet'}}) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="form-group-settings">
            {{ form_label(form.date_reservation_choice, null, {'label_attr': {'class': 'form-label'}}) }}
            <select
                id="{{ form.date_reservation_choice.vars.id }}"
                name="{{ form.date_reservation_choice.vars.full_name }}"
                class="form-input"
                required
            >
                <option value="">-- Choisissez une date --</option>
                {% if form.date_reservation_choice.vars.value %}
                    <option value="{{ form.date_reservation_choice.vars.value }}" selected>{{ form.date_reservation_choice.vars.value }}</option>
                {% endif %}
            </select>
            {% do form.date_reservation_choice.setRendered() %}
            <div style="display:none;">
                {{ form_widget(form.date_reservation) }}
            </div>
            <small id="activity-date-hint" style="display:block; margin-top:6px; color:#b91c1c; font-weight:600;">
                Choisissez d'abord une activité pour voir la date autorisée.
            </small>
            {{ form_errors(form.date_reservation_choice) }}
        </div>

        <div class="form-group-settings">
            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-input', 'placeholder': 'email@exemple.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group-settings">
            {{ form_label(form.nombre_personnes, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nombre_personnes, {'attr': {'class': 'form-input', 'min': 1, 'max': 50}}) }}
            {{ form_errors(form.nombre_personnes) }}
        </div>

        <div class="form-group-settings full-width">
            {{ form_label(form.activiteEcologique, null, {'label_attr': {'class': 'form-label'}}) }}
            <div class="capacity-select-shell">
                {{ form_widget(form.activiteEcologique, {'attr': {'class': 'form-input capacity-select'}}) }}
                <div id="activity-capacity-status" class="capacity-status capacity-status-default">
                    <div class="capacity-status-topline">
                        <div class="capacity-status-copy">
                            <span class="capacity-status-dot" aria-hidden="true"></span>
                            <div>
                                <div class="capacity-status-title">Capacité de l'activité</div>
                                <div class="capacity-status-text">Sélectionnez une activité.</div>
                            </div>
                        </div>
                        <span class="capacity-status-pill">--</span>
                    </div>
                    <div class="capacity-metrics" aria-hidden="true">
                        <div class="capacity-metric">
                            <span class="capacity-metric-label">Occupées</span>
                            <strong class="capacity-metric-value" data-capacity-used>0</strong>
                        </div>
                        <div class="capacity-metric">
                            <span class="capacity-metric-label">Restantes</span>
                            <strong class="capacity-metric-value" data-capacity-remaining>0</strong>
                        </div>
                        <div class="capacity-metric">
                            <span class="capacity-metric-label">Total</span>
                            <strong class="capacity-metric-value" data-capacity-total>0</strong>
                        </div>
                    </div>
                    <div class="capacity-progress" aria-hidden="true">
                        <span class="capacity-progress-fill" style="width:0%;"></span>
                    </div>
                </div>
            </div>
            {{ form_errors(form.activiteEcologique) }}
        </div>
    </div>

    <div class="btn-group">
        <button class="btn btn-primary" style="width: 100%; max-width: 100%;">{{ button_label|default('Enregistrer') }}</button>
    </div>

    {{ form_rest(form) }}
{{ form_end(form) }}

<script>
(() => {
    const translate = window.ecomarineTrans || ((message) => message);
    const activitySelect = document.getElementById('{{ form.activiteEcologique.vars.id }}');
    const dateSelect = document.getElementById('{{ form.date_reservation_choice.vars.id }}');
    const dateHiddenInput = document.getElementById('{{ form.date_reservation.vars.id }}');
    const hint = document.getElementById('activity-date-hint');
    const capacityStatus = document.getElementById('activity-capacity-status');
    const capacityPill = capacityStatus ? capacityStatus.querySelector('.capacity-status-pill') : null;
    const capacityText = capacityStatus ? capacityStatus.querySelector('.capacity-status-text') : null;
    const capacityFill = capacityStatus ? capacityStatus.querySelector('.capacity-progress-fill') : null;
    const capacityUsed = capacityStatus ? capacityStatus.querySelector('[data-capacity-used]') : null;
    const capacityRemaining = capacityStatus ? capacityStatus.querySelector('[data-capacity-remaining]') : null;
    const capacityTotal = capacityStatus ? capacityStatus.querySelector('[data-capacity-total]') : null;
    const activityDataBaseUrl = {{ path('app_reservation_activity_data', {'id_activite': 0})|json_encode|raw }};
    const urlTemplate = activityDataBaseUrl.replace(/0$/, '__ID__');

    if (!activitySelect || !dateSelect || !dateHiddenInput || !hint || !capacityStatus || !capacityText || !capacityFill || !capacityPill || !capacityUsed || !capacityRemaining || !capacityTotal) {
        return;
    }

    // Keep one visible option per activity name (recurrence occurrences share the same name).
    const dedupeActivityOptions = () => {
        const seen = new Set();
        const currentValue = activitySelect.value;

        Array.from(activitySelect.options).forEach((option) => {
            if (!option.value) {
                return;
            }

            const key = option.textContent ? option.textContent.trim().toLowerCase() : '';
            if (!key) {
                return;
            }

            if (seen.has(key) && option.value !== currentValue) {
                option.remove();
                return;
            }

            seen.add(key);
        });
    };

    const resetDateChoices = () => {
        dateSelect.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = translate('-- Choisissez une date --');
        dateSelect.appendChild(placeholder);
        dateSelect.value = '';
        dateHiddenInput.value = '';
        hint.textContent = translate('Choisissez d abord une activité pour voir la date autorisée.');
    };

    const resetCapacityState = () => {
        activitySelect.classList.remove('capacity-select-available', 'capacity-select-warning', 'capacity-select-full');
        capacityStatus.className = 'capacity-status capacity-status-default';
        capacityPill.textContent = '--';
        capacityText.textContent = 'Sélectionnez une activité.';
        capacityUsed.textContent = '0';
        capacityRemaining.textContent = '0';
        capacityTotal.textContent = '0';
        capacityFill.style.width = '0%';
    };

    const applyCapacityState = () => {
        const selectedOption = activitySelect.options[activitySelect.selectedIndex];

        if (!selectedOption || !selectedOption.value) {
            resetCapacityState();
            return;
        }

        const state = selectedOption.dataset.capacityState || 'available';
        const used = selectedOption.dataset.capacityUsed || '0';
        const total = selectedOption.dataset.capacityTotal || '0';
        const remaining = selectedOption.dataset.capacityRemaining || '0';
        const totalValue = Math.max(0, Number(total));
        const usedValue = Math.max(0, Number(used));
        const percent = totalValue > 0 ? Math.min(100, Math.round((usedValue / totalValue) * 100)) : 0;

        activitySelect.classList.remove('capacity-select-available', 'capacity-select-warning', 'capacity-select-full');
        activitySelect.classList.add('capacity-select-' + state);

        capacityStatus.className = 'capacity-status capacity-status-' + state;
        capacityStatus.classList.remove('is-updating');
        void capacityStatus.offsetWidth;
        capacityStatus.classList.add('is-updating');

        capacityPill.textContent = state === 'full' ? 'Complet' : state === 'warning' ? 'Alerte' : 'Disponible';
        capacityUsed.textContent = used;
        capacityRemaining.textContent = remaining;
        capacityTotal.textContent = total;
        capacityFill.style.width = percent + '%';

        capacityText.textContent = used + '/' + total + ' utilisées • ' + remaining + ' restantes';
    };

    const applyCapacityFromResponse = (capacity) => {
        if (!capacity || typeof capacity !== 'object') {
            applyCapacityState();
            return;
        }

        const state = capacity.state || 'available';
        const used = String(capacity.used ?? '0');
        const total = String(capacity.total ?? '0');
        const remaining = String(capacity.remaining ?? '0');
        const totalValue = Math.max(0, Number(total));
        const usedValue = Math.max(0, Number(used));
        const percent = totalValue > 0 ? Math.min(100, Math.round((usedValue / totalValue) * 100)) : 0;

        activitySelect.classList.remove('capacity-select-available', 'capacity-select-warning', 'capacity-select-full');
        activitySelect.classList.add('capacity-select-' + state);

        capacityStatus.className = 'capacity-status capacity-status-' + state;
        capacityStatus.classList.remove('is-updating');
        void capacityStatus.offsetWidth;
        capacityStatus.classList.add('is-updating');

        capacityPill.textContent = state === 'full' ? 'Complet' : state === 'warning' ? 'Alerte' : 'Disponible';
        capacityUsed.textContent = used;
        capacityRemaining.textContent = remaining;
        capacityTotal.textContent = total;
        capacityFill.style.width = percent + '%';
        capacityText.textContent = used + '/' + total + ' utilisées • ' + remaining + ' restantes';
    };

    const formatDateFr = (isoDate) => {
        if (!isoDate || !isoDate.includes('-')) {
            return isoDate;
        }

        const [year, month, day] = isoDate.split('-');
        return day + '/' + month + '/' + year;
    };

    const applyAllowedDates = (allowedDates) => {
        const previousValue = dateSelect.value;

        dateSelect.innerHTML = '';

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '-- Choisissez une date --';
        dateSelect.appendChild(placeholder);

        for (const allowedDate of allowedDates) {
            const option = document.createElement('option');
            option.value = allowedDate;
            option.textContent = formatDateFr(allowedDate);
            dateSelect.appendChild(option);
        }

        if (previousValue && allowedDates.includes(previousValue)) {
            dateSelect.value = previousValue;
        } else {
            dateSelect.value = '';
        }

        dateHiddenInput.value = dateSelect.value;

        hint.textContent = translate('Dates autorisées: ') + allowedDates.map(formatDateFr).join(' / ');
    };

    dateSelect.addEventListener('change', () => {
        dateHiddenInput.value = dateSelect.value || '';
    });

    const updateAllowedDate = async () => {
        if (!urlTemplate || !activitySelect.value) {
            resetDateChoices();
            resetCapacityState();
            return;
        }

        hint.textContent = 'Chargement des informations de l activité...';

        try {
            const response = await fetch(urlTemplate.replace('__ID__', encodeURIComponent(activitySelect.value)), {
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) {
                resetDateChoices();
                applyCapacityState();
                return;
            }

            const data = await response.json();
            if (!Array.isArray(data.dates) || data.dates.length === 0) {
                resetDateChoices();
                applyCapacityFromResponse(data.capacity ?? null);
                return;
            }

            applyAllowedDates(data.dates);
            applyCapacityFromResponse(data.capacity ?? null);
        } catch (e) {
            resetDateChoices();
            resetCapacityState();
            return;
        }
    };

    activitySelect.addEventListener('change', updateAllowedDate);
    dedupeActivityOptions();
    updateAllowedDate();
})();
</script>
