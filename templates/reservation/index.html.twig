{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const animatedCounter = document.getElementById('reservation-animated-counter');

            const initReservationFlashToasts = function () {
                const flashRoot = document.getElementById('reservation-flash-messages');
                const toast = document.getElementById('reservation-toast');

                if (!flashRoot || !toast) {
                    return;
                }

                const queue = Array.from(flashRoot.querySelectorAll('[data-message]')).map(function (node) {
                    return {
                        type: node.dataset.type || 'success',
                        message: node.dataset.message || ''
                    };
                }).filter(function (item) {
                    return item.message.trim() !== '';
                });

                if (!queue.length) {
                    return;
                }

                let index = 0;

                const showNext = function () {
                    if (index >= queue.length) {
                        return;
                    }

                    const current = queue[index];
                    toast.classList.remove('error', 'show');
                    toast.classList.toggle('error', current.type === 'error');
                    toast.textContent = current.message;

                    window.requestAnimationFrame(function () {
                        toast.classList.add('show');
                    });

                    window.setTimeout(function () {
                        toast.classList.remove('show');
                        index += 1;
                        window.setTimeout(showNext, 220);
                    }, 2600);
                };

                showNext();
            };

            const animateCounter = function () {
                if (!animatedCounter || animatedCounter.dataset.animated === '1') {
                    return;
                }

                animatedCounter.dataset.animated = '1';
                const target = Number.parseInt(animatedCounter.dataset.target || '24', 10);
                const totalFrames = 42;
                let currentFrame = 0;

                const update = function () {
                    currentFrame += 1;
                    const progress = Math.min(currentFrame / totalFrames, 1);
                    const value = Math.round(progress * target);
                    animatedCounter.textContent = String(value);

                    if (progress < 1) {
                        window.requestAnimationFrame(update);
                    }
                };

                window.requestAnimationFrame(update);
            };

            const initReservationCsvExport = function () {
                const exportCsvButton = document.getElementById('reservation-export-csv');

                if (!exportCsvButton || exportCsvButton.dataset.bound === '1') {
                    return;
                }

                exportCsvButton.dataset.bound = '1';
                exportCsvButton.addEventListener('click', function () {
                    const rows = Array.from(document.querySelectorAll('.reservation-admin-row'));

                    if (!rows.length) {
                        return;
                    }

                    const headers = ['ID', 'Nom', 'Activite', 'Date reservation', 'Email', 'Nombre personnes', 'Statut'];
                    const lines = [headers.join(';')];

                    rows.forEach(function (row) {
                        const statusMap = {
                            confirmed: 'Confirmee',
                            pending: 'En attente',
                            cancelled: 'Annulee'
                        };

                        const values = [
                            row.dataset.searchId || '',
                            row.dataset.searchNom || '',
                            row.dataset.searchActivite || '',
                            row.dataset.searchDate || '',
                            row.dataset.searchEmail || '',
                            row.dataset.searchNombre || '',
                            statusMap[row.dataset.searchStatus] || ''
                        ].map(function (value) {
                            return '"' + String(value).replace(/"/g, '""') + '"';
                        });

                        lines.push(values.join(';'));
                    });

                    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = 'reservations_filtrees.csv';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(link.href);
                });
            };

            const initAiReport = function () {
                const reportButton = document.getElementById('reservation-ai-report-btn');
                const reportPdfButton = document.getElementById('reservation-ai-report-pdf-btn');
                const reportPanel = document.getElementById('reservation-ai-report-panel');
                const reportStatus = document.getElementById('reservation-ai-report-status');
                const reportLoading = document.getElementById('reservation-ai-report-loading');
                const reportError = document.getElementById('reservation-ai-report-error');
                const reportResult = document.getElementById('reservation-ai-report-result');
                const searchForm = document.getElementById('reservation-search-form');

                if (!reportButton || !reportPdfButton || !reportPanel || !reportStatus || !reportLoading || !reportError || !reportResult) {
                    return;
                }

                if (reportButton.dataset.bound === '1') {
                    return;
                }

                reportButton.dataset.bound = '1';

                reportPdfButton.addEventListener('click', function () {
                    const baseUrl = reportPdfButton.dataset.pdfUrl;
                    if (!baseUrl) {
                        return;
                    }

                    const params = searchForm ? new URLSearchParams(new FormData(searchForm)) : new URLSearchParams(window.location.search);
                    const pdfUrl = baseUrl + (params.toString() ? ('?' + params.toString()) : '');
                    window.open(pdfUrl, '_blank');
                });

                reportButton.addEventListener('click', function () {
                    const baseUrl = reportButton.dataset.reportUrl;
                    if (!baseUrl) {
                        return;
                    }

                    const params = searchForm ? new URLSearchParams(new FormData(searchForm)) : new URLSearchParams(window.location.search);
                    const reportUrl = baseUrl + (params.toString() ? ('?' + params.toString()) : '');

                    reportPanel.style.display = 'block';
                    reportLoading.style.display = 'block';
                    reportError.style.display = 'none';
                    reportResult.style.display = 'none';
                    reportResult.textContent = '';
                    reportStatus.textContent = 'Chargement';
                    reportStatus.style.background = 'rgba(37, 99, 235, 0.12)';
                    reportStatus.style.color = '#1d4ed8';
                    reportButton.disabled = true;

                    fetch(reportUrl, {
                        headers: {
                            'Accept': 'application/json'
                        }
                    })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                if (!response.ok) {
                                    throw new Error(data.error || 'Impossible de générer le rapport.');
                                }

                                return data;
                            });
                        })
                        .then(function (data) {
                            reportLoading.style.display = 'none';
                            reportButton.disabled = false;

                            if (!data.success || !data.report) {
                                throw new Error(data.error || 'Impossible de générer le rapport.');
                            }

                            reportResult.textContent = data.report;
                            reportResult.style.display = 'block';
                            reportStatus.textContent = 'Généré';
                            reportStatus.style.background = 'rgba(22, 163, 74, 0.12)';
                            reportStatus.style.color = '#15803d';
                            reportPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        })
                        .catch(function (error) {
                            reportLoading.style.display = 'none';
                            reportButton.disabled = false;
                            reportError.textContent = error.message || 'Erreur lors de la génération du rapport.';
                            reportError.style.display = 'block';
                            reportStatus.textContent = 'Erreur';
                            reportStatus.style.background = 'rgba(220, 38, 38, 0.12)';
                            reportStatus.style.color = '#b91c1c';
                        });
                });
            };

            const initReservationLiveSearch = function () {
                const root = document.getElementById('reservation-live-root');

                if (!root) {
                    return;
                }

                const form = root.querySelector('#reservation-search-form');

                if (!form) {
                    return;
                }

                const voiceBtn = form.querySelector('#reservation-voice-btn');
                const voiceInput = form.querySelector('input[name="q"]');
                const voiceToast = document.getElementById('reservation-voice-toast');
                const SpeechRecognition =
                    window.SpeechRecognition || window.webkitSpeechRecognition;

                if (voiceBtn && voiceInput && voiceToast) {
                    if (!SpeechRecognition) {
                        voiceBtn.style.display = 'none';
                    } else {
                        const recognition = new SpeechRecognition();
                        recognition.lang = 'fr-FR';
                        recognition.continuous = false;
                        recognition.interimResults = true;
                        recognition.maxAlternatives = 1;

                        let isListening = false;
                        let toastTimer = null;

                        const micSVG = `<svg id="reservation-voice-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>`;

                        const stopSVG = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <rect x="4" y="4" width="16" height="16" rx="3"/>
                            </svg>`;

                        const showToast = function (message, type) {
                            window.clearTimeout(toastTimer);
                            voiceToast.textContent = message;
                            voiceToast.className = 'voice-toast voice-toast--' + type + ' voice-toast--visible';
                            toastTimer = window.setTimeout(function () {
                                voiceToast.classList.remove('voice-toast--visible');
                            }, 2800);
                        };

                        const startListening = function () {
                            isListening = true;
                            voiceBtn.classList.add('voice-btn--active');
                            voiceBtn.innerHTML = stopSVG;
                            voiceBtn.setAttribute('aria-label', 'Arrêter la recherche vocale');
                            showToast('🎙 Parlez maintenant…', 'info');
                            recognition.start();
                        };

                        const stopListening = function () {
                            isListening = false;
                            voiceBtn.classList.remove('voice-btn--active');
                            voiceBtn.innerHTML = micSVG;
                            voiceBtn.setAttribute('aria-label', 'Démarrer la recherche vocale');
                            recognition.stop();
                        };

                        voiceBtn.addEventListener('click', function () {
                            if (isListening) {
                                stopListening();
                            } else {
                                startListening();
                            }
                        });

                        recognition.addEventListener('result', function (event) {
                            const transcript = Array.from(event.results)
                                .map(function (result) {
                                    return result[0].transcript;
                                })
                                .join('');

                            voiceInput.value = transcript;

                            if (event.results[0].isFinal) {
                                showToast('Recherche : « ' + transcript + ' »', 'success');
                                form.requestSubmit();
                            }
                        });

                        recognition.addEventListener('end', function () {
                            if (isListening) {
                                stopListening();
                            }
                        });

                        recognition.addEventListener('error', function (event) {
                            stopListening();

                            const messages = {
                                'not-allowed': 'Microphone non autorisé. Vérifiez les permissions.',
                                'no-speech': 'Aucune voix détectée. Réessayez.',
                                'audio-capture': 'Impossible d\'accéder au microphone.',
                                'network': 'Erreur réseau lors de la reconnaissance vocale.'
                            };

                            showToast(messages[event.error] || 'Erreur vocale : ' + event.error, 'error');
                        });
                    }
                }

                // Use full page requests for reliability: avoids stale swapped DOM states.
                return;

                const queryInput = form.querySelector('input[name="q"]');
                const trackedFields = [
                    queryInput,
                    form.querySelector('select[name="field"]'),
                    form.querySelector('select[name="status"]'),
                    form.querySelector('input[name="date_from"]'),
                    form.querySelector('input[name="date_to"]'),
                    form.querySelector('select[name="sort"]')
                ].filter(Boolean);

                let submitTimer = null;

                const resetToFirstPage = function () {
                    let pageInput = form.querySelector('input[name="page"]');

                    if (!pageInput) {
                        pageInput = document.createElement('input');
                        pageInput.type = 'hidden';
                        pageInput.name = 'page';
                        form.appendChild(pageInput);
                    }

                    pageInput.value = '1';
                };

                const requestAndSwap = function (url) {
                    fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(function (response) {
                            return response.text();
                        })
                        .then(function (html) {
                            const parser = new DOMParser();
                            const nextDoc = parser.parseFromString(html, 'text/html');
                            const nextRoot = nextDoc.getElementById('reservation-live-root');

                            if (!nextRoot) {
                                window.location.href = url;
                                return;
                            }

                            root.innerHTML = nextRoot.innerHTML;
                            window.history.replaceState({}, '', url);
                            initReservationLiveSearch();
                            initReservationCsvExport();
                        })
                        .catch(function () {
                            window.location.href = url;
                        });
                };

                const submitWithAjax = function () {
                    const params = new URLSearchParams(new FormData(form));
                    const url = form.action + (params.toString() ? ('?' + params.toString()) : '');
                    requestAndSwap(url);
                };

                const scheduleSubmit = function (delay) {
                    if (submitTimer) {
                        window.clearTimeout(submitTimer);
                    }

                    submitTimer = window.setTimeout(function () {
                        submitWithAjax();
                    }, delay);
                };

                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    submitWithAjax();
                });

                root.querySelectorAll('.quick-filter-btn, .page-link').forEach(function (link) {
                    link.addEventListener('click', function (event) {
                        event.preventDefault();
                        requestAndSwap(link.href);
                    });
                });

                trackedFields.forEach(function (field) {
                    if (field === queryInput) {
                        field.addEventListener('input', function () {
                            resetToFirstPage();
                            scheduleSubmit(320);
                        });

                        field.addEventListener('keydown', function (event) {
                            if (event.key === 'Enter') {
                                event.preventDefault();
                                resetToFirstPage();
                                scheduleSubmit(0);
                            }
                        });

                        return;
                    }

                    field.addEventListener('change', function () {
                        resetToFirstPage();
                        scheduleSubmit(0);
                    });
                });
            };

            initReservationLiveSearch();
            initReservationCsvExport();
            initAiReport();
            initReservationFlashToasts();
            animateCounter();
        })();
    </script>
{% endblock %}
