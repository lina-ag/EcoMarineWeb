                white-space: nowrap;
                box-shadow: 0 5px 16px rgba(15, 23, 42, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.72);
            }

            .quick-filter-btn:hover {
                background: linear-gradient(135deg, rgba(240, 249, 255, 0.92), rgba(219, 234, 254, 0.88));
                transform: translateY(-2px);
                box-shadow: 0 9px 18px rgba(59, 130, 246, 0.17), inset 0 1px 1px rgba(255, 255, 255, 0.8);
                border-color: rgba(96, 165, 250, 0.5);
            }

            .quick-filter-btn.active {
                background: linear-gradient(135deg, rgba(37, 99, 235, 0.95), rgba(14, 165, 233, 0.9));
                color: #ffffff;
                border-color: rgba(37, 99, 235, 0.7);
                box-shadow: 0 8px 18px rgba(59, 130, 246, 0.33), inset 0 1px 2px rgba(255, 255, 255, 0.26);
                font-weight: 700;
            }

            .quick-filter-btn.active:hover {
                background: linear-gradient(135deg, rgba(59, 130, 246, 1), rgba(37, 99, 235, 1));
                transform: translateY(-2px);
