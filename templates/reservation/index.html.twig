                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.54rem 1rem;
                border-radius: 999px;
                border: 1px solid rgba(148, 163, 184, 0.32);
                background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(226, 232, 240, 0.6));
                backdrop-filter: blur(8px);
                color: #1f2937;
                font-size: 0.81rem;
                font-weight: 700;
                letter-spacing: 0.01em;
                text-decoration: none;
