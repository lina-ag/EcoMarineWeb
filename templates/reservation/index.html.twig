            }

            .ux-empty-message {
                margin: 0.45rem 0 1rem;
                padding: 0.75rem 0.95rem;
                border-radius: 10px;
                border: 1px solid rgba(239, 68, 68, 0.22);
                background: rgba(254, 242, 242, 0.92);
                color: #991b1b;
                font-size: 0.9rem;
                font-weight: 600;
            }

            .list-pagination {
                margin-top: 1rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
