        </style>

        <div id="reservation-live-root">
        <form id="reservation-search-form" method="get" action="{{ path('app_reservation_index') }}" class="admin-live-form">
            <div class="reservation-search-row">
                <select id="reservation-search-field" name="field" class="search-input admin-field-select">
                    <option value="all" {{ search_field|default('all') == 'all' ? 'selected' : '' }}>{{ 'reservation.search_all'|trans }}</option>
                    <option value="id" {{ search_field|default('all') == 'id' ? 'selected' : '' }}>{{ 'reservation.search_id'|trans }}</option>
                    <option value="nom" {{ search_field|default('all') == 'nom' ? 'selected' : '' }}>{{ 'reservation.name'|trans }}</option>
                    <option value="activite" {{ search_field|default('all') == 'activite' ? 'selected' : '' }}>{{ 'reservation.search_activity'|trans }}</option>
                    <option value="date" {{ search_field|default('all') == 'date' ? 'selected' : '' }}>{{ 'reservation.search_date'|trans }}</option>
                    <option value="email" {{ search_field|default('all') == 'email' ? 'selected' : '' }}>{{ 'reservation.search_email'|trans }}</option>
                    <option value="nombre" {{ search_field|default('all') == 'nombre' ? 'selected' : '' }}>{{ 'reservation.search_number'|trans }}</option>
                </select>
                <div class="admin-live-search-main">
                    <div class="search-box" style="max-width: 100%; flex: 1; margin: 0;">
                        <input
                            id="reservation-search-input"
                            type="text"
                            name="q"
                            class="search-input"
                            value="{{ search_term|default('') }}"
                            placeholder="{{ 'reservation.search_placeholder'|trans }}"
                            autocomplete="off"
                            list="reservation-search-suggestions"
                            data-autocomplete-source="{{ autocomplete_suggestions|default([])|json_encode|e('html_attr') }}"
                        >
                        <button type="button" id="reservation-voice-btn" class="voice-btn" title="Recherche vocale" aria-label="Démarrer la recherche vocale">
                            <svg id="reservation-voice-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>
                        </button>
                        <datalist id="reservation-search-suggestions">
                            {% for suggestion in autocomplete_suggestions|default([]) %}
                                <option value="{{ suggestion }}">
                            {% endfor %}
                        </datalist>
                    </div>
                </div>
                <small id="reservation-result-count" class="admin-result-count">{{ result_count|default(reservations|length) }} {{ 'reservation.results'|trans }}</small>
            </div>
            <div class="autocomplete-hint">Suggestions rapides disponibles pendant la saisie.</div>
            <script>
                (() => {
                    const input = document.getElementById('reservation-search-input');
                    const datalist = document.getElementById('reservation-search-suggestions');

                    if (!input || !datalist) {
                        return;
                    }

                    const source = JSON.parse(input.dataset.autocompleteSource || '[]');
                    const normalize = (value) => value
                        .toLowerCase()
                        .normalize('NFD')
                        .replace(/[\u0300-\u036f]/g, '')
                        .trim();

                    const renderSuggestions = (rawValue) => {
                        const query = normalize(rawValue);
                        const suggestions = query === ''
                            ? source.slice(0, 8)
                            : source.filter((item) => normalize(item).startsWith(query)).slice(0, 8);

                        datalist.innerHTML = suggestions
                            .map((item) => '<option value="' + String(item).replace(/"/g, '&quot;') + '">')
                            .join('');
                    };

                    input.addEventListener('input', () => renderSuggestions(input.value));
                    input.addEventListener('focus', () => renderSuggestions(input.value));
                    renderSuggestions(input.value);
                })();
            </script>

            <div class="admin-live-form-row admin-live-form-row--split">
                <label class="admin-filter-label">{{ 'reservation.quick_filters'|trans }}</label>
                <a href="{{ path('app_reservation_index', app.request.query.all|merge({'personnes': 'all', 'page': 1})) }}" class="quick-filter-btn {{ personnes_filter|default('all') == 'all' ? 'active' : '' }}" title="{{ 'reservation.all_groups'|trans }}">{{ 'reservation.all_groups'|trans }}</a>
                <a href="{{ path('app_reservation_index', app.request.query.all|merge({'personnes': '1-5', 'page': 1})) }}" class="quick-filter-btn {{ personnes_filter|default('all') == '1-5' ? 'active' : '' }}" title="{{ 'reservation.filter_1_5'|trans }}">{{ 'reservation.filter_1_5'|trans }}</a>
                <a href="{{ path('app_reservation_index', app.request.query.all|merge({'personnes': '6-10', 'page': 1})) }}" class="quick-filter-btn {{ personnes_filter|default('all') == '6-10' ? 'active' : '' }}" title="{{ 'reservation.filter_6_10'|trans }}">{{ 'reservation.filter_6_10'|trans }}</a>
                <a href="{{ path('app_reservation_index', app.request.query.all|merge({'personnes': '11-50', 'page': 1})) }}" class="quick-filter-btn {{ personnes_filter|default('all') == '11-50' ? 'active' : '' }}" title="{{ 'reservation.filter_11_50'|trans }}">{{ 'reservation.filter_11_50'|trans }}</a>
                <a href="{{ path('app_reservation_index', app.request.query.all|merge({'personnes': '50+', 'page': 1})) }}" class="quick-filter-btn {{ personnes_filter|default('all') == '50+' ? 'active' : '' }}" title="{{ 'reservation.filter_50_plus'|trans }}">{{ 'reservation.filter_50_plus'|trans }}</a>
                <select id="reservation-filter-status" name="status" class="search-input combo-input admin-inline-select" title="{{ 'reservation.status'|trans }}">
                    <option value="all" {{ status_filter|default('all') == 'all' ? 'selected' : '' }}>{{ 'reservation.all_status'|trans }}</option>
                    <option value="confirmed" {{ status_filter|default('all') == 'confirmed' ? 'selected' : '' }}>{{ 'reservation.status_confirmed'|trans }}</option>
                    <option value="pending" {{ status_filter|default('all') == 'pending' ? 'selected' : '' }}>{{ 'reservation.status_pending'|trans }}</option>
                    <option value="cancelled" {{ status_filter|default('all') == 'cancelled' ? 'selected' : '' }}>{{ 'reservation.status_cancelled'|trans }}</option>
                </select>
                <input id="reservation-date-from" name="date_from" type="date" value="{{ date_from|default('') }}" class="search-input combo-input admin-inline-select" title="{{ 'reservation.date_start'|trans }}" />
                <input id="reservation-date-to" name="date_to" type="date" value="{{ date_to|default('') }}" class="search-input combo-input admin-inline-select" title="{{ 'reservation.date_end'|trans }}" />
                <button id="reservation-export-csv" type="button" class="btn btn-secondary search-icon-btn" title="{{ 'reservation.export_filtered'|trans }}">
                    <span>{{ 'reservation.export_csv'|trans }}</span>
                </button>
                <select id="reservation-sort-by" name="sort" class="search-input combo-input admin-sort-select" onchange="this.form.submit();">
                    <option value="id_desc" {{ sort_by|default('id_desc') == 'id_desc' ? 'selected' : '' }}>{{ 'reservation.sort_latest'|trans }}</option>
                    <option value="id_asc" {{ sort_by|default('id_desc') == 'id_asc' ? 'selected' : '' }}>{{ 'reservation.sort_oldest'|trans }}</option>
                    <option value="date_desc" {{ sort_by|default('id_desc') == 'date_desc' ? 'selected' : '' }}>{{ 'reservation.sort_date_recent'|trans }}</option>
                    <option value="date_asc" {{ sort_by|default('id_desc') == 'date_asc' ? 'selected' : '' }}>{{ 'reservation.sort_date_old'|trans }}</option>
                    <option value="nom_asc" {{ sort_by|default('id_desc') == 'nom_asc' ? 'selected' : '' }}>{{ 'reservation.sort_name_az'|trans }}</option>
                    <option value="nom_desc" {{ sort_by|default('id_desc') == 'nom_desc' ? 'selected' : '' }}>{{ 'reservation.sort_name_za'|trans }}</option>
                    <option value="nombre_desc" {{ sort_by|default('id_desc') == 'nombre_desc' ? 'selected' : '' }}>{{ 'reservation.sort_people_max'|trans }}</option>
                    <option value="nombre_asc" {{ sort_by|default('id_desc') == 'nombre_asc' ? 'selected' : '' }}>{{ 'reservation.sort_people_min'|trans }}</option>
                </select>
            </div>
        </form>

        <div id="reservation-voice-toast" class="voice-toast" role="status" aria-live="polite"></div>

        <div id="reservation-empty-message" class="ux-empty-message" style="display: none;">{{ 'reservation.empty_message'|trans }}</div>

        <div class="table-wrapper reservation-admin-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>{{ 'reservation.id'|trans }}</th>
                        <th>{{ 'reservation.name'|trans }}</th>
                        <th>{{ 'reservation.activity'|trans }}</th>
                        <th>{{ 'reservation.date'|trans }}</th>
                        <th>{{ 'reservation.email'|trans }}</th>
                        <th>{{ 'reservation.people'|trans }}</th>
                        <th>{{ 'reservation.status'|trans }}</th>
                        <th>🏆 Badge</th>
                        <th>{{ 'reservation.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for reservation in reservations %}
                    {% set reservationStatus = reservation.activiteEcologique ? (reservation.dateReservation and reservation.dateReservation|date('Y-m-d') > "now"|date('Y-m-d') ? 'pending' : 'confirmed') : 'cancelled' %}
                    <tr
                        class="reservation-admin-row"
                        style="--reservation-row-index: {{ loop.index0 }};"
                        data-search-id="{{ reservation.idReservation|e('html_attr') }}"
                        data-search-nom="{{ reservation.nom|default('')|e('html_attr') }}"
                        data-search-activite="{{ (reservation.activiteEcologique ? reservation.activiteEcologique.nomActivite : '')|e('html_attr') }}"
                        data-search-date="{{ (reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '')|e('html_attr') }}"
                        data-search-email="{{ reservation.email|default('')|e('html_attr') }}"
                        data-search-nombre="{{ reservation.nombrePersonnes|e('html_attr') }}"
                        data-search-status="{{ reservationStatus }}"
                        data-search-personnes="{{ reservation.nombrePersonnes|e('html_attr') }}"
                        data-search-values="{{ [
                            reservation.idReservation,
                            reservation.nom,
                            reservation.activiteEcologique ? reservation.activiteEcologique.nomActivite : '',
                            reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '',
                            reservation.email,
                            reservation.nombrePersonnes
                        ]|join('|')|lower|e('html_attr') }}"
                    >
                        <td>{{ reservation.idReservation }}</td>
                        <td>{{ reservation.nom }}</td>
                        <td>
                            {% if reservation.activiteEcologique %}
                                {{ reservation.activiteEcologique.nomActivite }}
                            {% else %}
                                <span style="display: inline-block; padding: 4px 10px; border-radius: 999px; background: #fee2e2; color: #b91c1c; font-weight: 600;">{{ 'reservation.activity_cancelled'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '' }}</td>
                        <td>{{ reservation.email }}</td>
                        <td>{{ reservation.nombrePersonnes }}</td>
                        <td>
                            {% if reservationStatus == 'confirmed' %}
                                <span class="status-badge status-badge-confirmed">{{ 'reservation.status_confirmed'|trans }}</span>
                            {% elseif reservationStatus == 'pending' %}
                                <span class="status-badge status-badge-pending">{{ 'reservation.status_pending'|trans }}</span>
                            {% else %}
                                <span class="status-badge status-badge-cancelled">{{ 'reservation.status_cancelled'|trans }}</span>
                            {% endif %}
                        </td>
                        <td style="text-align: center;">
                            {% if reservation.quizBadge %}
                                {% set badgeEmoji = reservation.quizBadge == 'gold' ? '🥇' : (reservation.quizBadge == 'silver' ? '🥈' : '🥉') %}
                                {% set badgeLabel = reservation.quizBadge == 'gold' ? 'Or' : (reservation.quizBadge == 'silver' ? 'Argent' : 'Bronze') %}
                                <span class="quiz-badge quiz-badge--{{ reservation.quizBadge }}">
                                    <span style="font-size: 1.1rem;">{{ badgeEmoji }}</span>
                                    <span>{{ badgeLabel }}</span>
                                </span>
                            {% else %}
                                <span style="color: #cbd5e1; font-size: 0.85rem;">—</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="reservation-admin-actions">
                                <a href="{{ path('app_reservation_show', {'id_reservation': reservation.id_reservation}) }}" class="btn btn-secondary reservation-admin-action-btn" title="{{ 'reservation.show_reservation'|trans }}">{{ 'reservation.view'|trans }}</a>
                                <a href="{{ path('app_reservation_edit', {'id_reservation': reservation.id_reservation}) }}" class="btn btn-primary reservation-admin-action-btn" title="{{ 'reservation.edit_reservation'|trans }}">{{ 'reservation.edit'|trans }}</a>
                                <a href="{{ path('app_reservation_pdf', {'id_reservation': reservation.id_reservation}) }}" class="btn btn-primary reservation-admin-action-btn" title="{{ 'reservation.export_pdf_single'|trans }}">{{ 'reservation.pdf'|trans }}</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8">{{ 'reservation.no_records'|trans }}</td>
                    </tr>
                {% endfor %}
                    <tr id="reservation-no-match-row" style="display: none;">
                        <td colspan="8">{{ 'reservation.no_search_results'|trans }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="list-pagination">
            <div class="list-pagination-meta">
                {% if result_count|default(0) > 0 %}
                    {{ 'reservation.showing'|trans }} {{ page_start|default(0) }}-{{ page_end|default(0) }} {{ 'reservation.of'|trans }} {{ result_count|default(0) }} {{ 'reservation.results'|trans }}
                {% else %}
                    {{ 'reservation.no_results'|trans }}
                {% endif %}
            </div>
            {% if total_pages|default(1) > 1 %}
                <div class="list-pagination-links">
                    {% if page|default(1) > 1 %}
                        <a class="page-link" href="{{ path('app_reservation_index', app.request.query.all|merge({'page': page - 1})) }}" aria-label="{{ 'reservation.previous_page'|trans }}">{{ 'reservation.prev'|trans }}</a>
                    {% endif %}

                    {% for pageNumber in 1..total_pages %}
                        <a class="page-link {{ pageNumber == page ? 'active' : '' }}" href="{{ path('app_reservation_index', app.request.query.all|merge({'page': pageNumber})) }}">{{ pageNumber }}</a>
                    {% endfor %}

                    {% if page|default(1) < total_pages %}
                        <a class="page-link" href="{{ path('app_reservation_index', app.request.query.all|merge({'page': page + 1})) }}" aria-label="{{ 'reservation.next_page'|trans }}">{{ 'reservation.next'|trans }}</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        </div>

        <div id="reservation-toast" class="reservation-toast" role="status" aria-live="polite"></div>
        <div id="reservation-flash-messages" style="display: none;">
            {% for message in success_flashes %}
                <span data-type="success" data-message="{{ message|e('html_attr') }}"></span>
            {% endfor %}
            {% for message in error_flashes %}
                <span data-type="error" data-message="{{ message|e('html_attr') }}"></span>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const initReservationFlashToasts = function () {
                const flashRoot = document.getElementById('reservation-flash-messages');
                const toast = document.getElementById('reservation-toast');

                if (!flashRoot || !toast) {
                    return;
                }

                const queue = Array.from(flashRoot.querySelectorAll('[data-message]')).map(function (node) {
                    return {
                        type: node.dataset.type || 'success',
                        message: node.dataset.message || ''
                    };
                }).filter(function (item) {
                    return item.message.trim() !== '';
                });

                if (!queue.length) {
                    return;
                }

                let index = 0;

                const showNext = function () {
                    if (index >= queue.length) {
                        return;
                    }

                    const current = queue[index];
                    toast.classList.remove('error', 'show');
                    toast.classList.toggle('error', current.type === 'error');
                    toast.textContent = current.message;

                    window.requestAnimationFrame(function () {
                        toast.classList.add('show');
                    });

                    window.setTimeout(function () {
                        toast.classList.remove('show');
                        index += 1;
                        window.setTimeout(showNext, 220);
                    }, 2600);
                };

                showNext();
            };

            const animateCounter = function () {
                const animatedCounter = document.getElementById('reservation-animated-counter');

                if (!animatedCounter || animatedCounter.dataset.animated === '1') {
                    return;
                }

                animatedCounter.dataset.animated = '1';
                const target = Number.parseInt(animatedCounter.dataset.target || '24', 10);
                const totalFrames = 42;
                let currentFrame = 0;

                const update = function () {
                    currentFrame += 1;
                    const progress = Math.min(currentFrame / totalFrames, 1);
                    const value = Math.round(progress * target);
                    animatedCounter.textContent = String(value);

                    if (progress < 1) {
                        window.requestAnimationFrame(update);
                    }
                };

                window.requestAnimationFrame(update);
            };

            const initReservationCsvExport = function () {
                const exportCsvButton = document.getElementById('reservation-export-csv');

                if (!exportCsvButton || exportCsvButton.dataset.bound === '1') {
                    return;
                }

                exportCsvButton.dataset.bound = '1';
                exportCsvButton.addEventListener('click', function () {
                    const rows = Array.from(document.querySelectorAll('.reservation-admin-row'));

                    if (!rows.length) {
                        return;
                    }

                    const headers = ['ID', 'Nom', 'Activite', 'Date reservation', 'Email', 'Nombre personnes', 'Statut'];
                    const lines = [headers.join(';')];

                    rows.forEach(function (row) {
                        const statusMap = {
                            confirmed: 'Confirmee',
                            pending: 'En attente',
                            cancelled: 'Annulee'
                        };

                        const values = [
                            row.dataset.searchId || '',
                            row.dataset.searchNom || '',
                            row.dataset.searchActivite || '',
                            row.dataset.searchDate || '',
                            row.dataset.searchEmail || '',
                            row.dataset.searchNombre || '',
                            statusMap[row.dataset.searchStatus] || ''
                        ].map(function (value) {
                            return '"' + String(value).replace(/"/g, '""') + '"';
                        });

                        lines.push(values.join(';'));
                    });

                    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = 'reservations_filtrees.csv';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(link.href);
                });
            };

            const initAiReport = function () {
                const reportButton = document.getElementById('reservation-ai-report-btn');
                const searchForm = document.getElementById('reservation-search-form');

                if (!reportButton) {
                    return;
                }

                if (reportButton.dataset.bound === '1') {
                    return;
                }

                reportButton.dataset.bound = '1';

                reportButton.addEventListener('click', function () {
                    const baseUrl = reportButton.dataset.pageUrl;
                    if (!baseUrl) {
                        return;
                    }

                    const params = searchForm ? new URLSearchParams(new FormData(searchForm)) : new URLSearchParams(window.location.search);
                    const reportUrl = baseUrl + (params.toString() ? ('?' + params.toString()) : '');
                    window.location.href = reportUrl;
                });
            };

            const initReservationLiveSearch = function () {
                const root = document.getElementById('reservation-live-root');

                if (!root) {
                    return;
                }

                const form = root.querySelector('#reservation-search-form');

                if (!form) {
                    return;
                }

                const voiceBtn = form.querySelector('#reservation-voice-btn');
                const voiceInput = form.querySelector('input[name="q"]');
                const voiceToast = document.getElementById('reservation-voice-toast');
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

                let activeController = null;
                let activeRequestToken = 0;

                if (voiceBtn && voiceInput && voiceToast) {
                    if (!SpeechRecognition) {
                        voiceBtn.style.display = 'none';
                    } else {
                        const recognition = new SpeechRecognition();
                        recognition.lang = 'fr-FR';
                        recognition.continuous = false;
                        recognition.interimResults = true;
                        recognition.maxAlternatives = 1;

                        let isListening = false;
                        let toastTimer = null;

                        const showToast = function (message, type) {
                            if (toastTimer) {
                                window.clearTimeout(toastTimer);
                            }

                            voiceToast.textContent = message;
                            voiceToast.className = 'voice-toast voice-toast--' + type + ' voice-toast--visible';
                            toastTimer = window.setTimeout(function () {
                                voiceToast.classList.remove('voice-toast--visible');
                            }, 2800);
                        };

                        const stopListening = function () {
                            if (!isListening) {
                                return;
                            }

                            isListening = false;
                            voiceBtn.classList.remove('voice-btn--active');
                            try {
                                recognition.stop();
                            } catch (error) {
                                // Ignore stop errors when recognition already ended.
                            }
                        };

                        recognition.onstart = function () {
                            isListening = true;
                            voiceBtn.classList.add('voice-btn--active');
                            showToast('Parlez maintenant...', 'info');
                        };

                        recognition.onresult = function (event) {
                            let transcript = '';

                            for (let index = event.resultIndex; index < event.results.length; index += 1) {
                                transcript += event.results[index][0].transcript;
                            }

                            const value = transcript.trim();

                            if (value) {
                                voiceInput.value = value;
                                resetToFirstPage();
                                submitWithAjax();
                            }
                        };

                        recognition.onerror = function (event) {
                            stopListening();

                            const messages = {
                                'not-allowed': 'Microphone non autorisé. Vérifiez les permissions.',
                                'no-speech': 'Aucune voix détectée. Réessayez.',
                                'audio-capture': 'Impossible d\'accéder au microphone.',
                                'network': 'Erreur réseau lors de la reconnaissance vocale.'
                            };

                            showToast(messages[event.error] || 'Erreur vocale : ' + event.error, 'error');
                        };

                        recognition.onend = function () {
                            stopListening();
                        };

                        voiceBtn.addEventListener('click', function () {
                            if (isListening) {
                                stopListening();
                                return;
                            }

                            try {
                                recognition.start();
                            } catch (error) {
                                showToast('Impossible de démarrer la reconnaissance vocale.', 'error');
                            }
                        });
                    }
                }

                const queryInput = form.querySelector('input[name="q"]');
                const trackedFields = [
                    queryInput,
                    form.querySelector('select[name="field"]'),
                    form.querySelector('select[name="status"]'),
                    form.querySelector('input[name="date_from"]'),
                    form.querySelector('input[name="date_to"]'),
                    form.querySelector('select[name="sort"]')
                ].filter(Boolean);

                const resetToFirstPage = function () {
                    let pageInput = form.querySelector('input[name="page"]');

                    if (!pageInput) {
                        pageInput = document.createElement('input');
                        pageInput.type = 'hidden';
                        pageInput.name = 'page';
                        form.appendChild(pageInput);
                    }

                    pageInput.value = '1';
                };

                const requestAndSwap = function (url) {
                    if (activeController) {
                        activeController.abort();
                    }

                    activeController = new AbortController();
                    const requestToken = ++activeRequestToken;

                    return fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        signal: activeController.signal
                    })
                        .then(function (response) {
                            return response.text();
                        })
                        .then(function (html) {
                            if (requestToken !== activeRequestToken) {
                                return;
                            }

                            const parser = new DOMParser();
                            const nextDoc = parser.parseFromString(html, 'text/html');
                            const nextRoot = nextDoc.getElementById('reservation-live-root');

                            if (!nextRoot) {
                                window.location.href = url;
                                return;
                            }

                            root.innerHTML = nextRoot.innerHTML;
                            window.history.replaceState({}, '', url);
                            initReservationLiveSearch();
                            initReservationCsvExport();
                            animateCounter();
                        })
                        .catch(function (error) {
                            if (error && error.name === 'AbortError') {
                                return;
                            }

                            window.location.href = url;
                        });
                };

                const submitWithAjax = function () {
                    const params = new URLSearchParams(new FormData(form));
                    const url = form.action + (params.toString() ? ('?' + params.toString()) : '');
                    requestAndSwap(url);
                };

                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    submitWithAjax();
                });

                root.querySelectorAll('.quick-filter-btn, .page-link').forEach(function (link) {
                    link.addEventListener('click', function (event) {
                        event.preventDefault();
                        requestAndSwap(link.href);
                    });
                });

                trackedFields.forEach(function (field) {
                    if (field === queryInput) {
                        field.addEventListener('input', function () {
                            resetToFirstPage();
                            submitWithAjax();
                        });

                        field.addEventListener('keydown', function (event) {
                            if (event.key === 'Enter') {
                                event.preventDefault();
                                resetToFirstPage();
                                submitWithAjax();
                            }
                        });

                        return;
                    }

                    field.addEventListener('change', function () {
                        resetToFirstPage();
                        submitWithAjax();
                    });
                });
            };

            initReservationLiveSearch();
            initReservationCsvExport();
            initAiReport();
            initReservationFlashToasts();
            animateCounter();
        })();
    </script>
{% endblock %}
