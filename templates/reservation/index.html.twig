{% extends 'base.html.twig' %}

{% block title %}{{ 'reservation.title'|trans }}{% endblock %}

{% block body %}
    {% set success_flashes = app.flashes('success') %}
    {% set error_flashes = app.flashes('error') %}

    <section class="glass-card table-card reservation-admin-shell reservation-admin-shell-list" style="position: relative; overflow: hidden; background: linear-gradient(135deg, rgba(226, 239, 255, 0.6), rgba(209, 230, 255, 0.5)); backdrop-filter: blur(8px);">
        <div class="card-header">
            <div class="reservation-admin-header">
                <span class="reservation-admin-kicker">{{ 'reservation.panel'|trans }}</span>
                <h2 class="card-title">{{ 'reservation.list_title'|trans }}</h2>
                <p class="card-subtitle">{{ 'reservation.list_subtitle'|trans }}</p>
                <div style="margin-top: 0.35rem; font-weight: 700; color: #1e3a8a;">{{ 'reservation.counter'|trans }}: <span id="reservation-animated-counter" data-target="{{ result_count|default(0) }}">0</span></div>
            </div>
            <div class="card-actions">
                {% set target_locale = app.request.locale == 'fr' ? 'en' : 'fr' %}
                <button 
                    class="btn btn-secondary reservation-admin-cta" 
                    title="{{ 'common.switch_language'|trans }}"
                    data-controller="language-switcher"
                    data-language-switcher-url-value="{{ path('app_change_locale', {'locale': target_locale}) }}"
                    data-action="click->language-switcher#switch"
                    style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255, 255, 255, 0.3); backdrop-filter: blur(4px);"
                >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    <span>{{ (app.request.locale == 'fr' ? 'EN' : 'FR') }}</span>
                </button>
                <a href="{{ path('app_front_calendar') }}" class="btn btn-secondary reservation-admin-cta">{{ 'reservation.see_calendar'|trans }}</a>
                <a href="{{ path('app_reservation_export_pdf') }}" class="btn btn-secondary reservation-admin-cta">{{ 'reservation.export_pdf'|trans }}</a>
                <button type="button" id="reservation-ai-report-btn" class="btn btn-secondary reservation-admin-cta" data-page-url="{{ path('app_reservation_report_ai_page') }}">Rapport IA</button>
                <a href="{{ path('app_reservation_new') }}" class="btn btn-primary reservation-admin-cta">{{ 'reservation.create'|trans }}</a>
            </div>
        </div>
        <style>
            .reservation-admin-shell-list .card-header {
                position: relative;
                z-index: 1;
                padding: 1.1rem 1.2rem;
                margin-bottom: 1rem;
                border-radius: 18px;
                border: 1px solid rgba(148, 163, 184, 0.3);
                background:
                    radial-gradient(circle at right top, rgba(14, 165, 233, 0.2), transparent 40%),
                    linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(219, 234, 254, 0.68));
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 14px 28px rgba(15, 23, 42, 0.08);
            }

            .reservation-admin-shell-list .card-title {
                color: #0f172a;
            }

            .reservation-admin-shell-list .card-subtitle {
                color: #475569;
            }

            .admin-inline-select {
                max-width: 170px;
            }

            .reservation-search-row {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .admin-live-search-main {
                display: flex;
                align-items: center;
                gap: 0.7rem;
                flex: 1;
                min-width: 0;
            }

            .admin-sort-select {
                max-width: 190px;
                margin-left: auto;
            }

            .admin-result-count {
                opacity: 0.82;
                white-space: nowrap;
                font-weight: 700;
                color: #334155;
            }

            .admin-filter-label {
                font-size: 0.9rem;
                font-weight: 600;
                margin-right: 0.5rem;
            }

            /* Zonep-like search bar */
            #reservation-search-form .search-box {
