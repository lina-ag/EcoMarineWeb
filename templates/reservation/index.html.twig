                    <option value="all" {{ status_filter|default('all') == 'all' ? 'selected' : '' }}>{{ 'reservation.all_status'|trans }}</option>
                    <option value="confirmed" {{ status_filter|default('all') == 'confirmed' ? 'selected' : '' }}>{{ 'reservation.status_confirmed'|trans }}</option>
                    <option value="pending" {{ status_filter|default('all') == 'pending' ? 'selected' : '' }}>{{ 'reservation.status_pending'|trans }}</option>
                    <option value="cancelled" {{ status_filter|default('all') == 'cancelled' ? 'selected' : '' }}>{{ 'reservation.status_cancelled'|trans }}</option>
                </select>
                <input id="reservation-date-from" name="date_from" type="date" value="{{ date_from|default('') }}" class="search-input combo-input admin-inline-select" title="{{ 'reservation.date_start'|trans }}" />
                <input id="reservation-date-to" name="date_to" type="date" value="{{ date_to|default('') }}" class="search-input combo-input admin-inline-select" title="{{ 'reservation.date_end'|trans }}" />
