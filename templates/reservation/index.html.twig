                    <option value="id_asc" {{ sort_by|default('id_desc') == 'id_asc' ? 'selected' : '' }}>{{ 'reservation.sort_oldest'|trans }}</option>
                    <option value="date_desc" {{ sort_by|default('id_desc') == 'date_desc' ? 'selected' : '' }}>{{ 'reservation.sort_date_recent'|trans }}</option>
                    <option value="date_asc" {{ sort_by|default('id_desc') == 'date_asc' ? 'selected' : '' }}>{{ 'reservation.sort_date_old'|trans }}</option>
                    <option value="nom_asc" {{ sort_by|default('id_desc') == 'nom_asc' ? 'selected' : '' }}>{{ 'reservation.sort_name_az'|trans }}</option>
                    <option value="nom_desc" {{ sort_by|default('id_desc') == 'nom_desc' ? 'selected' : '' }}>{{ 'reservation.sort_name_za'|trans }}</option>
