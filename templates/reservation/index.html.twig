{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const form = document.getElementById('reservation-search-form');
            const input = document.getElementById('reservation-search-input');

            if (!form || !input) {
                return;
            }

            let timer = null;
            input.addEventListener('input', function () {
                window.clearTimeout(timer);
                timer = window.setTimeout(function () {
                    form.requestSubmit();
                }, 300);
            });
        })();
    </script>
