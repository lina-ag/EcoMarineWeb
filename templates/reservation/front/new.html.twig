{% extends 'base.html.twig' %}

{% block title %}Nouvelle reservation{% endblock %}

{% block body %}
    {% include 'home/_front_form_theme.html.twig' %}

    <video autoplay muted loop playsinline class="front-video-bg">
        <source src="/assets/images/video-bg.mp4" type="video/mp4">
    </video>
    <div class="front-video-overlay"></div>

    <div class="front-page-shell">
        {% include 'home/_front_navbar.html.twig' %}

        <section class="front-form-shell">
            <div class="card-header">
                <div class="reservation-admin-header">
                    <span class="reservation-admin-kicker">Reservation Panel</span>
                    <h2 class="card-title">Creer une reservation</h2>
                    <p class="card-subtitle">Renseignez les informations du visiteur et de l'activite.</p>
                </div>
            </div>

            {{ include('reservation/_form.html.twig', {'button_label': 'Enregistrer'}) }}
        </section>
    </div>
{% endblock %}
