        <div class="form-group-settings full-width {% if form.image_path.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.image_path, null, {'label_attr': {'class': 'form-label'}}) }}
            
            <div class="file-drop-area" id="imageDropArea">
                <div class="file-drop-icon">📸</div>
                <div class="file-drop-text">Glissez-déposez une image ici</div>
                <div class="file-drop-info">ou cliquez pour sélectionner (Max 10 MB)</div>
            </div>
            
            {{ form_widget(form.image_path, {'attr': {'class': 'form-input file-input'}}) }}
            
            <div id="filePreview" class="file-preview" style="display: none;">
                <img id="previewImg" class="file-preview-img" src="" alt="Aperçu">
                <div class="file-preview-info">
                    <div class="file-preview-name" id="fileName"></div>
                    <div class="file-preview-size" id="fileSize"></div>
                </div>
                <button type="button" class="file-preview-remove" id="removeFile">✕ Supprimer</button>
