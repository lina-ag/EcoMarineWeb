{{ form_start(form) }}
    <div class="form-grid">
        {# ═══════════════════════════════════════════════════════════ #}
        {# IMAGE UPLOAD + ECOMARINE AI ANALYSIS SECTION               #}
        {# ═══════════════════════════════════════════════════════════ #}
        <div class="form-group-settings full-width {% if form.image_path.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.image_path, null, {'label_attr': {'class': 'form-label'}}) }}
            
            <label class="file-drop-area" id="imageDropArea" for="{{ form.image_path.vars.id }}">
                <div class="file-drop-icon">📸</div>
                <div class="file-drop-text">Glissez-déposez une image ici</div>
                <div class="file-drop-info">ou cliquez pour sélectionner (JPEG, PNG, GIF, WebP - Max 10 MB)</div>
            </label>
            
            {{ form_widget(form.image_path, {'attr': {'class': 'form-input', 'id': 'imageFileInput'}}) }}
            
            <div id="filePreview" class="file-preview" style="display: none;">
                <img id="previewImg" class="file-preview-img" src="" alt="Aperçu">
                <div class="file-preview-info">
                    <div class="file-preview-name" id="fileName"></div>
                    <div class="file-preview-size" id="fileSize"></div>
                </div>
                <button type="button" class="file-preview-remove" id="removeFile">✕ Supprimer</button>
            </div>
            
            {% if form.image_path.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.image_path) }}
                </div>
            {% endif %}

            {# ── EcoMarine AI Analysis Button ── #}
            <button type="button" id="analyzeWithGrokBtn" class="btn-grok-analyze" style="display: none;">
                <span class="grok-btn-icon">🐠</span>
                <span class="grok-btn-text">Analyser avec EcoMarine IA</span>
                <span class="grok-btn-loader" style="display: none;">
                    <span class="spinner"></span>
                    Analyse en cours...
                </span>
            </button>
        </div>

        {# ── AI Analysis Result Card ── #}
        <div id="grokResultCard" class="grok-result-card full-width" style="display: none;">
            <div class="grok-result-header">
                <span class="grok-result-icon">🧠</span>
                <span class="grok-result-title">Résultat de l'analyse EcoMarine IA</span>
                <span id="grokConfidenceBadge" class="grok-confidence-badge"></span>
            </div>
            <div id="grokResultBody" class="grok-result-body">
                <p id="grokDescription" class="grok-description"></p>
            </div>
            <div id="grokErrorMsg" class="grok-error-msg" style="display: none;"></div>
        </div>

        {# ═══════════════════════════════════════════════════════════ #}
        {# FORM FIELDS (auto-filled by AI)                            #}
        {# ═══════════════════════════════════════════════════════════ #}
        <div class="form-group-settings {% if form.espece.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.espece, null, {'label_attr': {'class': 'form-label'}}) }}
            <span class="form-required">*</span>
            {{ form_widget(form.espece, {'attr': {'class': 'form-input', 'required': 'required', 'id': 'field_espece'}}) }}
            {% if form.espece.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.espece) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings {% if form.nombre_individus.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.nombre_individus, null, {'label_attr': {'class': 'form-label'}}) }}
            <span class="form-required">*</span>
            {{ form_widget(form.nombre_individus, {'attr': {'class': 'form-input', 'required': 'required', 'id': 'field_nombre_individus'}}) }}
            {% if form.nombre_individus.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.nombre_individus) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings {% if form.latitude.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.latitude, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.latitude, {'attr': {'class': 'form-input'}}) }}
            {% if form.latitude.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.latitude) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings {% if form.longitude.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.longitude, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.longitude, {'attr': {'class': 'form-input'}}) }}
            {% if form.longitude.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.longitude) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings {% if form.comportement.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.comportement, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.comportement, {'attr': {'class': 'form-input form-select', 'id': 'field_comportement'}}) }}
            {% if form.comportement.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.comportement) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings {% if form.confiance_ia.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.confiance_ia, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.confiance_ia, {'attr': {'class': 'form-input form-select', 'id': 'field_confiance_ia'}}) }}
            {% if form.confiance_ia.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.confiance_ia) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings full-width {% if form.timestamp.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.timestamp, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.timestamp, {'attr': {'class': 'form-input'}}) }}
            <small class="form-help-text">Généré automatiquement</small>
            {% if form.timestamp.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.timestamp) }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="btn-group">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
    </div>

    {{ form_rest(form) }}
{{ form_end(form) }}

{# ═══════════════════════════════════════════════════════════════════ #}
{# STYLES FOR ECOMARINE AI INTEGRATION                                #}
{# ═══════════════════════════════════════════════════════════════════ #}
<style>
/* ── Image Dropzone ── */
.file-drop-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 180px;
    width: 100%;
    border: 2px dashed rgba(148, 163, 184, 0.5);
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.35);
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease;
    padding: 20px;
    text-align: center;
}

.file-drop-area + .form-input[type="file"] {
    margin-top: 10px;
}

.file-drop-area:hover {
    border-color: rgba(99, 102, 241, 0.7);
    background: rgba(30, 41, 59, 0.45);
}

.file-drop-area.dragover {
    border-color: #6366f1;
    background: rgba(99, 102, 241, 0.12);
    transform: scale(1.01);
}

.file-drop-icon {
    font-size: 34px;
}

.file-drop-text {
    color: #e2e8f0;
    font-weight: 600;
    font-size: 15px;
}

.file-drop-info {
    color: #94a3b8;
    font-size: 13px;
}

.file-preview {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border: 1px solid rgba(148, 163, 184, 0.35);
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.4);
}

.file-preview-img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(148, 163, 184, 0.25);
}

.file-preview-info {
    flex: 1;
    min-width: 0;
}

.file-preview-name {
    color: #f8fafc;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-preview-size {
    color: #94a3b8;
    font-size: 12px;
}

.file-preview-remove {
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 10px;
    background: rgba(239, 68, 68, 0.12);
    color: #fca5a5;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 10px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.file-preview-remove:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #fecaca;
}

/* ── Grok Analyze Button ── */
.btn-grok-analyze {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-top: 12px;
    padding: 14px 24px;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
    position: relative;
    overflow: hidden;
}

.btn-grok-analyze::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transition: left 0.5s;
}

.btn-grok-analyze:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.45);
}

.btn-grok-analyze:hover::before {
    left: 100%;
}

.btn-grok-analyze:active {
    transform: translateY(0);
}

.btn-grok-analyze:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
}

.grok-btn-icon {
    font-size: 20px;
}

.grok-btn-loader {
    display: flex;
    align-items: center;
    gap: 8px;
}

/* ── Spinner ── */
.spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ── Result Card ── */
.grok-result-card {
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 14px;
    padding: 0;
    margin-top: 8px;
    overflow: hidden;
    animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.grok-result-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.1));
    border-bottom: 1px solid rgba(99, 102, 241, 0.15);
}

.grok-result-icon {
    font-size: 22px;
}

.grok-result-title {
    font-weight: 600;
    font-size: 14px;
    color: #a5b4fc;
    flex: 1;
}

.grok-confidence-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.grok-confidence-badge.high {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
}

.grok-confidence-badge.medium {
    background: rgba(234, 179, 8, 0.15);
    color: #facc15;
    border: 1px solid rgba(234, 179, 8, 0.3);
}

.grok-confidence-badge.low {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.grok-result-body {
    padding: 14px 18px;
}

.grok-description {
    color: #c4b5fd;
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
}

.grok-error-msg {
    padding: 14px 18px;
    color: #f87171;
    font-size: 13px;
    background: rgba(239, 68, 68, 0.08);
    border-top: 1px solid rgba(239, 68, 68, 0.15);
}

/* ── AI-filled field glow animation ── */
@keyframes aiGlow {
    0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4); }
    50% { box-shadow: 0 0 12px 3px rgba(139, 92, 246, 0.3); }
    100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
}

.ai-filled {
    animation: aiGlow 1.5s ease-out;
    border-color: rgba(139, 92, 246, 0.5) !important;
}

.ai-filled-label {
    position: relative;
}

.ai-filled-label::after {
    content: '🤖';
    margin-left: 6px;
    font-size: 14px;
    animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
}
</style>

{# ═══════════════════════════════════════════════════════════════════ #}
{# JAVASCRIPT FOR IMAGE HANDLING + ECOMARINE AI ANALYSIS              #}
{# ═══════════════════════════════════════════════════════════════════ #}
<script>
function initDetectionDroneForm() {
    const imageInputId = '{{ form.image_path.vars.id }}';
    const dropArea = document.getElementById('imageDropArea');
    const fileInput = document.getElementById(imageInputId) || document.getElementById('imageFileInput');
    const filePreview = document.getElementById('filePreview');
    const previewImg = document.getElementById('previewImg');
    const fileName = document.getElementById('fileName');
    const fileSize = document.getElementById('fileSize');
    const removeBtn = document.getElementById('removeFile');
    const analyzeBtn = document.getElementById('analyzeWithGrokBtn');
    const resultCard = document.getElementById('grokResultCard');
    const confidenceBadge = document.getElementById('grokConfidenceBadge');
    const grokDescription = document.getElementById('grokDescription');
    const grokErrorMsg = document.getElementById('grokErrorMsg');

    let currentFile = null;

    if (!dropArea || !fileInput) return;
    if (dropArea.dataset.dndInitialized === '1') return;
    dropArea.dataset.dndInitialized = '1';

    // ── Drag & Drop ──
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
        document.body.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => {
            dropArea.classList.add('dragover');
        }, false);
    });

    dropArea.addEventListener('dragover', (e) => {
        if (e.dataTransfer) {
            e.dataTransfer.dropEffect = 'copy';
        }
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => {
            dropArea.classList.remove('dragover');
        }, false);
    });

    dropArea.addEventListener('drop', (e) => {
        const files = e.dataTransfer?.files;
        if (!files || files.length === 0) return;

        const droppedFile = files[0];
        const inputSynced = syncInputWithSingleFile(droppedFile);

        if (!inputSynced) {
            alert('Votre navigateur ne permet pas le drag-and-drop pour ce champ. Cliquez sur la zone pour choisir un fichier.');
            return;
        }

        handleFiles(fileInput.files);
    }, false);

    fileInput.addEventListener('change', (e) => {
        handleFiles(e.target.files);
    });

    removeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        fileInput.value = '';
        currentFile = null;
        filePreview.style.display = 'none';
        dropArea.style.display = 'flex';
        analyzeBtn.style.display = 'none';
        resultCard.style.display = 'none';
    });

    function handleFiles(files) {
        if (files.length === 0) return;

        const file = files[0];

        // Validate MIME type
        if (!isAcceptedImage(file)) {
            alert('Types autorisés: JPEG, PNG, GIF, WebP');
            fileInput.value = '';
            return;
        }

        // Validate size (10 MB)
        if (file.size > 10 * 1024 * 1024) {
            alert('Le fichier dépasse 10 MB');
            fileInput.value = '';
            return;
        }

        currentFile = file;

        // Show preview
        const reader = new FileReader();
        reader.onload = (e) => {
            previewImg.src = e.target.result;
            fileName.textContent = file.name;
            fileSize.textContent = (file.size / 1024 / 1024).toFixed(2) + ' MB';
            filePreview.style.display = 'flex';
            dropArea.style.display = 'none';
            
            // Show the AI analyze button
            analyzeBtn.style.display = 'flex';
        };
        reader.readAsDataURL(file);
    }

    function isAcceptedImage(file) {
        const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        const validExtensions = ['jpg', 'jpeg', 'png', 'gif', 'webp'];
        const mime = (file.type || '').toLowerCase();

        if (validTypes.includes(mime)) {
            return true;
        }

        const ext = (file.name.split('.').pop() || '').toLowerCase();
        return validExtensions.includes(ext);
    }

    function syncInputWithSingleFile(file) {
        if (typeof DataTransfer === 'undefined') {
            return false;
        }

        try {
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            fileInput.files = dataTransfer.files;
            return fileInput.files && fileInput.files.length > 0;
        } catch (error) {
            return false;
        }
    }

    // ══════════════════════════════════════════════════════
    //  ECOMARINE AI IMAGE ANALYSIS
    // ══════════════════════════════════════════════════════
    analyzeBtn.addEventListener('click', async function() {
        if (!currentFile) {
            alert('Veuillez d\'abord sélectionner une image.');
            return;
        }

        // Toggle button state
        const btnText = analyzeBtn.querySelector('.grok-btn-text');
        const btnIcon = analyzeBtn.querySelector('.grok-btn-icon');
        const btnLoader = analyzeBtn.querySelector('.grok-btn-loader');
        
        analyzeBtn.disabled = true;
        btnText.style.display = 'none';
        btnIcon.style.display = 'none';
        btnLoader.style.display = 'flex';
        
        // Hide previous results
        resultCard.style.display = 'none';
        grokErrorMsg.style.display = 'none';

        try {
            const formData = new FormData();
            formData.append('image', currentFile);

            const response = await fetch('{{ path("app_detection_drone_analyze") }}', {
                method: 'POST',
                body: formData,
            });

            const data = await response.json();

            // Show result card
            resultCard.style.display = 'block';

            if (data.success) {
                // ── Auto-fill form fields ──
                autoFillField('field_espece', data.espece);
                autoFillField('field_nombre_individus', data.nombre_individus);
                autoFillSelect('field_comportement', data.comportement);
                autoFillSelect('field_confiance_ia', data.confiance_ia);

                // ── Display AI result card ──
                grokDescription.textContent = data.description || 'Analyse terminée avec succès.';
                grokErrorMsg.style.display = 'none';

                // Set confidence badge
                const confidence = data.confiance_ia || 'Moyen';
                confidenceBadge.textContent = confidence;
                if (['Fort', 'Très fort'].includes(confidence)) {
                    confidenceBadge.className = 'grok-confidence-badge high';
                } else if (confidence === 'Moyen') {
                    confidenceBadge.className = 'grok-confidence-badge medium';
                } else {
                    confidenceBadge.className = 'grok-confidence-badge low';
                }

            } else {
                // Show error
                grokDescription.textContent = '';
                grokErrorMsg.textContent = '❌ ' + (data.error || 'Erreur inconnue lors de l\'analyse.');
                grokErrorMsg.style.display = 'block';
                confidenceBadge.textContent = 'Erreur';
                confidenceBadge.className = 'grok-confidence-badge low';
            }

        } catch (error) {
            resultCard.style.display = 'block';
            grokDescription.textContent = '';
            grokErrorMsg.textContent = '❌ Erreur réseau: ' + error.message;
            grokErrorMsg.style.display = 'block';
            confidenceBadge.textContent = 'Erreur';
            confidenceBadge.className = 'grok-confidence-badge low';

        } finally {
            // Reset button state
            analyzeBtn.disabled = false;
            btnText.style.display = 'inline';
            btnIcon.style.display = 'inline';
            btnLoader.style.display = 'none';
        }
    });

    /**
     * Auto-fill a text/number input field with AI glow animation
     */
    function autoFillField(fieldId, value) {
        // Try to find by our custom id first, then by Symfony's auto-generated id
        let field = document.getElementById(fieldId);
        if (!field) {
            // Symfony generates ids like "detection_drone_espece"
            const sfId = fieldId.replace('field_', 'detection_drone_');
            field = document.getElementById(sfId);
        }
        if (field && value !== null && value !== undefined) {
            field.value = value;
            field.classList.add('ai-filled');
            
            // Add robot emoji to label
            const label = field.closest('.form-group-settings')?.querySelector('.form-label');
            if (label && !label.classList.contains('ai-filled-label')) {
                label.classList.add('ai-filled-label');
            }

            // Remove glow after animation
            setTimeout(() => field.classList.remove('ai-filled'), 2000);
        }
    }

    /**
     * Auto-fill a select dropdown with AI glow animation
     */
    function autoFillSelect(fieldId, value) {
        let field = document.getElementById(fieldId);
        if (!field) {
            const sfId = fieldId.replace('field_', 'detection_drone_');
            field = document.getElementById(sfId);
        }
        if (field && value) {
            // Find matching option
            for (let option of field.options) {
                if (option.value === value || option.text === value) {
                    field.value = option.value;
                    break;
                }
            }
            field.classList.add('ai-filled');
            
            const label = field.closest('.form-group-settings')?.querySelector('.form-label');
            if (label && !label.classList.contains('ai-filled-label')) {
                label.classList.add('ai-filled-label');
            }

            setTimeout(() => field.classList.remove('ai-filled'), 2000);
        }
    }
}

document.addEventListener('DOMContentLoaded', initDetectionDroneForm);
document.addEventListener('turbo:load', initDetectionDroneForm);
</script>