{% extends 'base_admin.html.twig' %}

{% block page_title %}DNA Activité{% endblock %}
{% block navbar_title %}Analyse DNA activité{% endblock %}

{% block admin_stylesheets %}
    {{ parent() }}
    <style>
        .dna-hero {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at top right, rgba(59, 130, 246, 0.18), transparent 32%),
                radial-gradient(circle at left bottom, rgba(16, 185, 129, 0.16), transparent 30%),
                linear-gradient(135deg, rgba(8, 47, 73, 0.05), rgba(255, 255, 255, 0.92));
            border: 1px solid rgba(59, 130, 246, 0.16);
            border-radius: 22px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
        }

        .dna-hero-layout {
            display: grid;
            grid-template-columns: 1.4fr auto;
            gap: 1.25rem;
            align-items: center;
        }

        .dna-hero-copy {
            min-width: 0;
        }

        .dna-hero h1 {
            font-size: 2.35rem;
            margin: 0 0 0.5rem;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .dna-hero-subtitle {
            color: #64748b;
            margin: 0;
            font-size: 1rem;
        }

        .dna-badge-main {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.75rem 1rem;
            margin-top: 1rem;
            border-radius: 999px;
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: 0.02em;
            color: #0f172a;
            box-shadow: 0 0 0 1px rgba(255,255,255,0.45) inset, 0 16px 36px rgba(15, 23, 42, 0.16), 0 0 26px rgba(59, 130, 246, 0.22);
        }

        .dna-badge-main--hot {
            background: linear-gradient(135deg, #fdba74, #f97316 55%, #ef4444);
        }

        .dna-badge-main--ice {
            background: linear-gradient(135deg, #bae6fd, #38bdf8 55%, #0ea5e9);
        }

        .dna-badge-main--neutral {
            background: linear-gradient(135deg, #e9d5ff, #8b5cf6 55%, #4f46e5);
        }

        .dna-hero-progress {
            width: 220px;
            max-width: 100%;
            justify-self: end;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dna-progress-ring {
            width: 210px;
            height: 210px;
            filter: drop-shadow(0 18px 30px rgba(15, 23, 42, 0.18));
        }

        .dna-progress-ring__track {
            stroke: rgba(148, 163, 184, 0.18);
        }

        .dna-progress-ring__fill {
            stroke-linecap: round;
            transition: stroke-dashoffset 0.35s ease;
        }

        .dna-progress-ring__center {
            fill: rgba(255, 255, 255, 0.86);
        }

        .dna-progress-ring__label {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            fill: #64748b;
        }

        .dna-progress-ring__value {
            font-size: 1.75rem;
            font-weight: 900;
            fill: #0f172a;
        }

        .dna-progress-ring__caption {
            font-size: 0.76rem;
            fill: #64748b;
        }

        .dna-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
            gap: 1.2rem;
            margin-bottom: 2rem;
        }

        .dna-card {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(148, 163, 184, 0.35);
            border-left-width: 7px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.8));
            border-radius: 18px;
            padding: 1.4rem;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
            backdrop-filter: blur(4px);
            animation: dnaFadeUp 0.6s ease both;
            animation-delay: var(--dna-card-delay, 0s);
        }

        .dna-card::after {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(145deg, rgba(255,255,255,0.2), transparent 30%);
        }

        .dna-card--hot {
            border-left-color: #ef4444;
        }

        .dna-card--ice {
            border-left-color: #0ea5e9;
        }

        .dna-card-icon {
            font-size: 1.9rem;
            margin-bottom: 0.6rem;
        }

        .dna-card-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            margin-bottom: 0.4rem;
            font-weight: 700;
        }

        .dna-card-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        .dna-card-meta {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-top: 0.6rem;
            line-height: 1.4;
        }

        .dna-empty-context {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.55rem;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.05);
            color: #475569;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .dna-summary {
            border: 1px solid rgba(59, 130, 246, 0.2);
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(16, 185, 129, 0.12));
            border-radius: 14px;
            padding: 1.2rem;
            margin-bottom: 2rem;
        }

        .dna-section {
            margin-bottom: 2rem;
        }

        .dna-section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .dna-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
            gap: 1rem;
        }

        .dna-panel {
            border: 1px solid rgba(148, 163, 184, 0.34);
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.78);
            padding: 1rem;
        }

        .dna-panel h3 {
            font-size: 1rem;
            margin: 0 0 0.7rem;
            color: #0f172a;
        }

        .dna-empty {
            color: #64748b;
            font-size: 0.9rem;
            margin: 0;
        }

        .similar-activities {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .similar-card {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(148, 163, 184, 0.35);
            border-left-width: 6px;
            border-left-color: rgba(59, 130, 246, 0.58);
            border-radius: 12px;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.82);
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }

        .similar-card:hover {
            box-shadow: 0 10px 22px rgba(59, 130, 246, 0.16);
            border-color: rgba(59, 130, 246, 0.45);
            transform: translateY(-2px);
        }

        .similar-card-name {
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 0.4rem;
        }

        .similar-card-dna {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.65rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            margin-bottom: 0.55rem;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
        }

        .similar-card-fill {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            margin-bottom: 0.55rem;
        }

        .similar-card-fill-track {
            height: 0.45rem;
            border-radius: 999px;
            background: rgba(148, 163, 184, 0.18);
            overflow: hidden;
        }

        .similar-card-fill-bar {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #0ea5e9, #22c55e);
            box-shadow: 0 0 16px rgba(14, 165, 233, 0.24);
        }

        .similar-card-fill-meta {
            display: flex;
            justify-content: space-between;
            gap: 0.5rem;
            font-size: 0.75rem;
            font-weight: 700;
            color: #64748b;
        }

        .dna-hero,
        .dna-summary,
        .dna-card,
        .similar-card,
        .dna-panel {
            max-width: 100%;
            box-sizing: border-box;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .dna-stagger-1 { animation-delay: 0.05s; }
        .dna-stagger-2 { animation-delay: 0.1s; }
        .dna-stagger-3 { animation-delay: 0.15s; }
        .dna-stagger-4 { animation-delay: 0.2s; }
        .dna-stagger-5 { animation-delay: 0.25s; }
        .dna-stagger-6 { animation-delay: 0.3s; }

        @keyframes dnaFadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 1024px) {
            .dna-layout {
                grid-template-columns: 1fr;
            }

            .dna-hero-layout {
                grid-template-columns: 1fr;
            }

            .dna-hero-progress {
                justify-self: start;
            }
        }

        @media (max-width: 640px) {
            .dna-hero {
                padding: 1.2rem;
            }

            .dna-grid,
            .similar-activities {
                grid-template-columns: 1fr;
            }

            .dna-progress-ring {
                width: 180px;
                height: 180px;
            }
        }
    </style>
{% endblock %}

{% block admin_content %}
    <section class="glass-card">
        <div style="margin-bottom: 1rem; display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; justify-content:space-between;">
            <a href="{{ path('app_activite_ecologique_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
            <a href="{{ path('app_activite_ecologique_dna_pdf', {'id_activite': activite_ecologique.idActivite}) }}" class="btn btn-primary" style="background: linear-gradient(135deg, #1d4ed8, #0f766e); border:none; box-shadow: 0 10px 24px rgba(29, 78, 216, 0.22);">⬇️ Exporter le PDF DNA</a>
        </div>

        {% set fill_rate_capped = fill_rate < 0 ? 0 : (fill_rate > 100 ? 100 : fill_rate) %}
        {% set dna_profile_tone = fill_rate_capped >= 60 ? 'hot' : 'ice' %}
        {% set empty_context_message = 'Aucune réservation encore — lancez une campagne' %}
        {% set hero_dashoffset = 2 * 3.14159 * 42 * (1 - (fill_rate_capped / 100)) %}

        {# ── HERO SECTION ────────────────────────────────────────────────── #}
        <div class="dna-hero">
            <div class="dna-hero-layout">
                <div class="dna-hero-copy">
                    <h1>
                        🧬 DNA de "{{ activite_ecologique.nomActivite }}"
                    </h1>
                    <p class="dna-hero-subtitle">Activité #{{ activite_ecologique.idActivite }} — Analyse comportementale des réservations</p>

                    {% if dna %}
                        <div class="dna-badge-main dna-badge-main--{{ dna_profile_tone }}">
                            <span>DNA</span>
                            <span>{{ dna.dna_label }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="dna-hero-progress" aria-label="Taux de remplissage">
                    <svg class="dna-progress-ring" viewBox="0 0 120 120" role="img" aria-hidden="true">
                        <defs>
                            <linearGradient id="dnaFillGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="{{ dna_profile_tone == 'hot' ? '#fb7185' : '#38bdf8' }}" />
                                <stop offset="100%" stop-color="{{ dna_profile_tone == 'hot' ? '#ea580c' : '#0ea5e9' }}" />
                            </linearGradient>
                        </defs>
                        <circle class="dna-progress-ring__track" cx="60" cy="60" r="42" fill="none" stroke-width="10" />
                        <circle
                            class="dna-progress-ring__fill"
                            cx="60"
                            cy="60"
                            r="42"
                            fill="none"
                            stroke="url(#dnaFillGradient)"
                            stroke-width="10"
                            stroke-dasharray="263.89"
                            stroke-dashoffset="{{ hero_dashoffset }}"
                            transform="rotate(-90 60 60)"
                        />
                        <circle class="dna-progress-ring__center" cx="60" cy="60" r="32" />
                        <text x="60" y="52" text-anchor="middle" class="dna-progress-ring__label">Remplissage</text>
                        <text x="60" y="72" text-anchor="middle" class="dna-progress-ring__value">{{ fill_rate_capped|round }}%</text>
                        <text x="60" y="88" text-anchor="middle" class="dna-progress-ring__caption">{{ fill_rate_capped >= 66 ? '🔥 forte traction' : (fill_rate_capped >= 33 ? '📊 rythme stable' : '🧊 potentiel à activer') }}</text>
                    </svg>
                </div>
            </div>
        </div>

        {# ── MAIN METRICS GRID ────────────────────────────────────────────────────── #}
        <div class="dna-grid">
            {# 👥 Profil dominant #}
            <div class="dna-card dna-card--{{ dna_profile_tone }} dna-stagger-1">
                <div class="dna-card-icon">👥</div>
                <div class="dna-card-label">Profil dominant</div>
                <div class="dna-card-value">
                    {% if dna and dna.min_groupe and dna.max_groupe %}
                        {{ dna.min_groupe|round }} à {{ dna.max_groupe|round }} pers.
                    {% elseif avg_group > 0 %}
                        ~{{ avg_group }} pers.
                    {% else %}
                        <span class="dna-empty-context">{{ empty_context_message }}</span>
                    {% endif %}
                </div>
                <div class="dna-card-meta">
                    groupes de réservations
                </div>
            </div>

            {# 📅 Délai moyen #}
            <div class="dna-card dna-card--{{ dna_profile_tone }} dna-stagger-2">
                <div class="dna-card-icon">📅</div>
                <div class="dna-card-label">Réservée à l'avance</div>
                <div class="dna-card-value">
                    {% if dna and dna.avg_delai > 0 %}
                        {{ dna.avg_delai|round }} jours
                    {% elseif avg_lead_time > 0 %}
                        {{ avg_lead_time|round }} jours
                    {% else %}
                        <span class="dna-empty-context">{{ empty_context_message }}</span>
                    {% endif %}
                </div>
                <div class="dna-card-meta">
                    {% if min_lead_time is not null and max_lead_time is not null %}
                        entre {{ min_lead_time }}j et {{ max_lead_time }}j
                    {% else %}
                        {{ empty_context_message }}
                    {% endif %}
                </div>
            </div>

            {# 🕐 Pic de réservation #}
            <div class="dna-card dna-card--{{ dna_profile_tone }} dna-stagger-3">
                <div class="dna-card-icon">🕐</div>
                <div class="dna-card-label">Pic de réservation</div>
                <div class="dna-card-value">
                    {% if dna and dna.jour_pic %}
                        {{ dna.jour_pic }}
                    {% else %}
                        <span class="dna-empty-context">{{ empty_context_message }}</span>
                    {% endif %}
                </div>
                <div class="dna-card-meta">
                    jour de la semaine préféré
                </div>
            </div>

            {# 🔁 Taux de retour #}
            <div class="dna-card dna-card--{{ dna_profile_tone }} dna-stagger-4">
                <div class="dna-card-icon">🔁</div>
                <div class="dna-card-label">Taux de retour</div>
                <div class="dna-card-value">
                    {{ taux_retour|round }}%
                </div>
                <div class="dna-card-meta">
                    clients fidèles ({{ unique_visitors }} visiteurs uniques)
                </div>
            </div>

            {# 🌡️ Sensibilité saisonnière #}
            <div class="dna-card dna-card--{{ dna_profile_tone }} dna-stagger-5">
                <div class="dna-card-icon">🌡️</div>
                <div class="dna-card-label">Sensibilité saisonnière</div>
                <div class="dna-card-value">
                    {% if dna and dna.sensibilite_saisonniere %}
                        × {{ dna.sensibilite_saisonniere }}
                    {% else %}
                        <span class="dna-empty-context">{{ empty_context_message }}</span>
                    {% endif %}
                </div>
                <div class="dna-card-meta">
                    ratio été vs hiver
                </div>
            </div>

            {# ⚡ Vitesse de remplissage #}
            <div class="dna-card dna-card--{{ dna_profile_tone }} dna-stagger-6">
                <div class="dna-card-icon">⚡</div>
                <div class="dna-card-label">Vitesse de remplissage</div>
                <div class="dna-card-value">
                    {% if dna and dna.vitesse_remplissage %}
                        {{ dna.vitesse_remplissage }}
                    {% else %}
                        <span class="dna-empty-context">{{ empty_context_message }}</span>
                    {% endif %}
                </div>
                <div class="dna-card-meta">
                    {{ fill_rate_capped|round }}% remplie
                </div>
            </div>
        </div>

        {# ── SUMMARY INSIGHTS ────────────────────────────────────────────── #}
        <div class="dna-summary">
            <strong>📊 Lecture du profil:</strong> {{ profile_summary }}
            <div style="margin-top: 0.8rem; font-size: 0.9rem; color: #475569; line-height: 1.5;">
                ✓ {{ total_reservations }} réservations enregistrées
                ✓ {{ total_people }} personnes au total
                ✓ Capacité de l'activité: {{ activite_ecologique.capacite }} personnes
            </div>
        </div>

        {# ── DATA TABLE SECTION ──────────────────────────────────────────── #}
        <div class="dna-layout">
            <div class="dna-panel">
                <h3>📋 Historique des réservations</h3>
                {% if recent_reservations is not empty %}
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date réservation</th>
                                    <th>Email</th>
                                    <th>Pers.</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in recent_reservations %}
                                    <tr>
                                        <td>{{ reservation.idReservation }}</td>
                                        <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '—' }}</td>
                                        <td style="font-size: 0.85rem; word-break: break-all;">{{ reservation.email }}</td>
                                        <td>{{ reservation.nombrePersonnes }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="dna-empty">Aucune réservation enregistrée pour cette activité.</p>
                {% endif %}
            </div>

            <div class="dna-panel">
                <h3>📈 Distribution mensuelle</h3>
                {% if monthly_bookings is not empty %}
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Mois</th>
                                    <th>Participants</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for month, people in monthly_bookings %}
                                    <tr>
                                        <td>{{ month }}</td>
                                        <td>{{ people }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="dna-empty">Pas de distribution disponible.</p>
                {% endif %}
            </div>
        </div>

        {# ── BUTTONS ────────────────────────────────────────────────────── #}
        <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="{{ path('app_activite_ecologique_index') }}" class="btn btn-secondary">← Retour liste</a>
            <a href="{{ path('app_activite_ecologique_dna_pdf', {'id_activite': activite_ecologique.idActivite}) }}" class="btn btn-primary" style="background: linear-gradient(135deg, #1d4ed8, #0f766e); border:none; box-shadow: 0 10px 24px rgba(29, 78, 216, 0.22);">⬇️ Export PDF</a>
            <a href="{{ path('app_activite_ecologique_show', {'id_activite': activite_ecologique.id_activite}) }}" class="btn btn-primary">Voir fiche activité</a>
        </div>
    </section>
{% endblock %}

{% block admin_javascripts %}
    {{ parent() }}
{% endblock %}

