<script>
(() => {
    const recurringToggle = document.getElementById('{{ form.is_recurring.vars.id }}');
    const recurrenceBox = document.getElementById('{{ form.is_recurring.vars.id }}_recurrence_box');
    const preview = document.getElementById('{{ form.is_recurring.vars.id }}_recurrence_preview');
    const startDateInput = document.getElementById('{{ form.date_activite.vars.id }}');
    const endDateInput = document.getElementById('{{ form.recurrence_end_date.vars.id }}');
    const dayInputs = recurrenceBox ? recurrenceBox.querySelectorAll('input[type="checkbox"]') : [];

    if (!recurringToggle || !recurrenceBox || !preview) {
        return;
    }

    const setupDatePicker = (input) => {
        if (!input) {
            return;
        }

        input.setAttribute('type', 'date');

        const tryOpenPicker = () => {
            if (typeof input.showPicker === 'function' && !input.disabled) {
                try {
                    input.showPicker();
                } catch (e) {
                    // Ignore browsers that deny programmatic picker opening.
                }
            }
        };

        input.addEventListener('focus', tryOpenPicker);
        input.addEventListener('click', tryOpenPicker);
    };

    const updatePreview = () => {
        const labels = [];
        dayInputs.forEach((input) => {
            if (input.checked && input.parentElement) {
                const text = input.parentElement.textContent ? input.parentElement.textContent.trim() : '';
                if (text) {
                    labels.push(text);
                }
            }
        });

        preview.textContent = labels.length > 0
            ? 'Jours sélectionnés: ' + labels.join(', ')
            : 'Aucun jour sélectionné';
    };

    const syncVisibility = () => {
        const enabled = Boolean(recurringToggle.checked);
        recurrenceBox.style.display = enabled ? '' : 'none';
        recurrenceBox.classList.toggle('is-open', enabled);
        recurrenceBox.setAttribute('aria-hidden', enabled ? 'false' : 'true');

        dayInputs.forEach((input) => {
            input.disabled = !enabled;
        });

        if (endDateInput) {
            endDateInput.disabled = !enabled;
        }
    };

    dayInputs.forEach((input) => input.addEventListener('change', updatePreview));
    recurringToggle.addEventListener('change', syncVisibility);
    recurringToggle.addEventListener('input', syncVisibility);
    recurringToggle.addEventListener('click', () => requestAnimationFrame(syncVisibility));
    setupDatePicker(startDateInput);
    setupDatePicker(endDateInput);

    syncVisibility();
    updatePreview();
})();
</script>

<script>
(() => {
    // Live prediction UI triggered manually by button
    const capaciteInput = document.getElementById('{{ form.capacite.vars.id }}');
    const dateInput = document.getElementById('{{ form.date_activite.vars.id }}');
    const nomInput = document.getElementById('{{ form.nom_activite.vars.id }}');
    const analyzeButton = document.getElementById('capacity-analyze-btn');
    const liveContainer = document.getElementById('live-prediction-container');

    if (!capaciteInput || !analyzeButton || !liveContainer) return;

    const getValues = () => {
        const capacite = parseInt(capaciteInput.value, 10) || 0;
        const nom = nomInput ? nomInput.value || '' : '';
        const dateVal = dateInput ? dateInput.value : '';
        let mois = 0, jour = 0;
        if (dateVal) {
            const d = new Date(dateVal);
            if (!isNaN(d.getTime())) {
                mois = d.getMonth() + 1;
                // dayofweek 0=Monday -> JS getDay 0=Sunday
                const jsDay = d.getDay();
                jour = jsDay === 0 ? 6 : jsDay - 1;
            }
        }
        // type inferred from first word
        const type = nom.trim().split(/\s+/)[0] ? nom.trim().split(/\s+/)[0].toLowerCase() : '';
        return { capacite, mois, jour, type };
    };

    const render = (data) => {
        liveContainer.innerHTML = '';
        if (!data) return;
        const pct = data.risque_pct !== undefined ? data.risque_pct : null;
        const niveau = data.niveau || '';
        const msg = data.message || '';
        const optimal = data.capacite_optimale !== undefined ? data.capacite_optimale : null;
        const optimalRisk = data.risque_optimale !== undefined ? data.risque_optimale : null;
        const historicalCapacity = data.capacite_historique_estimee !== undefined ? data.capacite_historique_estimee : null;
        const deviation = data.ecart_pourcent !== undefined ? data.ecart_pourcent : null;

        const html = document.createElement('div');
        html.className = 'alert alert-info mb-2';
        html.innerHTML = `<strong>Analyse IA</strong><br>${msg}`;
        liveContainer.appendChild(html);

        if (historicalCapacity !== null) {
            const demand = document.createElement('div');
            demand.className = 'small text-muted mb-1';
            demand.textContent = `Capacité de référence historique: ${historicalCapacity}${deviation !== null ? ` | Écart actuel: ${deviation}%` : ''}`;
            liveContainer.appendChild(demand);
        }

        if (optimal && optimal != getValues().capacite) {
            const sug = document.createElement('div');
            sug.className = 'small text-muted mt-1 d-flex align-items-center gap-2';
            sug.innerHTML = `Suggestion: capacité optimale ~ <strong>${optimal}</strong>${optimalRisk !== null ? ` (risque estimé ${optimalRisk}%)` : ''}`;

            const applyBtn = document.createElement('button');
            applyBtn.type = 'button';
            applyBtn.className = 'btn btn-sm btn-outline-primary';
            applyBtn.style.marginLeft = '0.5rem';
            applyBtn.textContent = 'Appliquer suggestion';
            applyBtn.addEventListener('click', () => {
                capaciteInput.value = optimal;
                analyzePrediction();
            });

            sug.appendChild(applyBtn);
            liveContainer.appendChild(sug);
        }
    };

    const analyzePrediction = () => {
        const v = getValues();
        if (!v.mois || !v.jour) {
            liveContainer.innerHTML = '<div class="alert alert-warning mb-0">Choisissez une date valide pour analyser le risque.</div>';
            return;
        }

        const params = new URLSearchParams({
            mois: v.mois,
            jour_semaine: v.jour,
            capacite: v.capacite || 1,
            type: v.type || ''
        });

        fetch('{{ path('app_activite_ecologique_predict_ajax') }}', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() })
            .then(res => res.json())
            .then(json => render(json))
            .catch(() => { liveContainer.innerHTML = '<div class="alert alert-danger mb-0">Analyse indisponible.</div>'; });
    };

    analyzeButton.addEventListener('click', analyzePrediction);
    if (dateInput) dateInput.addEventListener('change', () => { liveContainer.innerHTML = ''; });
    if (nomInput) nomInput.addEventListener('input', () => { liveContainer.innerHTML = ''; });
})();
</script>
