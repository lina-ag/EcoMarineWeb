{% extends 'base_admin.html.twig' %}

{% block page_title %}Activités écologiques{% endblock %}
{% block navbar_title %}Activités écologiques{% endblock %}

{% block admin_content %}
    <section class="glass-card table-card reservation-admin-shell reservation-admin-shell-list" style="background: linear-gradient(135deg, rgba(226, 239, 255, 0.6), rgba(209, 230, 255, 0.5)); backdrop-filter: blur(8px);">
        <div class="card-header">
            <div class="reservation-admin-header">
                <span class="reservation-admin-kicker">Activity Panel</span>
                <h2 class="card-title">Liste des activités écologiques</h2>
                <p class="card-subtitle">Suivi des activités enregistrées dans la plateforme.</p>
            </div>
            <div class="card-actions">
                <a href="{{ path('app_activite_ecologique_new') }}" class="btn btn-primary reservation-admin-cta">Créer une activité</a>
            </div>
        </div>

        <style>
            .search-icon-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.08rem;
                min-height: 1.42rem;
                padding: 0.12rem 0.2rem;
                border-radius: 999px;
                border: 1px solid rgba(148, 163, 184, 0.6);
                background: linear-gradient(135deg, rgba(251, 253, 254, 0.99), rgba(241, 245, 250, 0.96));
                color: #0b1f3a;
                box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1), inset 0 1px 2px rgba(255, 255, 255, 0.6);
                transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
                font-size: 0.56rem;
                font-weight: 700;
                letter-spacing: 0.3px;
                white-space: nowrap;
            }

            .search-icon-btn svg {
                width: 0.58rem;
                height: 0.58rem;
                transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            .search-icon-btn:hover,
            .search-icon-btn:focus-visible {
                background: linear-gradient(135deg, rgba(255, 255, 255, 1), rgba(229, 239, 250, 0.99));
                transform: translateY(-2px) scale(1.05);
                box-shadow: 0 6px 16px rgba(59, 130, 246, 0.25), inset 0 1px 2px rgba(255, 255, 255, 0.8);
                border-color: rgba(59, 130, 246, 0.4);
            }

            .search-icon-btn:hover svg,
            .search-icon-btn:focus-visible svg {
                transform: scale(1.15);
            }

            .quick-filter-btn {
                padding: 0.55rem 1.1rem;
                border-radius: 8px;
                border: 1px solid rgba(148, 163, 184, 0.35);
                background: linear-gradient(135deg, rgba(241, 245, 250, 0.85), rgba(226, 232, 240, 0.85));
                color: #1e293b;
                font-size: 0.82rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
                white-space: nowrap;
                box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.5);
            }

            .quick-filter-btn:hover {
                background: linear-gradient(135deg, rgba(219, 228, 240, 0.95), rgba(203, 213, 225, 0.95));
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.6);
                border-color: rgba(148, 163, 184, 0.5);
            }

            .quick-filter-btn.active {
                background: linear-gradient(135deg, rgba(59, 130, 246, 0.92), rgba(37, 99, 235, 0.92));
                color: #ffffff;
                border-color: rgba(37, 99, 235, 0.7);
                box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.3);
                font-weight: 700;
            }

            .quick-filter-btn.active:hover {
                background: linear-gradient(135deg, rgba(59, 130, 246, 1), rgba(37, 99, 235, 1));
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(59, 130, 246, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.3);
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.22rem 0.62rem;
                border-radius: 999px;
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.01em;
            }

            .status-badge-active {
                background: #dcfce7;
                color: #166534;
            }

            .status-badge-completed {
                background: #dbeafe;
                color: #1d4ed8;
            }

            .status-badge-cancelled {
                background: #fee2e2;
                color: #b91c1c;
            }

            .fill-rate-cell {
                min-width: 180px;
            }

            .fill-rate-track {
                height: 12px;
                border-radius: 999px;
                overflow: hidden;
                background: rgba(148, 163, 184, 0.25);
                border: 1px solid rgba(148, 163, 184, 0.35);
            }

            .fill-rate-bar {
                height: 100%;
                border-radius: 999px;
                transition: width 0.4s ease;
            }

            .fill-rate-good {
                background: linear-gradient(90deg, #22c55e, #16a34a);
            }

            .fill-rate-warning {
                background: linear-gradient(90deg, #f59e0b, #d97706);
            }

            .fill-rate-critical {
                background: linear-gradient(90deg, #ef4444, #b91c1c);
            }

            .fill-rate-value {
                font-size: 0.8rem;
                font-weight: 700;
                color: #1e3a8a;
                margin-top: 0.28rem;
            }

            .list-loading {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                font-size: 0.82rem;
                color: #1e3a8a;
                font-weight: 600;
            }

            .list-loading::before {
                content: '';
                width: 0.9rem;
                height: 0.9rem;
                border: 2px solid rgba(59, 130, 246, 0.22);
                border-top-color: #2563eb;
                border-radius: 50%;
                animation: spin 0.85s linear infinite;
            }

            .ux-empty-message {
                margin: 0.45rem 0 1rem;
                padding: 0.75rem 0.95rem;
                border-radius: 10px;
                border: 1px solid rgba(239, 68, 68, 0.22);
                background: rgba(254, 242, 242, 0.92);
                color: #991b1b;
                font-size: 0.9rem;
                font-weight: 600;
            }

            @keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }
        </style>

        <form id="activite-search-form" style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 1.1rem; padding: 1rem; background: linear-gradient(135deg, rgba(251, 253, 254, 0.5), rgba(241, 245, 250, 0.3)); border-radius: 12px; border: 1px solid rgba(203, 213, 225, 0.4); box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);" onsubmit="return false;">
            <!-- Ligne 1: Chercher par + Recherche -->
            <div style="display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;">
                <select id="activite-search-field" class="search-input" style="max-width: 150px;">
                    <option value="all">Chercher par: Tous</option>
                    <option value="id">ID</option>
                    <option value="nom">Nom</option>
                    <option value="date">Date</option>
                    <option value="capacite">Capacite</option>
                    <option value="description">Description</option>
                </select>
                <div style="display: flex; align-items: center; gap: 0.08rem; flex: 1; min-width: 260px;">
                    <div class="search-box" style="max-width: 100%; flex: 1; margin: 0;">
                        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <input
                            id="activite-search-input"
                            type="text"
                            name="q"
                            class="search-input"
                            value="{{ search_term|default('') }}"
                            placeholder="Rechercher (commence par)..."
                            autocomplete="off"
                        >
                    </div>
                    <button id="activite-search-btn" type="button" class="btn btn-secondary search-icon-btn" aria-label="Rechercher" title="Rechercher">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <span>Rech.</span>
                    </button>
                </div>
                <small id="activite-result-count" style="opacity: 0.8; white-space: nowrap;">{{ activite_ecologiques|length }} resultat(s)</small>
                <span id="activite-loading" class="list-loading" style="display: none;" aria-live="polite">Chargement...</span>
            </div>

            <!-- Ligne 2: Filtres rapides -->
            <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap; padding-top: 0.5rem; border-top: 1px solid rgba(203, 213, 225, 0.3);">
                <button type="button" class="quick-filter-btn" data-filter="periode" data-value="all" style="margin-right: 0.5rem;" title="Afficher toutes les activités">Tous</button>
                <button type="button" class="quick-filter-btn" data-filter="periode" data-value="today" title="Filtrer les activités du jour">Aujourd'hui</button>
                <button type="button" class="quick-filter-btn" data-filter="periode" data-value="week" title="Filtrer les activités de cette semaine">Cette semaine</button>
                <button type="button" class="quick-filter-btn" data-filter="periode" data-value="current" title="Filtrer les activités de ce mois">Ce mois</button>
                <button type="button" class="quick-filter-btn" data-filter="capacite" data-value="medium-large" title="Afficher les activités avec capacité supérieure à 10">Capacité > 10</button>
                <select id="activite-sort-by" class="search-input" style="max-width: 150px; margin-left: auto;">
                    <option value="date_desc">Tri: Date recentes</option>
                    <option value="date_asc">Tri: Date anciennes</option>
                    <option value="id_desc">Tri: ID decroissant</option>
                    <option value="id_asc">Tri: ID croissant</option>
                    <option value="nom_asc">Tri: Nom A-Z</option>
                    <option value="nom_desc">Tri: Nom Z-A</option>
                    <option value="capacite_desc">Tri: Capacite max</option>
                    <option value="capacite_asc">Tri: Capacite min</option>
                </select>
            </div>
        </form>

        <div id="activite-empty-message" class="ux-empty-message" style="display: none;">Aucun résultat ne correspond à vos filtres.</div>

        <div class="table-wrapper reservation-admin-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Id activité</th>
                        <th>Nom activité</th>
                        <th>Date activité</th>
                        <th>Capacité</th>
                        <th>Taux remplissage</th>
                        <th>Description</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for activite_ecologique in activite_ecologiques %}
                    {% set activiteStatus = activite_ecologique.dateActivite and activite_ecologique.dateActivite|date('Y-m-d') < "now"|date('Y-m-d') ? 'completed' : 'active' %}
                    {% set booked = 0 %}
                    {% for reservation in activite_ecologique.reservations %}
                        {% set booked = booked + reservation.nombrePersonnes|default(0) %}
                    {% endfor %}
                    {% set capacity = activite_ecologique.capacite|default(0) %}
                    {% set rate = capacity > 0 ? (booked / capacity * 100) : 0 %}
                    {% set rateCapped = rate > 100 ? 100 : rate %}
                    {% set tone = rate >= 90 ? 'critical' : (rate >= 60 ? 'warning' : 'good') %}
                    <tr
                        class="reservation-admin-row"
                        style="--reservation-row-index: {{ loop.index0 }};"
                        data-search-id="{{ activite_ecologique.idActivite|e('html_attr') }}"
                        data-search-nom="{{ activite_ecologique.nomActivite|default('')|e('html_attr') }}"
                        data-search-date="{{ (activite_ecologique.dateActivite ? activite_ecologique.dateActivite|date('Y-m-d') : '')|e('html_attr') }}"
                        data-search-capacite="{{ activite_ecologique.capacite|e('html_attr') }}"
                        data-search-description="{{ activite_ecologique.description|default('')|e('html_attr') }}"
                        data-search-periode="{{ activite_ecologique.dateActivite ? (activite_ecologique.dateActivite|date('Y-m-d') < "now"|date('Y-m-d') ? 'past' : (activite_ecologique.dateActivite|date('Y-m') == "now"|date('Y-m') ? 'current' : 'future')) : 'unknown' }}"
                        data-search-status="{{ activiteStatus }}"
                        data-search-values="{{ [
                            activite_ecologique.idActivite,
                            activite_ecologique.nomActivite,
                            activite_ecologique.dateActivite ? activite_ecologique.dateActivite|date('Y-m-d') : '',
                            activite_ecologique.capacite,
                            activite_ecologique.description
                        ]|join('|')|lower|e('html_attr') }}"
                    >
                        <td>{{ activite_ecologique.idActivite }}</td>
                        <td>{{ activite_ecologique.nomActivite }}</td>
                        <td>{{ activite_ecologique.dateActivite ? activite_ecologique.dateActivite|date('Y-m-d') : '' }}</td>
                        <td>{{ activite_ecologique.capacite }}</td>
                        <td class="fill-rate-cell">
                            <div class="fill-rate-track" title="{{ booked }}/{{ capacity }} places réservées">
                                <div class="fill-rate-bar fill-rate-{{ tone }}" style="width: {{ rateCapped }}%;"></div>
                            </div>
                            <div class="fill-rate-value">{{ booked }}/{{ capacity }}</div>
                        </td>
                        <td>{{ activite_ecologique.description }}</td>
                        <td>
                            {% if activiteStatus == 'active' %}
                                <span class="status-badge status-badge-active">Active</span>
                            {% elseif activiteStatus == 'completed' %}
                                <span class="status-badge status-badge-completed">Complète</span>
                            {% else %}
                                <span class="status-badge status-badge-cancelled">Annulée</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="reservation-admin-actions">
                                <a href="{{ path('app_activite_ecologique_show', {'id_activite': activite_ecologique.id_activite}) }}" class="btn btn-secondary reservation-admin-action-btn" title="Voir l'activité">Voir</a>
                                <a href="{{ path('app_activite_ecologique_edit', {'id_activite': activite_ecologique.id_activite}) }}" class="btn btn-primary reservation-admin-action-btn" title="Modifier l'activité">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                    <tr id="activite-no-match-row" style="display: none;">
                        <td colspan="8">Aucun resultat pour cette recherche</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}

{% block admin_javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const form = document.getElementById('activite-search-form');
            const input = document.getElementById('activite-search-input');
            const fieldSelect = document.getElementById('activite-search-field');
            const sortSelect = document.getElementById('activite-sort-by');
            const searchButton = document.getElementById('activite-search-btn');
            const resultCount = document.getElementById('activite-result-count');
            const loadingIndicator = document.getElementById('activite-loading');
            const emptyMessage = document.getElementById('activite-empty-message');
            const tableBody = document.querySelector('.data-table tbody');
            const rows = Array.from(document.querySelectorAll('.reservation-admin-row'));
            const noMatchRow = document.getElementById('activite-no-match-row');
            const quickFilterButtons = Array.from(document.querySelectorAll('.quick-filter-btn'));

            if (!form || !input || !fieldSelect || !sortSelect || !searchButton || !resultCount || !tableBody) {
                return;
            }

            let currentCapaciteFilter = 'all';
            let currentPeriodeFilter = 'all';
            let loadingTimer = null;

            const normalize = function (value) {
                return (value || '')
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .trim();
            };

            const updateResultCount = function (count) {
                resultCount.textContent = count + ' resultat(s)';
            };

            const setLoading = function (isLoading) {
                if (!loadingIndicator) {
                    return;
                }

                loadingIndicator.style.display = isLoading ? 'inline-flex' : 'none';
            };

            const toNumber = function (value) {
                const parsed = Number.parseInt(value || '0', 10);
                return Number.isNaN(parsed) ? 0 : parsed;
            };

            const toDateValue = function (value) {
                const timestamp = Date.parse(value || '');
                return Number.isNaN(timestamp) ? 0 : timestamp;
            };

            const compareValues = function (a, b, mode) {
                if (mode === 'id_asc') {
                    return toNumber(a.dataset.searchId) - toNumber(b.dataset.searchId);
                }
                if (mode === 'id_desc') {
                    return toNumber(b.dataset.searchId) - toNumber(a.dataset.searchId);
                }
                if (mode === 'nom_asc') {
                    return normalize(a.dataset.searchNom).localeCompare(normalize(b.dataset.searchNom));
                }
                if (mode === 'nom_desc') {
                    return normalize(b.dataset.searchNom).localeCompare(normalize(a.dataset.searchNom));
                }
                if (mode === 'date_asc') {
                    return toDateValue(a.dataset.searchDate) - toDateValue(b.dataset.searchDate);
                }
                if (mode === 'capacite_asc') {
                    return toNumber(a.dataset.searchCapacite) - toNumber(b.dataset.searchCapacite);
                }
                if (mode === 'capacite_desc') {
                    return toNumber(b.dataset.searchCapacite) - toNumber(a.dataset.searchCapacite);
                }

                return toDateValue(b.dataset.searchDate) - toDateValue(a.dataset.searchDate);
            };

            const capacityMatches = function (rowCapacity, filterValue) {
                const capacity = toNumber(rowCapacity);
                if (filterValue === 'small') {
                    return capacity <= 20;
                }
                if (filterValue === 'medium') {
                    return capacity >= 21 && capacity <= 50;
                }
                if (filterValue === 'large') {
                    return capacity >= 51;
                }
                if (filterValue === 'medium-large') {
                    return capacity >= 10;
                }

                return true;
            };

            const periodeMatches = function (rowDateStr, filterValue) {
                if (filterValue === 'all') return true;
                
                if (!rowDateStr) return false;
                
                const rowDate = new Date(rowDateStr);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                
                if (filterValue === 'today') {
                    const rowDateOnly = new Date(rowDate);
                    rowDateOnly.setHours(0, 0, 0, 0);
                    return rowDateOnly.getTime() === today.getTime();
                }
                
                if (filterValue === 'week') {
                    const dayOfWeek = today.getDay();
                    const startOfWeek = new Date(today);
                    startOfWeek.setDate(today.getDate() - dayOfWeek);
                    startOfWeek.setHours(0, 0, 0, 0);
                    
                    const endOfWeek = new Date(startOfWeek);
                    endOfWeek.setDate(startOfWeek.getDate() + 6);
                    endOfWeek.setHours(23, 59, 59, 999);
                    
                    const rowDateOnly = new Date(rowDate);
                    rowDateOnly.setHours(0, 0, 0, 0);
                    
                    return rowDateOnly >= startOfWeek && rowDateOnly <= endOfWeek;
                }
                
                if (filterValue === 'current') {
                    return rowDate.getFullYear() === today.getFullYear() && 
                           rowDate.getMonth() === today.getMonth();
                }
                
                return false;
            };

            const runFilter = function () {
                const query = normalize(input.value);
                const tokens = query.length === 0 ? [] : query.split(/\s+/).filter(Boolean);
                const selectedField = fieldSelect.value;
                const selectedSort = sortSelect.value;
                let visibleCount = 0;

                const fieldKeyMap = {
                    id: 'searchId',
                    nom: 'searchNom',
                    date: 'searchDate',
                    capacite: 'searchCapacite',
                    description: 'searchDescription'
                };

                const visibleRows = [];

                rows.forEach(function (row) {
                    let searchableParts = [];

                    if (selectedField === 'all') {
                        const dataValue = normalize(row.getAttribute('data-search-values'));
                        searchableParts = dataValue.split('|').map(function (part) { return part.trim(); }).filter(Boolean);
                    } else {
                        const datasetKey = fieldKeyMap[selectedField];
                        const singleValue = normalize(datasetKey ? row.dataset[datasetKey] : '');
                        searchableParts = singleValue ? [singleValue] : [];
                    }

                    const matchesQuery = tokens.every(function (token) {
                        return searchableParts.some(function (part) {
                            return part.startsWith(token);
                        });
                    });

                    const capacityValue = toNumber(row.dataset.searchCapacite);
                    const matchesCapacity = capacityMatches(capacityValue, currentCapaciteFilter);
                    const matchesPeriode = periodeMatches(row.dataset.searchDate, currentPeriodeFilter);
                    const isVisible = (tokens.length === 0 || matchesQuery) && matchesCapacity && matchesPeriode;

                    row.style.display = isVisible ? '' : 'none';

                    if (isVisible) {
                        visibleRows.push(row);
                        visibleCount += 1;
                    }
                });

                visibleRows.sort(function (a, b) {
                    return compareValues(a, b, selectedSort);
                });

                visibleRows.forEach(function (row) {
                    tableBody.appendChild(row);
                });

                if (noMatchRow) {
                    tableBody.appendChild(noMatchRow);
                    noMatchRow.style.display = visibleCount === 0 ? '' : 'none';
                }

                if (emptyMessage) {
                    emptyMessage.style.display = visibleCount === 0 ? '' : 'none';
                }

                updateResultCount(visibleCount);
            };

            const applyFilter = function () {
                setLoading(true);

                if (loadingTimer) {
                    window.clearTimeout(loadingTimer);
                }

                loadingTimer = window.setTimeout(function () {
                    runFilter();
                    setLoading(false);
                }, 140);
            };

            // Handle quick filter buttons
            quickFilterButtons.forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const filterType = btn.dataset.filter;
                    const filterValue = btn.dataset.value;

                    if (filterType === 'capacite') {
                        currentCapaciteFilter = filterValue;
                    } else if (filterType === 'periode') {
                        currentPeriodeFilter = filterValue;
                    }

                    // Update active state for buttons in the same filter group
                    quickFilterButtons.forEach(function (b) {
                        if (b.dataset.filter === filterType) {
                            b.classList.toggle('active', b.dataset.value === filterValue);
                        }
                    });

                    applyFilter();
                });
            });

            // Initialize active buttons
            quickFilterButtons.forEach(function (btn) {
                if ((btn.dataset.filter === 'capacite' && btn.dataset.value === 'all') ||
                    (btn.dataset.filter === 'periode' && btn.dataset.value === 'all')) {
                    btn.classList.add('active');
                }
            });

            input.addEventListener('input', function () {
                applyFilter();
            });

            fieldSelect.addEventListener('change', function () {
                applyFilter();
            });

            sortSelect.addEventListener('change', function () {
                applyFilter();
            });

            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applyFilter();
                }
            });

            searchButton.addEventListener('click', function () {
                applyFilter();
            });

            applyFilter();
        })();
    </script>
{% endblock %}
