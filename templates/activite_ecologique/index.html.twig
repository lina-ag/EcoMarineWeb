{% extends 'base_admin.html.twig' %}

{% block page_title %}{{ 'activite.title'|trans }}{% endblock %}
{% block navbar_title %}{{ 'activite.title'|trans }}{% endblock %}

{% block admin_content %}
    <section class="glass-card table-card reservation-admin-shell reservation-admin-shell-list" style="background: linear-gradient(135deg, rgba(226, 239, 255, 0.6), rgba(209, 230, 255, 0.5)); backdrop-filter: blur(8px);">
        <div class="card-header">
            <div class="reservation-admin-header">
                <span class="reservation-admin-kicker">{{ 'activite.panel'|trans }}</span>
                <h2 class="card-title">{{ 'activite.list_title'|trans }}</h2>
                <p class="card-subtitle">{{ 'activite.subtitle'|trans }}</p>
            </div>
            <div class="card-actions">
                {% set target_locale = app.request.locale == 'fr' ? 'en' : 'fr' %}
                <button 
                    class="btn btn-secondary reservation-admin-cta" 
                    title="{{ 'common.switch_language'|trans }}"
                    data-controller="language-switcher"
                    data-language-switcher-url-value="{{ path('app_change_locale', {'locale': target_locale}) }}"
                    data-action="click->language-switcher#switch"
                    style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255, 255, 255, 0.3); backdrop-filter: blur(4px);"
                >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    <span>{{ (app.request.locale == 'fr' ? 'EN' : 'FR') }}</span>
                </button>
                <a href="{{ path('app_activite_ecologique_export_pdf') }}" class="btn btn-secondary reservation-admin-cta">{{ 'activite.export_pdf'|trans }}</a>
                <a href="{{ path('app_activite_ecologique_new') }}" class="btn btn-primary reservation-admin-cta">{{ 'activite.create'|trans }}</a>
            </div>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <div class="card weather-widget shadow-sm border-0">
                <div class="card-body py-3 px-3">
                    {% if weather.error is defined %}
                        <div class="d-flex align-items-center gap-3">
                            <div class="weather-widget-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M12 8v5"/>
                                    <path d="M12 16h.01"/>
                                </svg>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Weather</div>
                                <div class="small text-muted">{{ weather.error }}</div>
                            </div>
                        </div>
                    {% else %}
                        {% set condition = weather.condition ?? 'unknown' %}
                        <div class="d-flex align-items-center gap-3">
                            <div class="weather-widget-icon">
                                {% if condition == 'clear' %}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="4"/>
                                        <path d="M12 2v2"/><path d="M12 20v2"/>
                                        <path d="M4.93 4.93l1.41 1.41"/><path d="M17.66 17.66l1.41 1.41"/>
                                        <path d="M2 12h2"/><path d="M20 12h2"/>
                                        <path d="M6.34 17.66l-1.41 1.41"/><path d="M19.07 4.93l-1.41 1.41"/>
                                    </svg>
                                {% elseif condition == 'partly_cloudy' %}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2v2"/><path d="M4.93 4.93l1.41 1.41"/><path d="M2 12h2"/>
                                        <circle cx="12" cy="12" r="3"/>
                                        <path d="M19 18a4.5 4.5 0 0 0-1.2-8.8 5.5 5.5 0 0 0-10.6 1.7A3.8 3.8 0 0 0 7.5 18H19z"/>
                                    </svg>
                                {% elseif condition == 'cloudy' %}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 18a4.5 4.5 0 0 0-1.2-8.8 5.5 5.5 0 0 0-10.6 1.7A3.8 3.8 0 0 0 7.5 18H19z"/>
                                    </svg>
                                {% else %}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 2-2.5 2-2.5 4"/>
                                        <path d="M12 17h.01"/>
                                    </svg>
                                {% endif %}
                            </div>

                            <div class="flex-grow-1">
                                <div class="fw-semibold">Weather in {{ weather.city ?? 'Monastir' }}</div>
                                <div class="small text-muted">
                                    {% if condition == 'clear' %}Clear{% elseif condition == 'partly_cloudy' %}Partly cloudy{% elseif condition == 'cloudy' %}Cloudy{% else %}Unknown{% endif %}
                                </div>
                            </div>

                            <div class="text-end">
                                <div class="h5 mb-0">{{ (weather.temp is defined and weather.temp is not null) ? weather.temp : '—' }}°C</div>
                                <div class="small text-muted">Humidity: {{ (weather.humidity is defined and weather.humidity is not null) ? weather.humidity : '—' }}%</div>
                                <div class="small text-muted">Wind: {{ (weather.wind_speed is defined and weather.wind_speed is not null) ? (weather.wind_speed|number_format(1, '.', '')) : '—' }} m/s</div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <style>
            .weather-widget {
                min-width: 280px;
                max-width: 420px;
                background: rgba(255, 255, 255, 0.85);
                border: 1px solid rgba(148, 163, 184, 0.35);
                backdrop-filter: blur(8px);
            }

            .weather-widget-icon {
                width: 3rem;
                height: 3rem;
                border-radius: 16px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, rgba(59, 130, 246, 0.14), rgba(14, 165, 233, 0.18));
                color: #1d4ed8;
                box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.9), 0 6px 16px rgba(59, 130, 246, 0.12);
            }

            .weather-widget-icon svg {
                width: 1.65rem;
                height: 1.65rem;
            }

            .dna-cell-link {
                display: block;
                text-decoration: none;
                color: inherit;
            }

            .dna-badge-card {
                --dna-bg-start: #dbeafe;
                --dna-bg-end: #c4b5fd;
                --dna-accent: #4338ca;
                --dna-glow: rgba(99, 102, 241, 0.28);
                display: flex;
                flex-direction: column;
                gap: 0.45rem;
                min-width: 180px;
                padding: 0.8rem 0.9rem 0.72rem;
                border-radius: 18px;
                border: 1px solid rgba(255, 255, 255, 0.5);
                background: linear-gradient(135deg, var(--dna-bg-start), var(--dna-bg-end));
                box-shadow: 0 10px 22px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(255, 255, 255, 0.3) inset, 0 0 24px var(--dna-glow);
                backdrop-filter: blur(10px);
                transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
            }

            .dna-cell-link:hover .dna-badge-card,
            .dna-cell-link:focus-visible .dna-badge-card {
                transform: translateY(-2px) scale(1.01);
                box-shadow: 0 14px 28px rgba(15, 23, 42, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.35) inset, 0 0 28px var(--dna-glow);
                filter: saturate(1.05);
            }

            .dna-badge-card--hot {
                --dna-bg-start: #ffedd5;
                --dna-bg-end: #fb7185;
                --dna-accent: #dc2626;
                --dna-glow: rgba(248, 113, 113, 0.4);
            }

            .dna-badge-card--neutral {
                --dna-bg-start: #ede9fe;
                --dna-bg-end: #8b5cf6;
                --dna-accent: #5b21b6;
                --dna-glow: rgba(139, 92, 246, 0.34);
            }

            .dna-badge-card--ice {
                --dna-bg-start: #e0f2fe;
                --dna-bg-end: #67e8f9;
                --dna-accent: #0f766e;
                --dna-glow: rgba(34, 211, 238, 0.32);
            }

            .dna-badge-head {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 0.65rem;
            }

            .dna-badge-copy {
                min-width: 0;
            }

            .dna-badge-kicker {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                font-size: 0.68rem;
                font-weight: 800;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: rgba(15, 23, 42, 0.72);
                margin-bottom: 0.15rem;
            }

            .dna-badge-title {
                display: block;
                font-size: 0.98rem;
                font-weight: 800;
                line-height: 1.1;
                color: #0f172a;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .dna-badge-icon {
                flex: 0 0 auto;
                width: 2.2rem;
                height: 2.2rem;
                border-radius: 999px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.34);
                color: var(--dna-accent);
                box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.85);
                animation: dnaPulse 1.8s ease-in-out infinite;
            }

            .dna-badge-icon svg {
                width: 1.05rem;
                height: 1.05rem;
                stroke-width: 2.2;
            }

            .dna-badge-meter {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
            }

            .dna-badge-track {
                position: relative;
                height: 0.52rem;
                border-radius: 999px;
                overflow: hidden;
                background: rgba(255, 255, 255, 0.36);
                box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.16);
            }

            .dna-badge-fill {
                height: 100%;
                border-radius: inherit;
                background: linear-gradient(90deg, rgba(255, 255, 255, 0.35), var(--dna-accent));
                box-shadow: 0 0 12px rgba(255, 255, 255, 0.3);
                transition: width 0.28s ease;
            }

            .dna-badge-meta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
                font-size: 0.74rem;
                font-weight: 700;
                color: rgba(15, 23, 42, 0.78);
            }

            .dna-badge-meta strong {
                color: #0f172a;
            }

            .dna-badge-empty {
                font-size: 0.74rem;
                font-weight: 700;
                color: rgba(15, 23, 42, 0.74);
            }

            .dna-tooltip .tooltip-inner {
                max-width: 320px;
                padding: 0.7rem 0.85rem;
                border-radius: 14px;
                background: rgba(15, 23, 42, 0.96);
                box-shadow: 0 14px 30px rgba(15, 23, 42, 0.28);
                text-align: left;
                font-size: 0.82rem;
                line-height: 1.45;
            }

            .dna-tooltip .tooltip-arrow::before {
                border-top-color: rgba(15, 23, 42, 0.96);
            }

            @keyframes dnaPulse {
                0%, 100% {
                    transform: scale(1);
                    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.85), 0 0 0 rgba(255, 255, 255, 0);
                }
                50% {
                    transform: scale(1.08);
                    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.95), 0 0 14px rgba(255, 255, 255, 0.55);
                }
            }

            .activity-search-row {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                flex-wrap: wrap;
            }

            .admin-live-form {
                margin-bottom: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 1.1rem;
                padding: 1.1rem;
                border-radius: 20px;
                border: 1px solid rgba(191, 219, 254, 0.55);
                background: linear-gradient(135deg, rgba(251, 253, 254, 0.52), rgba(239, 246, 255, 0.34));
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06), inset 0 1px 1px rgba(255, 255, 255, 0.7);
                backdrop-filter: blur(10px);
            }

            .admin-live-form-row {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                flex-wrap: wrap;
            }

            .admin-live-form-row--split {
                padding-top: 0.5rem;
                border-top: 1px solid rgba(203, 213, 225, 0.3);
            }

            .admin-live-search-main {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                flex: 1;
                min-width: 260px;
            }

            .admin-field-select {
                max-width: 170px;
                min-width: 170px;
            }

            .admin-sort-select {
                max-width: 190px;
                margin-left: auto;
            }

            .admin-result-count {
                opacity: 0.82;
                white-space: nowrap;
                font-weight: 700;
                color: #334155;
            }

            /* Zonep-like search bar */
            #activite-search-form .search-box {
                position: relative;
                display: flex;
                align-items: center;
                flex: 1;
                min-width: 260px;
            }

            #activite-search-form .search-box:focus-within {
                transform: none;
            }

            #activite-search-form .search-box .search-icon {
                display: none;
            }

            #activite-search-form .search-box .search-input {
                min-width: 0;
                width: 100%;
                padding: 12px 48px 12px 18px;
                border-radius: 12px;
                border: 1px solid var(--glass-border, #e0e0e0);
                background: var(--glass-bg, #fff);
                color: var(--text-primary, #222);
                font-size: 15px;
                font-weight: 500;
                box-shadow: 0 2px 8px rgba(56, 189, 248, 0.04);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

            #activite-search-form .search-box .search-input:focus {
                border-color: var(--emerald-light, #38bdf8);
                box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.15);
            }

            #activite-search-form .search-input {
                padding: 12px 18px;
                border-radius: 12px;
                border: 1px solid var(--glass-border, #e0e0e0);
                background: var(--glass-bg, #fff);
                color: var(--text-primary, #222);
                font-size: 15px;
                box-shadow: 0 2px 8px rgba(56, 189, 248, 0.04);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

            #activite-search-form .search-input:focus {
                border-color: var(--emerald-light, #38bdf8);
                box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.15);
            }

            .search-box .search-input::placeholder {
                color: rgba(71, 85, 105, 0.78);
            }

            .search-icon-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.4rem;
                min-height: 3.25rem;
                padding: 0 1.2rem;
                border-radius: 18px;
                border: 1px solid rgba(59, 130, 246, 0.22);
                background: linear-gradient(135deg, #1d4ed8, #0f766e);
                color: #ffffff;
                box-shadow: 0 12px 24px rgba(29, 78, 216, 0.24), inset 0 1px 1px rgba(255, 255, 255, 0.22);
                transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
                font-size: 0.9rem;
                font-weight: 700;
                letter-spacing: 0.02em;
                white-space: nowrap;
            }

            .search-icon-btn svg {
                width: 1rem;
                height: 1rem;
                transition: transform 0.2s ease;
            }

            .search-icon-btn:hover,
            .search-icon-btn:focus-visible {
                transform: translateY(-2px);
                box-shadow: 0 16px 28px rgba(29, 78, 216, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.22);
                filter: brightness(1.03);
            }

            .search-icon-btn:hover svg,
            .search-icon-btn:focus-visible svg {
                transform: scale(1.08);
            }

            .search-icon-btn:focus-visible {
                outline: 3px solid rgba(96, 165, 250, 0.35);
                outline-offset: 2px;
            }

            .voice-btn {
                position: absolute;
                right: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                border: none;
                background: transparent;
                color: #94a3b8;
                cursor: pointer;
                transition: color 0.2s, background 0.2s;
                flex-shrink: 0;
            }

            .voice-btn:hover {
                background: rgba(56, 189, 248, 0.1);
                color: #38bdf8;
            }

            .voice-btn--active {
                color: #f87171;
                background: rgba(248, 113, 113, 0.12);
                animation: voice-pulse 1.2s ease-in-out infinite;
            }

            .voice-btn svg {
                width: 16px;
                height: 16px;
            }

            .voice-toast {
                position: fixed;
                left: 50%;
                bottom: 24px;
                transform: translateX(-50%) translateY(20px);
                padding: 0.85rem 1.1rem;
                border-radius: 14px;
                background: rgba(15, 23, 42, 0.92);
                color: #fff;
                font-size: 0.92rem;
                font-weight: 600;
                box-shadow: 0 18px 34px rgba(15, 23, 42, 0.22);
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.24s ease, transform 0.24s ease;
                z-index: 1300;
            }

            .voice-toast--visible {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

            .voice-toast--success {
                background: rgba(5, 150, 105, 0.95);
            }

            .voice-toast--error {
                background: rgba(220, 38, 38, 0.95);
            }

            .voice-toast--info {
                background: rgba(15, 23, 42, 0.92);
            }

            @keyframes voice-pulse {
                0%, 100% {
                    transform: scale(1);
                    box-shadow: 0 0 0 0 rgba(248, 113, 113, 0.24);
                }
                50% {
                    transform: scale(1.04);
                    box-shadow: 0 0 0 8px rgba(248, 113, 113, 0);
                }
            }

            .search-input {
                min-height: 3.25rem;
                padding: 0 0.95rem;
                border-radius: 18px;
                border: 1px solid rgba(191, 219, 254, 0.9);
                background: rgba(255, 255, 255, 0.92);
                color: #0f172a;
                box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
                font-weight: 600;
            }

            .search-input:focus {
                border-color: rgba(59, 130, 246, 0.55);
                box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.18);
            }

            .quick-filter-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.55rem 1.1rem;
                border-radius: 8px;
                border: 1px solid rgba(148, 163, 184, 0.35);
                background: linear-gradient(135deg, rgba(241, 245, 250, 0.85), rgba(226, 232, 240, 0.85));
                color: #1e293b;
                font-size: 0.82rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
                white-space: nowrap;
                box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.5);
            }

            .quick-filter-btn:hover,
            .quick-filter-btn:focus-visible {
                background: linear-gradient(135deg, rgba(219, 228, 240, 0.95), rgba(203, 213, 225, 0.95));
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.6);
                border-color: rgba(148, 163, 184, 0.5);
            }

            .quick-filter-btn.active {
                background: linear-gradient(135deg, rgba(59, 130, 246, 0.92), rgba(37, 99, 235, 0.92));
                color: #ffffff;
                border-color: rgba(37, 99, 235, 0.7);
                box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.3);
                font-weight: 700;
            }

            .quick-filter-btn.active:hover {
                background: linear-gradient(135deg, rgba(59, 130, 246, 1), rgba(37, 99, 235, 1));
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(59, 130, 246, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.3);
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.22rem 0.62rem;
                border-radius: 999px;
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.01em;
            }

            .status-badge-active {
                background: #dcfce7;
                color: #166534;
            }

            .status-badge-completed {
                background: #dbeafe;
                color: #1d4ed8;
            }

            .status-badge-cancelled {
                background: #fee2e2;
                color: #b91c1c;
            }

            .fill-rate-cell {
                min-width: 180px;
            }

            .fill-rate-track {
                height: 12px;
                border-radius: 999px;
                overflow: hidden;
                background: rgba(148, 163, 184, 0.25);
                border: 1px solid rgba(148, 163, 184, 0.35);
            }

            .fill-rate-bar {
                height: 100%;
                border-radius: 999px;
                transition: width 0.4s ease;
            }

            .fill-rate-good {
                background: linear-gradient(90deg, #22c55e, #16a34a);
            }

            .fill-rate-warning {
                background: linear-gradient(90deg, #f59e0b, #d97706);
            }

            .fill-rate-critical {
                background: linear-gradient(90deg, #ef4444, #b91c1c);
            }

            .fill-rate-value {
                font-size: 0.8rem;
                font-weight: 700;
                color: #1e3a8a;
                margin-top: 0.28rem;
            }

            .list-loading {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                font-size: 0.82rem;
                color: #1e3a8a;
                font-weight: 600;
            }

            .list-loading::before {
                content: '';
                width: 0.9rem;
                height: 0.9rem;
                border: 2px solid rgba(59, 130, 246, 0.22);
                border-top-color: #2563eb;
                border-radius: 50%;
                animation: spin 0.85s linear infinite;
            }

            .ux-empty-message {
                margin: 0.45rem 0 1rem;
                padding: 0.75rem 0.95rem;
                border-radius: 10px;
