{% block admin_javascripts %}
    {{ parent() }}
    <script>
        (function initActivityDnaTooltips() {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');

            if (!tooltipTriggerList.length || !window.bootstrap || !window.bootstrap.Tooltip) {
                return;
            }

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                if (tooltipTriggerEl.dataset.dnaTooltipInitialized === '1') {
                    return;
                }

                tooltipTriggerEl.dataset.dnaTooltipInitialized = '1';
                new window.bootstrap.Tooltip(tooltipTriggerEl, {
                    html: true,
                    trigger: 'hover focus',
                    customClass: 'dna-tooltip'
                });
            });
        })();

        (function initActiviteLiveSearch() {
            const root = document.getElementById('activite-live-root');

            if (!root) {
                return;
            }

            const form = root.querySelector('#activite-search-form');

            if (!form) {
                return;
            }

            const voiceBtn = form.querySelector('#activite-voice-btn');
            const voiceInput = form.querySelector('input[name="q"]');
            const voiceToast = document.getElementById('activite-voice-toast');
            const SpeechRecognition =
                window.SpeechRecognition || window.webkitSpeechRecognition;

            if (voiceBtn && voiceInput && voiceToast) {
                if (!SpeechRecognition) {
                    voiceBtn.style.display = 'none';
                } else {
                    const recognition = new SpeechRecognition();
                    recognition.lang = 'fr-FR';
                    recognition.continuous = false;
                    recognition.interimResults = true;
                    recognition.maxAlternatives = 1;

                    let isListening = false;
                    let toastTimer = null;

                    const micSVG = `<svg id="activite-voice-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>`;

                    const stopSVG = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <rect x="4" y="4" width="16" height="16" rx="3"/>
                        </svg>`;

                    const showToast = function (message, type) {
                        window.clearTimeout(toastTimer);
                        voiceToast.textContent = message;
                        voiceToast.className = 'voice-toast voice-toast--' + type + ' voice-toast--visible';
                        toastTimer = window.setTimeout(function () {
                            voiceToast.classList.remove('voice-toast--visible');
                        }, 2800);
                    };

                    const startListening = function () {
                        isListening = true;
                        voiceBtn.classList.add('voice-btn--active');
                        voiceBtn.innerHTML = stopSVG;
                        voiceBtn.setAttribute('aria-label', 'Arrêter la recherche vocale');
                        showToast('🎙 Parlez maintenant…', 'info');
                        recognition.start();
                    };

                    const stopListening = function () {
                        isListening = false;
                        voiceBtn.classList.remove('voice-btn--active');
                        voiceBtn.innerHTML = micSVG;
                        voiceBtn.setAttribute('aria-label', 'Démarrer la recherche vocale');
                        recognition.stop();
                    };

                    voiceBtn.addEventListener('click', function () {
                        if (isListening) {
                            stopListening();
                        } else {
                            startListening();
                        }
                    });

                    recognition.addEventListener('result', function (event) {
                        const transcript = Array.from(event.results)
                            .map(function (result) {
                                return result[0].transcript;
                            })
                            .join('');

                        voiceInput.value = transcript;

                        if (event.results[0].isFinal) {
                            showToast('Recherche : « ' + transcript + ' »', 'success');
                            form.requestSubmit();
                        }
                    });

                    recognition.addEventListener('end', function () {
                        if (isListening) {
                            stopListening();
                        }
                    });

                    recognition.addEventListener('error', function (event) {
                        stopListening();

                        const messages = {
                            'not-allowed': 'Microphone non autorisé. Vérifiez les permissions.',
                            'no-speech': 'Aucune voix détectée. Réessayez.',
                            'audio-capture': 'Impossible d\'accéder au microphone.',
                            'network': 'Erreur réseau lors de la reconnaissance vocale.'
                        };

                        showToast(messages[event.error] || 'Erreur vocale : ' + event.error, 'error');
                    });
                }
            }

            const queryInput = form.querySelector('input[name="q"]');
            const trackedFields = [
                queryInput,
                form.querySelector('select[name="field"]'),
                form.querySelector('select[name="sort"]')
            ].filter(Boolean);

            let submitTimer = null;

            const resetToFirstPage = function () {
                let pageInput = form.querySelector('input[name="page"]');

                if (!pageInput) {
                    pageInput = document.createElement('input');
                    pageInput.type = 'hidden';
                    pageInput.name = 'page';
                    form.appendChild(pageInput);
                }

                pageInput.value = '1';
            };

            const requestAndSwap = function (url) {
                fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (response) {
                        return response.text();
                    })
                    .then(function (html) {
                        const parser = new DOMParser();
                        const nextDoc = parser.parseFromString(html, 'text/html');
                        const nextRoot = nextDoc.getElementById('activite-live-root');

                        if (!nextRoot) {
                            window.location.href = url;
                            return;
                        }

                        root.innerHTML = nextRoot.innerHTML;
                        window.history.replaceState({}, '', url);
                        initActiviteLiveSearch();
                        if (typeof window.ecomarineRenderRatings === 'function') {
                            window.ecomarineRenderRatings();
                        }
                    })
                    .catch(function () {
                        window.location.href = url;
                    });
            };

            const submitWithAjax = function () {
                const params = new URLSearchParams(new FormData(form));
                const url = form.action + (params.toString() ? ('?' + params.toString()) : '');
                requestAndSwap(url);
            };

            const scheduleSubmit = function (delay) {
                if (submitTimer) {
                    window.clearTimeout(submitTimer);
                }

                submitTimer = window.setTimeout(function () {
                    submitWithAjax();
                }, delay);
            };

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                submitWithAjax();
            });

            root.querySelectorAll('.quick-filter-btn, .page-link').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                    requestAndSwap(link.href);
                });
            });

            trackedFields.forEach(function (field) {
                if (field === queryInput) {
                    field.addEventListener('input', function () {
                        resetToFirstPage();
                        scheduleSubmit(320);
                    });

                    field.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            resetToFirstPage();
                            scheduleSubmit(0);
                        }
                    });

                    return;
                }

                field.addEventListener('change', function () {
                    resetToFirstPage();
                    scheduleSubmit(0);
                });
            });
        })();
    </script>
{% endblock %}
