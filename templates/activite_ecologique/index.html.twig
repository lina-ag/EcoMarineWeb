{% extends 'base_admin.html.twig' %}

{% block page_title %}Activités écologiques{% endblock %}
{% block navbar_title %}Activités écologiques{% endblock %}

{% block admin_content %}
    <section class="glass-card table-card reservation-admin-shell reservation-admin-shell-list" style="background: linear-gradient(135deg, rgba(226, 239, 255, 0.6), rgba(209, 230, 255, 0.5)); backdrop-filter: blur(8px);">
        <div class="card-header">
            <div class="reservation-admin-header">
                <span class="reservation-admin-kicker">Activity Panel</span>
                <h2 class="card-title">Liste des activités écologiques</h2>
                <p class="card-subtitle">Suivi des activités enregistrées dans la plateforme.</p>
            </div>
            <div class="card-actions">
                <a href="{{ path('app_activite_ecologique_export_pdf') }}" class="btn btn-secondary reservation-admin-cta">Exporter PDF</a>
                <a href="{{ path('app_activite_ecologique_new') }}" class="btn btn-primary reservation-admin-cta">Créer une activité</a>
            </div>
        </div>

        <style>
            .activity-search-row {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                flex-wrap: wrap;
            }

            .search-box {
                display: flex;
                align-items: center;
                gap: 0.95rem;
                flex: 1;
                min-width: 320px;
                padding: 0.85rem 1rem;
                border-radius: 24px;
                border: 1px solid rgba(191, 219, 254, 0.9);
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(229, 246, 255, 0.78));
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.9);
                transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            }

            .search-box:focus-within {
                border-color: rgba(59, 130, 246, 0.55);
                box-shadow: 0 14px 30px rgba(59, 130, 246, 0.18), inset 0 1px 1px rgba(255, 255, 255, 0.95);
                transform: translateY(-1px);
            }

            .search-box .search-icon {
                flex: 0 0 auto;
                width: 3.25rem;
                height: 3.25rem;
                padding: 0.72rem;
                border-radius: 18px;
                background: linear-gradient(135deg, rgba(37, 99, 235, 0.14), rgba(14, 165, 233, 0.18));
                color: #1d4ed8;
                box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.9), 0 6px 16px rgba(59, 130, 246, 0.12);
            }

            .search-box .search-input {
                min-width: 0;
                width: 100%;
                padding: 0.4rem 0;
                border: 0;
                background: transparent;
                color: #0f172a;
                font-size: 0.98rem;
                font-weight: 500;
                box-shadow: none;
                outline: none;
            }

            .search-box .search-input::placeholder {
                color: rgba(71, 85, 105, 0.78);
            }

            .search-icon-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.4rem;
                min-height: 3.25rem;
                padding: 0 1.2rem;
                border-radius: 18px;
                border: 1px solid rgba(59, 130, 246, 0.22);
                background: linear-gradient(135deg, #1d4ed8, #0f766e);
                color: #ffffff;
                box-shadow: 0 12px 24px rgba(29, 78, 216, 0.24), inset 0 1px 1px rgba(255, 255, 255, 0.22);
                transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
                font-size: 0.9rem;
                font-weight: 700;
                letter-spacing: 0.02em;
                white-space: nowrap;
            }

            .search-icon-btn svg {
                width: 1rem;
                height: 1rem;
                transition: transform 0.2s ease;
            }

            .search-icon-btn:hover,
            .search-icon-btn:focus-visible {
                transform: translateY(-2px);
                box-shadow: 0 16px 28px rgba(29, 78, 216, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.22);
                filter: brightness(1.03);
            }

            .search-icon-btn:hover svg,
            .search-icon-btn:focus-visible svg {
                transform: scale(1.08);
            }

            .search-icon-btn:focus-visible {
                outline: 3px solid rgba(96, 165, 250, 0.35);
                outline-offset: 2px;
            }

            .search-input {
                min-height: 3.25rem;
                padding: 0 0.95rem;
                border-radius: 18px;
                border: 1px solid rgba(191, 219, 254, 0.9);
                background: rgba(255, 255, 255, 0.92);
                color: #0f172a;
                box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
                font-weight: 600;
            }

            .search-input:focus {
                border-color: rgba(59, 130, 246, 0.55);
                box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.18);
            }

            .quick-filter-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.55rem 1.1rem;
                border-radius: 8px;
                border: 1px solid rgba(148, 163, 184, 0.35);
                background: linear-gradient(135deg, rgba(241, 245, 250, 0.85), rgba(226, 232, 240, 0.85));
                color: #1e293b;
                font-size: 0.82rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
                white-space: nowrap;
                box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.5);
            }

            .quick-filter-btn:hover,
            .quick-filter-btn:focus-visible {
                background: linear-gradient(135deg, rgba(219, 228, 240, 0.95), rgba(203, 213, 225, 0.95));
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.6);
                border-color: rgba(148, 163, 184, 0.5);
            }

            .quick-filter-btn.active {
                background: linear-gradient(135deg, rgba(59, 130, 246, 0.92), rgba(37, 99, 235, 0.92));
                color: #ffffff;
                border-color: rgba(37, 99, 235, 0.7);
                box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.3);
                font-weight: 700;
            }

            .quick-filter-btn.active:hover {
                background: linear-gradient(135deg, rgba(59, 130, 246, 1), rgba(37, 99, 235, 1));
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(59, 130, 246, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.3);
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.22rem 0.62rem;
                border-radius: 999px;
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.01em;
            }

            .status-badge-active {
                background: #dcfce7;
                color: #166534;
            }

            .status-badge-completed {
                background: #dbeafe;
                color: #1d4ed8;
            }

            .status-badge-cancelled {
                background: #fee2e2;
                color: #b91c1c;
            }

            .fill-rate-cell {
                min-width: 180px;
            }

            .fill-rate-track {
                height: 12px;
                border-radius: 999px;
                overflow: hidden;
                background: rgba(148, 163, 184, 0.25);
                border: 1px solid rgba(148, 163, 184, 0.35);
            }

            .fill-rate-bar {
                height: 100%;
                border-radius: 999px;
                transition: width 0.4s ease;
            }

            .fill-rate-good {
                background: linear-gradient(90deg, #22c55e, #16a34a);
            }

            .fill-rate-warning {
                background: linear-gradient(90deg, #f59e0b, #d97706);
            }

            .fill-rate-critical {
                background: linear-gradient(90deg, #ef4444, #b91c1c);
            }

            .fill-rate-value {
                font-size: 0.8rem;
                font-weight: 700;
                color: #1e3a8a;
                margin-top: 0.28rem;
            }

            .list-loading {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                font-size: 0.82rem;
                color: #1e3a8a;
                font-weight: 600;
            }

            .list-loading::before {
                content: '';
                width: 0.9rem;
                height: 0.9rem;
                border: 2px solid rgba(59, 130, 246, 0.22);
                border-top-color: #2563eb;
                border-radius: 50%;
                animation: spin 0.85s linear infinite;
            }

            .ux-empty-message {
                margin: 0.45rem 0 1rem;
                padding: 0.75rem 0.95rem;
                border-radius: 10px;
                border: 1px solid rgba(239, 68, 68, 0.22);
                background: rgba(254, 242, 242, 0.92);
                color: #991b1b;
                font-size: 0.9rem;
                font-weight: 600;
            }

            .list-pagination {
                margin-top: 1rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .list-pagination-meta {
                color: #334155;
                font-size: 0.9rem;
                font-weight: 600;
            }

            .list-pagination-links {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                flex-wrap: wrap;
            }

            .page-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 2.2rem;
                min-height: 2.2rem;
                padding: 0 0.7rem;
                border-radius: 10px;
                border: 1px solid rgba(148, 163, 184, 0.35);
                background: rgba(255, 255, 255, 0.95);
                color: #1e293b;
                font-size: 0.86rem;
                font-weight: 700;
                text-decoration: none;
                transition: all 0.2s ease;
            }

            .page-link:hover,
            .page-link:focus-visible {
                border-color: rgba(59, 130, 246, 0.45);
                background: rgba(239, 246, 255, 0.95);
                transform: translateY(-1px);
            }

            .page-link.active {
                background: linear-gradient(135deg, #1d4ed8, #0f766e);
                color: #ffffff;
                border-color: rgba(29, 78, 216, 0.8);
                box-shadow: 0 6px 16px rgba(29, 78, 216, 0.25);
            }

            @keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }
        </style>

        <div id="activite-live-root">
        <form id="activite-search-form" method="get" action="{{ path('app_activite_ecologique_index') }}" style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 1.1rem; padding: 1.1rem; background: linear-gradient(135deg, rgba(251, 253, 254, 0.64), rgba(239, 246, 255, 0.42)); border-radius: 20px; border: 1px solid rgba(191, 219, 254, 0.55); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06), inset 0 1px 1px rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px);">
            <div class="activity-search-row">
                <select id="activite-search-field" name="field" class="search-input" style="max-width: 150px;">
                    <option value="all" {{ search_field|default('all') == 'all' ? 'selected' : '' }}>Chercher par: Tous</option>
                    <option value="id" {{ search_field|default('all') == 'id' ? 'selected' : '' }}>ID</option>
                    <option value="nom" {{ search_field|default('all') == 'nom' ? 'selected' : '' }}>Nom</option>
                    <option value="date" {{ search_field|default('all') == 'date' ? 'selected' : '' }}>Date</option>
                    <option value="capacite" {{ search_field|default('all') == 'capacite' ? 'selected' : '' }}>Capacite</option>
                    <option value="description" {{ search_field|default('all') == 'description' ? 'selected' : '' }}>Description</option>
                </select>
                <div style="display: flex; align-items: center; gap: 0.65rem; flex: 1; min-width: 260px;">
                    <div class="search-box" style="max-width: 100%; flex: 1; margin: 0;">
                        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <input
                            id="activite-search-input"
                            type="text"
                            name="q"
                            class="search-input"
                            value="{{ search_term|default('') }}"
                            placeholder="Rechercher (commence par)..."
                            autocomplete="on"
                        >
                    </div>
                    <button id="activite-search-btn" type="submit" class="btn btn-secondary search-icon-btn" aria-label="Rechercher" title="Rechercher">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <span>Rechercher</span>
                    </button>
                </div>
                <small id="activite-result-count" style="opacity: 0.82; white-space: nowrap; font-weight: 700; color: #334155;">{{ result_count|default(activite_ecologiques|length) }} resultat(s)</small>
            </div>

            <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap; padding-top: 0.5rem; border-top: 1px solid rgba(203, 213, 225, 0.3);">
                <a href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'periode': 'all', 'page': 1})) }}" class="quick-filter-btn {{ periode_filter|default('all') == 'all' ? 'active' : '' }}" style="margin-right: 0.5rem;" title="Afficher toutes les activités">Tous</a>
                <a href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'periode': 'today', 'page': 1})) }}" class="quick-filter-btn {{ periode_filter|default('all') == 'today' ? 'active' : '' }}" title="Filtrer les activités du jour">Aujourd'hui</a>
                <a href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'periode': 'week', 'page': 1})) }}" class="quick-filter-btn {{ periode_filter|default('all') == 'week' ? 'active' : '' }}" title="Filtrer les activités de cette semaine">Cette semaine</a>
                <a href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'periode': 'current', 'page': 1})) }}" class="quick-filter-btn {{ periode_filter|default('all') == 'current' ? 'active' : '' }}" title="Filtrer les activités de ce mois">Ce mois</a>
                <a href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'capacite': 'medium-large', 'page': 1})) }}" class="quick-filter-btn {{ capacite_filter|default('all') == 'medium-large' ? 'active' : '' }}" title="Afficher les activités avec capacité supérieure à 10">Capacité > 10</a>
                <select id="activite-sort-by" name="sort" class="search-input" style="max-width: 150px; margin-left: auto;" onchange="this.form.submit();">
                    <option value="date_desc" {{ sort_by|default('date_desc') == 'date_desc' ? 'selected' : '' }}>Tri: Date recentes</option>
                    <option value="date_asc" {{ sort_by|default('date_desc') == 'date_asc' ? 'selected' : '' }}>Tri: Date anciennes</option>
                    <option value="id_desc" {{ sort_by|default('date_desc') == 'id_desc' ? 'selected' : '' }}>Tri: ID decroissant</option>
                    <option value="id_asc" {{ sort_by|default('date_desc') == 'id_asc' ? 'selected' : '' }}>Tri: ID croissant</option>
                    <option value="nom_asc" {{ sort_by|default('date_desc') == 'nom_asc' ? 'selected' : '' }}>Tri: Nom A-Z</option>
                    <option value="nom_desc" {{ sort_by|default('date_desc') == 'nom_desc' ? 'selected' : '' }}>Tri: Nom Z-A</option>
                    <option value="capacite_desc" {{ sort_by|default('date_desc') == 'capacite_desc' ? 'selected' : '' }}>Tri: Capacite max</option>
                    <option value="capacite_asc" {{ sort_by|default('date_desc') == 'capacite_asc' ? 'selected' : '' }}>Tri: Capacite min</option>
                </select>
            </div>
        </form>

        <div id="activite-empty-message" class="ux-empty-message" style="display: none;">Aucun résultat ne correspond à vos filtres.</div>

        <div class="table-wrapper reservation-admin-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Id activité</th>
                        <th>Nom activité</th>
                        <th>Date activité</th>
                        <th>Capacité</th>
                        <th>Taux remplissage</th>
                        <th>Description</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for activite_ecologique in activite_ecologiques %}
                    {% set activiteStatus = activite_ecologique.dateActivite and activite_ecologique.dateActivite|date('Y-m-d') < "now"|date('Y-m-d') ? 'completed' : 'active' %}
                    {% set booked = 0 %}
                    {% for reservation in activite_ecologique.reservations %}
                        {% set booked = booked + reservation.nombrePersonnes|default(0) %}
                    {% endfor %}
                    {% set capacity = activite_ecologique.capacite|default(0) %}
                    {% set rate = capacity > 0 ? (booked / capacity * 100) : 0 %}
                    {% set rateCapped = rate > 100 ? 100 : rate %}
                    {% set tone = rate >= 90 ? 'critical' : (rate >= 60 ? 'warning' : 'good') %}
                    <tr
                        class="reservation-admin-row"
                        style="--reservation-row-index: {{ loop.index0 }};"
                        data-search-id="{{ activite_ecologique.idActivite|e('html_attr') }}"
                        data-search-nom="{{ activite_ecologique.nomActivite|default('')|e('html_attr') }}"
                        data-search-date="{{ (activite_ecologique.dateActivite ? activite_ecologique.dateActivite|date('Y-m-d') : '')|e('html_attr') }}"
                        data-search-capacite="{{ activite_ecologique.capacite|e('html_attr') }}"
                        data-search-description="{{ activite_ecologique.description|default('')|e('html_attr') }}"
                        data-search-periode="{{ activite_ecologique.dateActivite ? (activite_ecologique.dateActivite|date('Y-m-d') < "now"|date('Y-m-d') ? 'past' : (activite_ecologique.dateActivite|date('Y-m') == "now"|date('Y-m') ? 'current' : 'future')) : 'unknown' }}"
                        data-search-status="{{ activiteStatus }}"
                        data-search-values="{{ [
                            activite_ecologique.idActivite,
                            activite_ecologique.nomActivite,
                            activite_ecologique.dateActivite ? activite_ecologique.dateActivite|date('Y-m-d') : '',
                            activite_ecologique.capacite,
                            activite_ecologique.description
                        ]|join('|')|lower|e('html_attr') }}"
                    >
                        <td>{{ activite_ecologique.idActivite }}</td>
                        <td>{{ activite_ecologique.nomActivite }}</td>
                        <td>{{ activite_ecologique.dateActivite ? activite_ecologique.dateActivite|date('Y-m-d') : '' }}</td>
                        <td>{{ activite_ecologique.capacite }}</td>
                        <td class="fill-rate-cell">
                            <div class="fill-rate-track" title="{{ booked }}/{{ capacity }} places réservées">
                                <div class="fill-rate-bar fill-rate-{{ tone }}" style="width: {{ rateCapped }}%;"></div>
                            </div>
                            <div class="fill-rate-value">{{ booked }}/{{ capacity }}</div>
                        </td>
                        <td>
                            <div>
                                {{ activite_ecologique.description|default('') }}
                            </div>
                            {% set stars = capacity > 0 ? (5 * booked / capacity) : 0 %}
                            <div class="reservation-rating" data-rating="{{ stars|number_format(1, '.', '') }}" data-readonly-rating="1" style="margin-top: 0.5em;"></div>
                        </td>
                        <td>
                            {% if activiteStatus == 'active' %}
                                <span class="status-badge status-badge-active">Active</span>
                            {% elseif activiteStatus == 'completed' %}
                                <span class="status-badge status-badge-completed">Complète</span>
                            {% else %}
                                <span class="status-badge status-badge-cancelled">Annulée</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="reservation-admin-actions">
                                <a href="{{ path('app_activite_ecologique_show', {'id_activite': activite_ecologique.id_activite}) }}" class="btn btn-secondary reservation-admin-action-btn" title="Voir l'activité">Voir</a>
                                <a href="{{ path('app_activite_ecologique_edit', {'id_activite': activite_ecologique.id_activite}) }}" class="btn btn-primary reservation-admin-action-btn" title="Modifier l'activité">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                    <tr id="activite-no-match-row" style="display: none;">
                        <td colspan="8">Aucun resultat pour cette recherche</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="list-pagination">
            <div class="list-pagination-meta">
                {% if result_count|default(0) > 0 %}
                    Affichage {{ page_start|default(0) }}-{{ page_end|default(0) }} sur {{ result_count|default(0) }} résultat(s)
                {% else %}
                    Aucun résultat
                {% endif %}
            </div>
            {% if total_pages|default(1) > 1 %}
                <div class="list-pagination-links">
                    {% if page|default(1) > 1 %}
                        <a class="page-link" href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'page': page - 1})) }}" aria-label="Page précédente">Préc.</a>
                    {% endif %}

                    {% for pageNumber in 1..total_pages %}
                        <a class="page-link {{ pageNumber == page ? 'active' : '' }}" href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'page': pageNumber})) }}">{{ pageNumber }}</a>
                    {% endfor %}

                    {% if page|default(1) < total_pages %}
                        <a class="page-link" href="{{ path('app_activite_ecologique_index', app.request.query.all|merge({'page': page + 1})) }}" aria-label="Page suivante">Suiv.</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        </div>
    </section>
{% endblock %}

{% block admin_javascripts %}
    {{ parent() }}
    <script>
        (function initActiviteLiveSearch() {
            const root = document.getElementById('activite-live-root');

            if (!root) {
                return;
            }

            const form = root.querySelector('#activite-search-form');

            if (!form) {
                return;
            }

            const queryInput = form.querySelector('input[name="q"]');
            const trackedFields = [
                queryInput,
                form.querySelector('select[name="field"]'),
                form.querySelector('select[name="sort"]')
            ].filter(Boolean);

            let submitTimer = null;

            const resetToFirstPage = function () {
                let pageInput = form.querySelector('input[name="page"]');

                if (!pageInput) {
                    pageInput = document.createElement('input');
                    pageInput.type = 'hidden';
                    pageInput.name = 'page';
                    form.appendChild(pageInput);
                }

                pageInput.value = '1';
            };

            const requestAndSwap = function (url) {
                fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (response) {
                        return response.text();
                    })
                    .then(function (html) {
                        const parser = new DOMParser();
                        const nextDoc = parser.parseFromString(html, 'text/html');
                        const nextRoot = nextDoc.getElementById('activite-live-root');

                        if (!nextRoot) {
                            window.location.href = url;
                            return;
                        }

                        root.innerHTML = nextRoot.innerHTML;
                        window.history.replaceState({}, '', url);
                        initActiviteLiveSearch();
                        if (typeof window.ecomarineRenderRatings === 'function') {
                            window.ecomarineRenderRatings();
                        }
                    })
                    .catch(function () {
                        window.location.href = url;
                    });
            };

            const submitWithAjax = function () {
                const params = new URLSearchParams(new FormData(form));
                const url = form.action + (params.toString() ? ('?' + params.toString()) : '');
                requestAndSwap(url);
            };

            const scheduleSubmit = function (delay) {
                if (submitTimer) {
                    window.clearTimeout(submitTimer);
                }

                submitTimer = window.setTimeout(function () {
                    submitWithAjax();
                }, delay);
            };

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                submitWithAjax();
            });

            root.querySelectorAll('.quick-filter-btn, .page-link').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                    requestAndSwap(link.href);
                });
            });

            trackedFields.forEach(function (field) {
                if (field === queryInput) {
                    field.addEventListener('input', function () {
                        resetToFirstPage();
                        scheduleSubmit(320);
                    });

                    field.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            resetToFirstPage();
                            scheduleSubmit(0);
                        }
                    });

                    return;
                }

                field.addEventListener('change', function () {
                    resetToFirstPage();
                    scheduleSubmit(0);
                });
            });
        })();
    </script>
{% endblock %}
