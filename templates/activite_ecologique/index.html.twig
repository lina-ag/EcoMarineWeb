    {{ parent() }}
    <script>
        (function () {
            const form = document.getElementById('activite-search-form');
            const input = document.getElementById('activite-search-input');

            if (!form || !input) {
                return;
            }

            let timer = null;
            input.addEventListener('input', function () {
                window.clearTimeout(timer);
                timer = window.setTimeout(function () {
                    form.requestSubmit();
                }, 300);
            });
        })();
    </script>
