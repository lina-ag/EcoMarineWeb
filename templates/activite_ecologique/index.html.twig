            <script>
                (() => {
                    const input = document.getElementById('activite-search-input');
                    const datalist = document.getElementById('activite-search-suggestions');

                    if (!input || !datalist) {
                        return;
                    }

                    const source = JSON.parse(input.dataset.autocompleteSource || '[]');
                    const normalize = (value) => value
                        .toLowerCase()
                        .normalize('NFD')
                        .replace(/[\u0300-\u036f]/g, '')
                        .trim();

                    const renderSuggestions = (rawValue) => {
                        const query = normalize(rawValue);
                        const suggestions = query === ''
                            ? source.slice(0, 8)
                            : source.filter((item) => normalize(item).startsWith(query)).slice(0, 8);

                        datalist.innerHTML = suggestions
                            .map((item) => '<option value="' + String(item).replace(/"/g, '&quot;') + '">')
                            .join('');
                    };

                    input.addEventListener('input', () => renderSuggestions(input.value));
                    input.addEventListener('focus', () => renderSuggestions(input.value));
                    renderSuggestions(input.value);
                })();
            </script>

