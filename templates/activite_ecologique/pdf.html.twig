<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Liste des activités écologiques</title>
    <style>
        @page {
            margin: 150px 36px 90px 36px;
        }

        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 11px;
            color: #0f172a;
            margin: 0;
            background: #f8fafc;
        }

        .report-header {
            position: fixed;
            top: -120px;
            left: 0;
            right: 0;
            height: 110px;
            padding: 20px 36px 14px;
            background: linear-gradient(135deg, #0f766e, #1d4ed8);
            color: #ffffff;
            border-bottom: 4px solid rgba(255, 255, 255, 0.18);
        }

        .header-inner,
        .footer-inner {
            display: table;
            width: 100%;
        }

        .header-brand,
        .header-meta,
        .footer-left,
        .footer-right {
            display: table-cell;
            vertical-align: middle;
        }

        .header-brand {
            width: 65%;
        }

        .brand-row {
            display: table;
            width: 100%;
        }

        .brand-logo,
        .brand-copy {
            display: table-cell;
            vertical-align: middle;
        }

        .brand-logo img {
            width: 64px;
            height: 64px;
            object-fit: contain;
            margin-right: 14px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.12);
            padding: 6px;
        }

        .brand-kicker {
            margin: 0 0 4px;
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            opacity: 0.85;
        }

        .brand-title {
            margin: 0;
            font-size: 24px;
            line-height: 1.1;
        }

        .brand-subtitle {
            margin: 6px 0 0;
            font-size: 11px;
            opacity: 0.92;
        }

        .header-meta {
            text-align: right;
        }

        .header-meta-box {
            display: inline-block;
            padding: 10px 14px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.16);
        }

        .header-meta-label {
            margin: 0 0 4px;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            opacity: 0.78;
        }

        .header-meta-value {
            margin: 0;
            font-size: 12px;
            font-weight: 700;
        }

        .report-footer {
            position: fixed;
            bottom: -66px;
            left: 0;
            right: 0;
            height: 54px;
            padding: 14px 36px 0;
            border-top: 1px solid #cbd5e1;
            color: #475569;
            font-size: 9px;
            background: #ffffff;
        }

        .footer-right {
            text-align: right;
        }

        .page-number::after {
            content: "Page " counter(page) " / " counter(pages);
            font-weight: 700;
            color: #1e3a8a;
        }

        .content {
            padding-top: 0;
        }

        .hero {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(226, 239, 255, 0.84));
            border: 1px solid #dbeafe;
            border-radius: 18px;
            padding: 18px 20px;
            margin-bottom: 14px;
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
        }

        .hero-top {
            display: table;
            width: 100%;
        }

        .hero-title,
        .hero-badge {
            display: table-cell;
            vertical-align: middle;
        }

        .hero-title h1 {
            margin: 0;
            font-size: 21px;
            color: #0f172a;
        }

        .hero-title p {
            margin: 6px 0 0;
            color: #475569;
            font-size: 10px;
        }

        .hero-badge {
            text-align: right;
        }

        .badge {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 999px;
            background: #dbeafe;
            color: #1d4ed8;
            font-weight: 700;
            font-size: 10px;
        }

        .stats {
            display: table;
            width: 100%;
            margin-bottom: 14px;
            table-layout: fixed;
        }

        .stat {
            display: table-cell;
            padding-right: 10px;
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #dbeafe;
            border-radius: 14px;
            padding: 12px 14px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
        }

        .stat-label {
            margin: 0 0 6px;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #64748b;
        }

        .stat-value {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
        }

        th,
        td {
            border: 1px solid #dbeafe;
            padding: 8px 9px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: linear-gradient(135deg, #dbeafe, #e0f2fe);
            color: #0f172a;
            font-weight: 700;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        tbody tr:nth-child(even) td {
            background: #f8fafc;
        }

        .empty-row td {
            text-align: center;
            color: #64748b;
            font-style: italic;
            padding: 18px 10px;
        }
    </style>
</head>
<body>
    {% set totalActivities = activite_ecologiques|length %}
    {% set totalCapacity = 0 %}
    {% for activite in activite_ecologiques %}
        {% set totalCapacity = totalCapacity + (activite.capacite|default(0)) %}
    {% endfor %}
    {% set averageCapacity = totalActivities > 0 ? (totalCapacity / totalActivities) : 0 %}

    <div class="report-header">
        <div class="header-inner">
            <div class="header-brand">
                <div class="brand-row">
                    <div class="brand-logo">
                        <img src="{{ absolute_url(asset('assets/images/logoEco.png')) }}" alt="EcoMarine">
                    </div>
                    <div class="brand-copy">
                        <p class="brand-kicker">EcoMarine</p>
                        <h2 class="brand-title">Rapport des activités écologiques</h2>
                        <p class="brand-subtitle">Inventaire exporté avec mise en forme de lecture et repères visuels.</p>
                    </div>
                </div>
            </div>
            <div class="header-meta">
                <div class="header-meta-box">
                    <p class="header-meta-label">Généré le</p>
                    <p class="header-meta-value">{{ generatedAt|date('d/m/Y H:i') }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="report-footer">
        <div class="footer-inner">
            <div class="footer-left">EcoMarine - Écotourisme et recherche marine à Kuriat, Monastir</div>
            <div class="footer-right"><span class="page-number"></span></div>
        </div>
    </div>

    <div class="content">
        <div class="hero">
            <div class="hero-top">
                <div class="hero-title">
                    <h1>Activités écologiques enregistrées</h1>
                    <p>Vue synthétique des activités disponibles, avec capacité moyenne et données de base.</p>
                </div>
                <div class="hero-badge">
                    <span class="badge">{{ totalActivities }} activité{{ totalActivities > 1 ? 's' : '' }}</span>
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <div class="stat-card">
                    <p class="stat-label">Total</p>
                    <p class="stat-value">{{ totalActivities }}</p>
                </div>
            </div>
            <div class="stat">
                <div class="stat-card">
                    <p class="stat-label">Capacité cumulée</p>
                    <p class="stat-value">{{ totalCapacity }}</p>
                </div>
            </div>
            <div class="stat" style="padding-right: 0;">
                <div class="stat-card">
                    <p class="stat-label">Capacité moyenne</p>
                    <p class="stat-value">{{ averageCapacity|round(1, 'common') }}</p>
                </div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom activité</th>
                    <th>Date activité</th>
                    <th>Capacité</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                {% for activite in activite_ecologiques %}
                    <tr>
                        <td>{{ activite.idActivite }}</td>
                        <td>{{ activite.nomActivite }}</td>
                        <td>{{ activite.dateActivite ? activite.dateActivite|date('d/m/Y') : '' }}</td>
                        <td>{{ activite.capacite }}</td>
                        <td>{{ activite.description|default('') }}</td>
                    </tr>
                {% else %}
                    <tr class="empty-row">
                        <td colspan="5">Aucune activité enregistrée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
