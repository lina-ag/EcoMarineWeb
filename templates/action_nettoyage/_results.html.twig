<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Lieu</th>
                <th>Limite benevoles</th>
                <th>Participants</th>
                <th>Remplissage</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for action_nettoyage in action_nettoyages %}
            {% set capacity = action_nettoyage.limiteBenevoles ?: 0 %}
            {% set participants = action_nettoyage.nombreVolontaires %}
            {% set fillRate = capacity > 0 ? ((participants / capacity) * 100)|round(1) : 0 %}
            {% set isPast = action_nettoyage.dateAction and action_nettoyage.dateAction|date('Y-m-d') < 'now'|date('Y-m-d') %}
            <tr>
                <td>{{ action_nettoyage.idAction }}</td>
                <td>{{ action_nettoyage.dateAction ? action_nettoyage.dateAction|date('Y-m-d') : '' }}</td>
                <td>{{ action_nettoyage.lieu }}</td>
                <td>{{ action_nettoyage.limiteBenevoles }}</td>
                <td>{{ participants }}</td>
                <td>
                    <div style="min-width:130px;">
                        <div style="font-weight:700;">{{ fillRate }}%</div>
                        <div style="width:100%; height:8px; border-radius:999px; background:rgba(255,255,255,0.08); overflow:hidden; margin-top:6px;">
                            <div style="width: {{ fillRate }}%; height:100%; border-radius:999px; background:linear-gradient(90deg,#22c55e 0%,#38bdf8 100%);"></div>
                        </div>
                    </div>
                </td>
                <td>
                    {% if isPast %}
                        <span class="status-badge pending">Terminee</span>
                    {% elseif action_nettoyage.estComplete %}
                        <span class="status-badge pending">Complete</span>
                    {% else %}
                        <span class="status-badge completed">Disponible</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_action_nettoyage_show', {'id_action': action_nettoyage.id_action}) }}" class="btn btn-secondary">show</a>
                    <a href="{{ path('app_action_nettoyage_edit', {'id_action': action_nettoyage.id_action}) }}" class="btn btn-primary">edit</a>
                    <form method="post"
                          action="{{ path('app_action_nettoyage_delete', {'id_action': action_nettoyage.id_action}) }}"
                          class="inline-delete-form"
                          data-admin-delete-form>
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ action_nettoyage.id_action) }}">
                        <button class="btn btn-secondary" type="submit">delete</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{{ knp_pagination_render(action_nettoyages, 'admin/_ajax_pagination.html.twig') }}
