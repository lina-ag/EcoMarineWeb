<div id="admin-cleaning-list-panel" data-admin-cleaning-panel>
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Date</th>
                    <th>Lieu</th>
                    <th>Limite bénévoles</th>
                    <th>Participants</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for action_nettoyage in action_nettoyages %}
                <tr>
                    <td>{{ action_nettoyage.idAction }}</td>
                    <td>{{ action_nettoyage.dateAction ? action_nettoyage.dateAction|date('Y-m-d') : '' }}</td>
                    <td>{{ action_nettoyage.lieu }}</td>
                    <td>{{ action_nettoyage.limiteBenevoles }}</td>
                    <td>{{ action_nettoyage.nombreVolontaires }}</td>
                    <td>
                        {% if action_nettoyage.estComplete %}
                            <span class="status-badge pending">Complète</span>
                        {% else %}
                            <span class="status-badge completed">Disponible</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_action_nettoyage_show', {'id_action': action_nettoyage.id_action}) }}" class="btn btn-secondary">show</a>
                        <a href="{{ path('app_action_nettoyage_edit', {'id_action': action_nettoyage.id_action}) }}" class="btn btn-primary">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">Aucune action de nettoyage planifiée ne correspond à ce filtre.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="pagination-container mt-4">
        {{ knp_pagination_render(action_nettoyages, 'admin/_pagination.html.twig') }}
    </div>
</div>
