<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Calendrier des activités</title>
    <style>
        @page {
            margin: 140px 34px 84px 34px;
        }

        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 11px;
            color: #0f172a;
            margin: 0;
            background: #f8fafc;
        }

        .report-header {
            position: fixed;
            top: -112px;
            left: 0;
            right: 0;
            height: 102px;
            padding: 18px 34px 12px;
            background: linear-gradient(135deg, #0f766e, #1d4ed8);
            color: #ffffff;
            border-bottom: 4px solid rgba(255, 255, 255, 0.18);
        }

        .header-inner,
        .footer-inner {
            display: table;
            width: 100%;
        }

        .header-brand,
        .header-meta,
        .footer-left,
        .footer-right {
            display: table-cell;
            vertical-align: middle;
        }

        .header-brand {
            width: 68%;
        }

        .brand-row {
            display: table;
            width: 100%;
        }

        .brand-logo,
        .brand-copy {
            display: table-cell;
            vertical-align: middle;
        }

        .brand-logo img {
            width: 58px;
            height: 58px;
            object-fit: contain;
            margin-right: 14px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.12);
            padding: 6px;
        }

        .brand-kicker {
            margin: 0 0 4px;
            font-size: 9px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            opacity: 0.85;
        }

        .brand-title {
            margin: 0;
            font-size: 22px;
            line-height: 1.1;
        }

        .brand-subtitle {
            margin: 5px 0 0;
            font-size: 10px;
            opacity: 0.92;
        }

        .header-meta {
            text-align: right;
        }

        .header-meta-box {
            display: inline-block;
            padding: 9px 12px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.16);
        }

        .header-meta-label {
            margin: 0 0 4px;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            opacity: 0.78;
        }

        .header-meta-value {
            margin: 0;
            font-size: 11px;
            font-weight: 700;
        }

        .report-footer {
            position: fixed;
            bottom: -62px;
            left: 0;
            right: 0;
            height: 50px;
            padding: 12px 34px 0;
            border-top: 1px solid #cbd5e1;
            color: #475569;
            font-size: 9px;
            background: #ffffff;
        }

        .footer-right {
            text-align: right;
        }

        .page-number::after {
            content: "Page " counter(page) " / " counter(pages);
            font-weight: 700;
            color: #1e3a8a;
        }

        .content {
            padding-top: 0;
        }

        .hero {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(226, 239, 255, 0.84));
            border: 1px solid #dbeafe;
            border-radius: 18px;
            padding: 16px 18px;
            margin-bottom: 12px;
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
        }

        .hero-top {
            display: table;
            width: 100%;
        }

        .hero-title,
        .hero-badge {
            display: table-cell;
            vertical-align: middle;
        }

        .hero-title h1 {
            margin: 0;
            font-size: 20px;
            color: #0f172a;
        }

        .hero-title p {
            margin: 6px 0 0;
            color: #475569;
            font-size: 10px;
        }

        .hero-badge {
            text-align: right;
        }

        .badge {
            display: inline-block;
            padding: 7px 11px;
            border-radius: 999px;
            background: #dbeafe;
            color: #1d4ed8;
            font-weight: 700;
            font-size: 10px;
            margin-left: 6px;
        }

        .stats {
            display: table;
            width: 100%;
            margin-bottom: 12px;
            table-layout: fixed;
        }

        .stat {
            display: table-cell;
            padding-right: 10px;
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #dbeafe;
            border-radius: 14px;
            padding: 11px 13px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
        }

        .stat-label {
            margin: 0 0 5px;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #64748b;
        }

        .stat-value {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
        }

        th,
        td {
            border: 1px solid #dbeafe;
            padding: 7px 8px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: linear-gradient(135deg, #dbeafe, #e0f2fe);
            color: #0f172a;
            font-weight: 700;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        tbody tr:nth-child(even) td {
            background: #f8fafc;
        }

        .empty-row td {
            text-align: center;
            color: #64748b;
            font-style: italic;
            padding: 18px 10px;
        }

        .fill-bar {
            height: 8px;
            border-radius: 999px;
            background: #e2e8f0;
            overflow: hidden;
            margin-top: 4px;
        }

        .fill-bar span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #0f766e, #2563eb);
        }
    </style>
</head>
<body>
    {% set totalActivities = activite_ecologiques|length %}
    {% set totalReserved = 0 %}
    {% set totalCapacity = 0 %}

    {% for activite in activite_ecologiques %}
        {% set reservedPeople = 0 %}
        {% for reservation in activite.reservations %}
            {% set reservedPeople = reservedPeople + (reservation.nombrePersonnes|default(0)) %}
        {% endfor %}
        {% set capacity = activite.capacite|default(0) %}
        {% set totalReserved = totalReserved + reservedPeople %}
        {% set totalCapacity = totalCapacity + capacity %}
    {% endfor %}
    {% set averageFill = totalCapacity > 0 ? ((totalReserved / totalCapacity) * 100)|round(0, 'common') : 0 %}

    <div class="report-header">
        <div class="header-inner">
            <div class="header-brand">
                <div class="brand-row">
                    <div class="brand-logo">
                        <img src="{{ absolute_url(asset('assets/images/logoEco.png')) }}" alt="EcoMarine">
                    </div>
                    <div class="brand-copy">
                        <p class="brand-kicker">EcoMarine</p>
                        <h2 class="brand-title">Calendrier des activités</h2>
                        <p class="brand-subtitle">Export KnpSnappy avec en-tête, pied de page et synthèse visuelle.</p>
                    </div>
                </div>
            </div>
            <div class="header-meta">
                <div class="header-meta-box">
                    <p class="header-meta-label">Généré le</p>
                    <p class="header-meta-value">{{ generatedAt|date('d/m/Y H:i') }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="report-footer">
        <div class="footer-inner">
            <div class="footer-left">EcoMarine - Écotourisme et recherche marine à Kuriat, Monastir</div>
            <div class="footer-right"><span class="page-number"></span></div>
        </div>
    </div>

    <div class="content">
        <div class="hero">
            <div class="hero-top">
                <div class="hero-title">
                    <h1>Calendrier des activités</h1>
                    <p>Vue synthétique des activités, des places réservées et des indicateurs de remplissage.</p>
                </div>
                <div class="hero-badge">
                    {% if searchTerm %}<span class="badge">Recherche: {{ searchTerm }}</span>{% endif %}
                    {% if statusFilter != 'all' %}<span class="badge">Statut: {{ statusFilter }}</span>{% endif %}
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <div class="stat-card">
                    <p class="stat-label">Activités</p>
                    <p class="stat-value">{{ totalActivities }}</p>
                </div>
            </div>
            <div class="stat">
                <div class="stat-card">
                    <p class="stat-label">Réservées</p>
                    <p class="stat-value">{{ totalReserved }}</p>
                </div>
            </div>
            <div class="stat" style="padding-right: 0;">
                <div class="stat-card">
                    <p class="stat-label">Remplissage moyen</p>
                    <p class="stat-value">{{ averageFill }}%</p>
                </div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Activité</th>
                    <th>Date</th>
                    <th>Capacité</th>
                    <th>Réservées</th>
                    <th>Restantes</th>
                    <th>Remplissage</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                {% for activite in activite_ecologiques %}
                    {% set reservedPeople = 0 %}
                    {% for reservation in activite.reservations %}
                        {% set reservedPeople = reservedPeople + (reservation.nombrePersonnes|default(0)) %}
                    {% endfor %}
                    {% set capacity = activite.capacite|default(0) %}
                    {% set remaining = capacity > reservedPeople ? capacity - reservedPeople : 0 %}
                    {% set fillRate = capacity > 0 ? ((reservedPeople / capacity) * 100)|round(0, 'common') : 0 %}
                    <tr>
                        <td>{{ activite.nomActivite }}</td>
                        <td>{{ activite.dateActivite ? activite.dateActivite|date('d/m/Y') : '' }}</td>
                        <td>{{ capacity }}</td>
                        <td>{{ reservedPeople }}</td>
                        <td>{{ remaining }}</td>
                        <td>
                            {{ fillRate }}%
                            <div class="fill-bar"><span style="width: {{ fillRate > 100 ? 100 : fillRate }}%;"></span></div>
                        </td>
                        <td>{{ activite.description|default('') }}</td>
                    </tr>
                {% else %}
                    <tr class="empty-row">
                        <td colspan="7">Aucune activité enregistrée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
