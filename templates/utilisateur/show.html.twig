{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block body %}

<section class="glass-card user-show">

    <div class="card-header">
        <div>
            <h2 class="card-title">👤 Utilisateur #{{ utilisateur.idUtilisateur }}</h2>
            <p class="card-subtitle">Details du compte utilisateur</p>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="data-table custom-table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ utilisateur.idUtilisateur }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ utilisateur.nom }}</td>
                </tr>
                <tr>
                    <th>Prenom</th>
                    <td>{{ utilisateur.prenom }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ utilisateur.email }}</td>
                </tr>
                <tr>
                    <th>Mot de passe</th>
                    <td>
                        <span class="password-hidden">••••••••</span>
                    </td>
                </tr>
                <tr>
                    <th>Telephone</th>
                    <td>{{ utilisateur.telephone }}</td>
                </tr>
                <tr>
                    <th>Role</th>
                    <td>
                        {% if utilisateur.role == 'admin' %}
                            <span class="badge role-admin">Admin</span>
                        {% elseif utilisateur.role == 'chercheur' %}
                            <span class="badge role-chercheur">Chercheur</span>
                        {% else %}
                            <span class="badge role-user">Utilisateur</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Date naissance</th>
                    <td>{{ utilisateur.dateNaissance ? utilisateur.dateNaissance|date('d/m/Y') : '-' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="btn-group">
        <a href="{{ path('app_utilisateur_index') }}" class="btn btn-secondary">⬅ Retour</a>
        <a href="{{ path('app_utilisateur_edit', {'id_utilisateur': utilisateur.idUtilisateur}) }}" class="btn btn-primary">✏ Modifier</a>
        {{ include('utilisateur/_delete_form.html.twig') }}
    </div>

</section>

<style>
:root {
    --bg-card: #ffffff;
    --text-main: #1a1a1a;
    --text-muted: #555;
    --border-color: rgba(0,0,0,0.1);
    --primary: #1b9aaa;
    --primary-light: #2ec4b6;
    --danger: #ff4b2b;
    --danger-light: rgba(255,75,43,0.1);
}

body.dark-mode {
    --bg-card: rgba(255,255,255,0.05);
    --text-main: #ffffff;
    --text-muted: rgba(255,255,255,0.6);
    --border-color: rgba(255,255,255,0.1);
}

.custom-table th {
    color: var(--primary);
}

.custom-table td {
    color: var(--text-main);
}

.custom-table tr {
    border-bottom: 1px solid var(--border-color);
}

.password-hidden {
    color: var(--text-muted);
}

.badge {
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: white;
}

.role-admin {
    background: linear-gradient(135deg, #fb9666, #fb9666);
}

.role-chercheur {
    background: linear-gradient(135deg, #4facfe, #00c6ff);
}

.role-user {
    background: linear-gradient(135deg, var(--primary-light), var(--primary));
}

.btn {
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-weight: 600;
    transition: 0.3s;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-light), var(--primary));
    color: #fff;
}

.btn-primary:hover {
    transform: translateY(-2px);
}

.btn-secondary {
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background: rgba(0,0,0,0.05);
}

form button.btn-danger {
    background: linear-gradient(135deg, #ff416c, #ff4b2b);
    color: white;
}

.user-show {
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-color);
}

.card-title {
    color: var(--text-main);
}

.card-subtitle {
    color: var(--text-muted);
}

@media(max-width:768px){
    .btn-group {
        flex-direction: column;
    }
}
</style>

{% endblock %}
