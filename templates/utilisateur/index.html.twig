{% extends 'base.html.twig' %}

{% block title %}Utilisateur index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .utilisateurs-compact .table-wrapper {
            overflow-x: auto;
            max-width: 980px;
            margin: 0 auto;
        }

        .utilisateurs-compact .data-table {
            width: 100%;
            table-layout: fixed;
        }

        .utilisateurs-compact .data-table th,
        .utilisateurs-compact .data-table td {
            padding: 0.75rem 0.9rem;
            vertical-align: middle;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .utilisateurs-compact .data-table th:last-child,
        .utilisateurs-compact .data-table td:last-child {
            width: 280px;
            overflow: visible;
            text-overflow: initial;
        }

        .utilisateurs-compact .data-table td:last-child {
            white-space: nowrap;
        }

        .alert {
            max-width: 980px;
            margin: 0 auto 1rem auto;
        }

        .utilisateurs-compact .btn-success {
            background: linear-gradient(135deg, #2ec4b6, #1b9aaa);
            border: none;
            color: #fff;
            width: 92px;
            height: 50px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.3cm;
            border-radius: 8px;
            font-size: 12px;
        }

        .utilisateurs-compact .btn-primary {
            background: linear-gradient(135deg, #2ec4b6, #1b9aaa);
            border: none;
            color: #fff;
        }

        .utilisateurs-compact .btn-primary:hover {
            background: linear-gradient(135deg, #26b0a3, #168a96);
            transform: translateY(-1px);
        }

        .utilisateurs-compact .btn-info {
            background: linear-gradient(135deg, #2ec4b6, #1b9aaa);
            border: none;
            color: #fff;
        }

        .utilisateurs-compact .btn-info:hover {
            background: linear-gradient(135deg, #26b0a3, #168a96);
        }

        .utilisateurs-compact .btn-warning {
            background: linear-gradient(135deg, #2ec4b6, #1b9aaa);
            border: none;
            color: #fff;
        }

        .utilisateurs-compact .btn-warning:hover {
            background: linear-gradient(135deg, #26b0a3, #168a96);
        }

        .utilisateurs-compact .btn-danger {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            border: none;
            color: #fff;
        }

        .utilisateurs-compact .btn-danger:hover {
            background: linear-gradient(135deg, #e6395c, #e04325);
        }

        .search-panel {
            max-width: 980px;
            margin: 0 auto 1rem auto;
        }

        .search-form .search-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: space-between;
        }

        .search-form .form-control {
            flex: 1 1 220px;
            min-width: 180px;
            padding: 0.75rem 0.9rem;
            border-radius: 8px;
            border: 1px solid #ced4da;
            background: none;
            color: #495057;
        }

        .search-actions {
            display: flex;
            flex-wrap: nowrap;
            gap: 8px;
            color: #495057;
            align-items: center;
        }

        .search-actions .btn-primary {
            padding: 0.35rem 0.7rem;
            font-size: 0.75rem;
            min-width: auto;
        }

        .search-actions .btn-reset {
            padding: 0.35rem 0.7rem;
            font-size: 0.75rem;
            min-width: auto;
            background: linear-gradient(135deg, #26b0a3, #1f8a82);
            border: none;
            color: white;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .search-actions .btn-reset:hover {
            background: linear-gradient(135deg, #1f8a82, #17645e);
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(26, 176, 163, 0.25);
        }

        .search-form.is-loading .form-control,
        .search-form.is-loading .btn-reset {
            opacity: 0.7;
        }

        .data-table .no-results td {
            padding: 1.2rem;
            background: #f8f9fa;
            color: #495057;
        }

        @media (max-width: 768px) {
            .search-form .search-row {
                flex-direction: column;
                align-items: stretch;
                color: #495057;
            }

            .search-actions {
                width: 100%;
                justify-content: stretch;
            }
        }

        .badge {
            display: inline-block;
            padding: 0.35em 0.65em;
            font-size: 0.75em;
            font-weight: 600;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 30px;
        }

        .badge.bg-danger {
            background-color: #fb9666;
            color: white;
        }

        .badge.bg-primary {
            background-color: #1b9aaa;
            color: white;
        }

        .badge.bg-secondary {
            background-color: #6c757d;
            color: white;
        }

        .badge.bg-blocked {
            background-color: #ff416c;
            color: white;
        }

        .pagination {
            display: flex;
            gap: 6px;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .pagination span.current {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            background-color: #495057 !important;
            color: #fff !important;
            font-weight: 600;
            border: 1px solid #495057;
        }

        .pagination span.page a,
        .pagination span.next a,
        .pagination span.last a,
        .pagination span.previous a,
        .pagination span.first a {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            color: #495057 !important;
            background-color: #fff !important;
            border: 1px solid #495057 !important;
            text-decoration: none;
            transition: all 0.3s;
        }

        .pagination span.page a:hover,
        .pagination span.next a:hover,
        .pagination span.last a:hover,
        .pagination span.previous a:hover,
        .pagination span.first a:hover {
            background-color: #495057 !important;
            color: #fff !important;
        }

        tr.blocked-row {
            background-color: rgba(255, 65, 108, 0.12) !important;
            border-left: 4px solid #ff416c;
        }
    </style>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <section class="glass-card utilisateurs-compact">
        <div class="card-header">
            <a href="{{ path('app_utilisateur_export_excel') }}" class="btn btn-success">📥 Excel</a>
            <a href="{{ path('app_utilisateur_new') }}" class="btn btn-primary">➕ Creer un utilisateur</a>
        </div>

        <div class="search-panel">
            <form id="search-form" method="get" action="{{ path('app_utilisateur_index') }}" class="search-form">
                <div class="search-row">
                    <input id="user-search" type="search" name="search" value="{{ search|default('') }}" placeholder="Recherche par nom ou prenom" class="form-control">
                    <select id="role-filter" name="role" class="form-control">
                        <option value="all"{% if selectedRole is defined and selectedRole == 'all' %} selected{% endif %}>Tous les roles</option>
                        {% for roleOption in roles %}
                            <option value="{{ roleOption.nomRole }}"{% if selectedRole is defined and selectedRole == roleOption.nomRole %} selected{% endif %}>
                                {% if roleOption.nomRole == 'admin' %}
                                    Administrateur
                                {% elseif roleOption.nomRole == 'chercheur' %}
                                    Chercheur
                                {% else %}
                                    Utilisateur
                                {% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="search-actions">
                        <a href="{{ path('app_utilisateur_index') }}" id="reset-search" class="btn-reset">🔄 Reinitialiser</a>
                    </div>
                </div>
            </form>
        </div>

        {% include 'utilisateur/_results.html.twig' %}
    </section>

    <script>
        async function toggleBlock(id, action) {
            const msg = action === 'block' ? 'Bloquer cet utilisateur ?' : 'Debloquer cet utilisateur ?';
            if (!confirm(msg)) return;

            try {
                const response = await fetch(`/api/users/${id}/${action}`, { method: 'PUT' });
                const data = await response.json();

                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Action impossible');
                }
            } catch (error) {
                alert('Erreur: ' + error.message);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('user-search');
            const roleFilter = document.getElementById('role-filter');
            const searchForm = document.getElementById('search-form');
            const resetButton = document.getElementById('reset-search');
            let debounceTimer = null;
            let activeRequest = null;

            function buildUrl(page = 1) {
                const url = new URL(searchForm.action, window.location.origin);
                const searchValue = searchInput.value.trim();
                const roleValue = roleFilter.value;

                if (searchValue) {
                    url.searchParams.set('search', searchValue);
                }

                if (roleValue && roleValue !== 'all') {
                    url.searchParams.set('role', roleValue);
                }

                if (page > 1) {
                    url.searchParams.set('page', page);
                }

                return url;
            }

            async function performSearch(page = 1) {
                const url = buildUrl(page);

                if (activeRequest) {
                    activeRequest.abort();
                }

                activeRequest = new AbortController();
                searchForm.classList.add('is-loading');

                try {
                    const response = await fetch(url.toString(), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        signal: activeRequest.signal
                    });

                    if (!response.ok) {
                        throw new Error('Reponse invalide du serveur');
                    }

                    const html = await response.text();
                    const currentResults = document.getElementById('users-results');

                    if (currentResults) {
                        currentResults.outerHTML = html;
                        history.replaceState({}, '', url);
                        bindPaginationLinks();
                    }
                } catch (error) {
                    if (error.name !== 'AbortError') {
                        console.error('Erreur lors de la recherche:', error);
                    }
                } finally {
                    searchForm.classList.remove('is-loading');
                }
            }

            function scheduleSearch() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => performSearch(1), 250);
            }

            function bindPaginationLinks() {
                const paginationLinks = document.querySelectorAll('#users-results .pagination a');

                paginationLinks.forEach(link => {
                    link.addEventListener('click', function (event) {
                        event.preventDefault();
                        const pageUrl = new URL(this.href, window.location.origin);
                        const page = parseInt(pageUrl.searchParams.get('page') || '1', 10);
                        performSearch(page);
                    });
                });
            }

            searchInput.addEventListener('input', scheduleSearch);
            roleFilter.addEventListener('change', () => performSearch(1));
            searchForm.addEventListener('submit', event => event.preventDefault());

            resetButton.addEventListener('click', function (event) {
                event.preventDefault();
                searchInput.value = '';
                roleFilter.value = 'all';
                performSearch(1);
            });

            bindPaginationLinks();
        });
    </script>
{% endblock %}
