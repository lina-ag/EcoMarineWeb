{% extends 'base.html.twig' %}
{% block title %}Rapport IA - Machine Learning{% endblock %}
{% block body %}
<section class="glass-card">

    <div class="card-header" style="padding:1.5rem; display:flex; justify-content:space-between; align-items:center;">
        <h2>📊 Rapport IA — Machine Learning</h2>
        <span style="color:#6c757d; font-size:0.9rem;">
            🤖 Généré par PHP-ML | {{ rapport.genere_le|date('d/m/Y à H:i') }}
        </span>
    </div>

    {# Score de santé #}
    {% set score = rapport.score_sante %}
    {% set scoreColor = score >= 75 ? '#28a745' : (score >= 50 ? '#ffc107' : '#dc3545') %}
    <div style="text-align:center; padding:30px;">
        <div style="position:relative; width:150px; height:150px; margin:0 auto;">
            <svg viewBox="0 0 36 36" style="width:150px; height:150px; transform:rotate(-90deg);">
                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e9ecef" stroke-width="3"/>
                <circle cx="18" cy="18" r="15.9" fill="none" stroke="{{ scoreColor }}" stroke-width="3"
                        stroke-dasharray="{{ score }}, 100"/>
            </svg>
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                        font-size:2rem; font-weight:700; color:{{ scoreColor }};">
                {{ score }}
            </div>
        </div>
        <p style="margin-top:10px; font-weight:600; color:{{ scoreColor }};">Score de santé de la plateforme</p>
    </div>

    {# KPIs #}
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:15px; padding:20px;">
        <div style="background:rgba(46,196,182,0.1); border-radius:12px; padding:20px; text-align:center;">
            <div style="font-size:2rem; font-weight:700; color:#2ec4b6;">{{ rapport.donnees.total }}</div>
            <div style="color:#6c757d; font-size:0.85rem;">Total utilisateurs</div>
        </div>
        <div style="background:rgba(40,167,69,0.1); border-radius:12px; padding:20px; text-align:center;">
            <div style="font-size:2rem; font-weight:700; color:#28a745;">+{{ rapport.donnees.nouveaux_semaine }}</div>
            <div style="color:#6c757d; font-size:0.85rem;">Nouveaux cette semaine</div>
        </div>
        <div style="background:rgba(255,65,108,0.1); border-radius:12px; padding:20px; text-align:center;">
            <div style="font-size:2rem; font-weight:700; color:#ff416c;">{{ rapport.donnees.bloques }}</div>
            <div style="color:#6c757d; font-size:0.85rem;">Bloqués</div>
        </div>
        <div style="background:rgba(255,193,7,0.1); border-radius:12px; padding:20px; text-align:center;">
            <div style="font-size:2rem; font-weight:700; color:#ffc107;">{{ rapport.donnees.croissance }}%</div>
            <div style="color:#6c757d; font-size:0.85rem;">Croissance mensuelle</div>
        </div>
        <div style="background:rgba(102,16,242,0.1); border-radius:12px; padding:20px; text-align:center;">
            <div style="font-size:2rem; font-weight:700; color:#6610f2;">{{ rapport.prediction.valeur }}</div>
            <div style="color:#6c757d; font-size:0.85rem;">Prédiction mois prochain</div>
        </div>
    </div>

    {# Prédiction ML #}
    <div style="margin:20px; padding:20px; background:rgba(102,16,242,0.08); border-radius:12px; border-left:4px solid #6610f2;">
        <h4>🔮 Prédiction — {{ rapport.prediction.methode }}</h4>
        <p>Le modèle prédit <strong>{{ rapport.prediction.nouveaux_predit }} nouveaux utilisateurs</strong> le mois prochain.</p>
        <p>Total estimé : <strong>{{ rapport.prediction.valeur }} utilisateurs</strong></p>
        <p style="color:#6c757d; font-size:0.85rem;">
            📐 Méthode : {{ rapport.prediction.equation ?? 'Régression Linéaire' }} |
            🎯 Confiance : {{ rapport.prediction.confiance }}%
        </p>
        {# Barre de confiance #}
        <div style="background:#e9ecef; border-radius:4px; height:8px; margin-top:10px;">
            <div style="background:#6610f2; height:100%; border-radius:4px; width:{{ rapport.prediction.confiance }}%;"></div>
        </div>
    </div>

    {# Tendances #}
    <div style="margin:20px; padding:20px; background:rgba(46,196,182,0.08); border-radius:12px; border-left:4px solid {{ rapport.tendances.couleur }};">
        <h4>📈 Analyse des Tendances</h4>
        <p>{{ rapport.tendances.description }}</p>
        <div style="display:flex; gap:20px; margin-top:10px; flex-wrap:wrap;">
            <div>
                <strong>Moyenne début :</strong> {{ rapport.tendances.moyenne_debut }} inscriptions/mois
            </div>
            <div>
                <strong>Moyenne récente :</strong> {{ rapport.tendances.moyenne_fin }} inscriptions/mois
            </div>
            <div>
                <strong>Meilleur mois :</strong> {{ rapport.tendances.meilleur_mois }}
            </div>
        </div>
    </div>

    {# Anomalies #}
    <div style="margin:20px; padding:20px; background:rgba(255,193,7,0.08); border-radius:12px; border-left:4px solid #ffc107;">
        <h4>⚠️ Détection d'Anomalies (Z-Score)</h4>
        <p>{{ rapport.anomalies.message }} — Moyenne : {{ rapport.anomalies.moyenne }} | Écart-type : {{ rapport.anomalies.ecart_type }}</p>
        {% if rapport.anomalies.anomalies|length > 0 %}
            <table style="width:100%; margin-top:10px; border-collapse:collapse;">
                <thead>
                    <tr style="background:rgba(255,193,7,0.2);">
                        <th style="padding:8px; text-align:left;">Jour</th>
                        <th style="padding:8px; text-align:left;">Inscriptions</th>
                        <th style="padding:8px; text-align:left;">Z-Score</th>
                        <th style="padding:8px; text-align:left;">Type</th>
                    </tr>
                </thead>
                <tbody>
                    {% for anomalie in rapport.anomalies.anomalies %}
                        <tr style="border-bottom:1px solid #e9ecef;">
                            <td style="padding:8px;">{{ anomalie.jour }}</td>
                            <td style="padding:8px;">{{ anomalie.valeur }}</td>
                            <td style="padding:8px;">{{ anomalie.z_score }}</td>
                            <td style="padding:8px;">
                                {% if anomalie.type == 'pic' %}
                                    <span style="color:#28a745;">📈 Pic</span>
                                {% else %}
                                    <span style="color:#dc3545;">📉 Creux</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {# Répartition par rôle #}
    <div style="margin:20px; padding:20px; background:rgba(108,117,125,0.08); border-radius:12px;">
        <h4>👥 Répartition par rôle</h4>
        <div style="display:flex; gap:15px; flex-wrap:wrap; margin-top:10px;">
            {% for role, count in rapport.donnees.par_role %}
                {% set total = rapport.donnees.total %}
                {% set pct = total > 0 ? ((count / total) * 100)|round(1) : 0 %}
                <div style="background:white; border-radius:8px; padding:15px 20px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.08); min-width:120px;">
                    <div style="font-size:1.8rem; font-weight:700; color:#2ec4b6;">{{ count }}</div>
                    <div style="color:#6c757d; font-size:0.85rem; text-transform:capitalize;">{{ role }}</div>
                    <div style="font-size:0.75rem; color:#adb5bd;">{{ pct }}%</div>
                    <div style="background:#e9ecef; border-radius:4px; height:4px; margin-top:6px;">
                        <div style="background:#2ec4b6; height:100%; border-radius:4px; width:{{ pct }}%;"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Bouton actualiser #}
    <div style="text-align:center; padding:20px;">
        <a href="{{ path('admin_rapport_index') }}"
           style="background:linear-gradient(135deg,#2ec4b6,#1b9aaa); color:white;
                  padding:12px 30px; border-radius:10px; text-decoration:none; font-weight:600;">
            🔄 Actualiser le rapport
        </a>
    </div>

</section>
{% endblock %}