{{ form_start(form) }}
    <div class="form-grid">
        <div class="form-group-settings {% if form.date_mission.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.date_mission, null, {'label_attr': {'class': 'form-label'}}) }}
            <span class="form-required">*</span>
            {{ form_widget(form.date_mission, {'attr': {'class': 'form-input form-date', 'required': 'required'}}) }}
            {% if form.date_mission.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.date_mission) }}
                </div>
            {% endif %}
        </div>

