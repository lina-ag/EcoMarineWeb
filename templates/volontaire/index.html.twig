{% extends 'base_admin.html.twig' %}

{% block title %}Volontaire index{% endblock %}
{% block page_title %}Volontaires{% endblock %}
{% block navbar_title %}Gestion des volontaires{% endblock %}

{% block admin_content %}
    <section class="glass-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Volontaires</h2>
                <p class="card-subtitle">Gestion des volontaires des actions de nettoyage.</p>
            </div>
            <a href="{{ path('app_volontaire_new') }}" class="btn btn-primary">Create new</a>
        </div>

        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nom</th>
                        <th>Contact</th>
                        <th>Action</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for volontaire in volontaires %}
                    <tr>
                        <td>{{ volontaire.idVolontaire }}</td>
                        <td>{{ volontaire.nom }}</td>
                        <td>{{ volontaire.contact }}</td>
                        <td>
                            {% if volontaire.idAction %}
                                {{ volontaire.idAction.lieu }} - {{ volontaire.idAction.dateAction|date('Y-m-d') }}
                            {% else %}
                                Aucune
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_volontaire_show', {'id_volontaire': volontaire.id_volontaire}) }}" class="btn btn-secondary">show</a>
                            <a href="{{ path('app_volontaire_edit', {'id_volontaire': volontaire.id_volontaire}) }}" class="btn btn-primary">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-4">
            {{ knp_pagination_render(volontaires, 'admin/_pagination.html.twig') }}
        </div>
    </section>
{% endblock %}
