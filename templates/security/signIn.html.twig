{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .auth-page {
            background: none;
            min-height: 100vh;
            color: #fff;
        }
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .auth-card {
            width: 100%;
            max-width: 450px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
            backdrop-filter: blur(18px);
            border-radius: 24px;
            padding: 34px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .auth-card h2 {
            margin-bottom: 1rem;
            font-size: 2rem;
            font-weight: 700;
            color: #ffffff;
            width: 100%;
            text-align: center;
        }
        .auth-card p {
            color: rgba(255, 255, 255, 0.82);
            margin-bottom: 1.8rem;
            text-align: center;
            width: 100%;
        }
        .auth-card form {
            width: 100%;
        }
        .auth-card .form-control {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.28);
            color: #fff;
            box-shadow: none;
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 1rem;
            width: 100%;
            text-align: left;
        }
        .auth-card .form-control:focus {
            border-color: rgba(255, 255, 255, 0.78);
            box-shadow: 0 0 0 0.2rem rgba(173, 214, 255, 0.25);
            background: rgba(255, 255, 255, 0.16);
            color: #fff;
        }
        .auth-card label {
            display: block;
            margin-bottom: 0.4rem;
            color: rgba(255, 255, 255, 0.88);
            font-weight: 500;
            text-align: center;
            width: 100%;
        }
        .auth-card .btn {
            border-radius: 14px;
            padding: 12px 18px;
            font-weight: 700;
            letter-spacing: 0.02em;
            width: 100%;
            text-align: center;
        }
        .auth-card .btn-primary {
            background: linear-gradient(135deg, #26b0a3, #168a96);
            border: none;
            color: white;
        }
        .auth-card .btn-primary:hover {
            background: linear-gradient(135deg, #1f8a82, #0e6e78);
            transform: translateY(-2px);
        }
        .auth-card .text-center {
            margin-top: 1rem;
            color: rgba(255, 255, 255, 0.85);
            text-align: center;
            width: 100%;
        }
        .auth-card .text-center a {
            color: #ffffff;
            text-decoration: underline;
        }
        .auth-card .alert {
            width: 100%;
            text-align: center;
        }
        .divider {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            margin: 1rem 0;
            color: rgba(255,255,255,0.6);
        }
        .video-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }
        .face-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.65);
            z-index: 10000;
            align-items: center;
            justify-content: center;
        }
        .face-modal-content {
            background: white;
            border-radius: 24px;
            padding: 40px;
            max-width: 520px;
            width: 90%;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .face-modal-content h3 {
            color: #168a96;
            margin-bottom: 10px;
            text-align: center;
        }
        .face-modal-content p {
            text-align: center;
            margin-bottom: 10px;
        }
        .face-modal-content video {
            width: 100%;
            height: 280px;
            border-radius: 12px;
            margin-bottom: 15px;
            background: #000;
            transform: scaleX(-1);
            object-fit: cover;
            display: block;
        }
        .modal-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 15px;
            flex-wrap: wrap;
            width: 100%;
        }
        .btn-capture {
            background: linear-gradient(135deg, #26b0a3, #168a96);
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-size: 15px;
            transition: all 0.3s ease;
            width: 200px;
        }
        .btn-capture:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40,167,69,0.4);
        }
        .btn-capture:disabled {
            background: #aaa;
            cursor: not-allowed;
            opacity: 0.6;
        }
        .btn-cancel {
            background: #6c757d;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-size: 15px;
            transition: all 0.3s;
            width: 200px;
        }
        .btn-cancel:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }
        .modal-message {
            margin: 12px 0;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            text-align: center;
            width: 100%;
        }
        .modal-message.info { background: #cce5ff; color: #004085; }
        .modal-message.success { background: #d4edda; color: #155724; }
        .modal-message.error { background: #f8d7da; color: #721c24; }
        .modal-message.loading { background: #fff3cd; color: #856404; }
    </style>
{% endblock %}

{% block body %}
<video autoplay muted loop class="video-bg">
    <source src="/assets/images/video-bg.mp4" type="video/mp4">
</video>

<div class="auth-container auth-page">
    <div class="auth-card">
        <h2>Connexion</h2>
        <p>Entrez vos identifiants pour accéder à votre espace.</p>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger" style="width:100%; text-align:center;">{{ message }}</div>
        {% endfor %}

        <form method="post" style="width:100%;">
            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" required>
            </div>

            <div class="mb-3">
                <label>Mot de passe</label>
                <input type="password" name="password" class="form-control" required>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Se connecter
            </button>

            <div class="divider">ou</div>

            <button type="button" id="faceLoginBtn" class="btn btn-primary w-100" onclick="openFaceLoginModal(event)" style="background: linear-gradient(135deg, #2ec4b6, #1b9aaa);">
                Se connecter avec le visage
            </button>
        </form>

        <div class="text-center mt-2">
            <a href="{{ path('app_forgot_password') }}" style="color:rgba(255,255,255,0.7); font-size:0.9rem;">
                Mot de passe oublié ?
            </a>
        </div>
        <div class="text-center mt-3">
            <a href="{{ path('app_signUp') }}">Créer un compte</a>
        </div>
    </div>
</div>

<div id="faceModal" class="face-modal">
    <div class="face-modal-content">
        <h3>Reconnaissance faciale</h3>
        <p style="color:#495057;">Placez-vous face à la caméra</p>

        <video id="faceVideo" autoplay playsinline muted></video>
        <canvas id="faceCanvas" style="display:none;"></canvas>

        <div id="modalMessage" class="modal-message info">Activation de la caméra...</div>

        <div class="modal-buttons">
            <button id="captureFaceBtn" class="btn-capture" disabled>
                Scanner mon visage
            </button>
            <button id="closeModalBtn" class="btn-cancel">
                Annuler
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const faceLoginBtn = document.getElementById('faceLoginBtn');
    const faceModal = document.getElementById('faceModal');
    const faceVideo = document.getElementById('faceVideo');
    const faceCanvas = document.getElementById('faceCanvas');
    const captureFaceBtn = document.getElementById('captureFaceBtn');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalMessage = document.getElementById('modalMessage');

    let mediaStream = null;

    function setMessage(type, text) {
        modalMessage.className = 'modal-message ' + type;
        modalMessage.textContent = text;
    }

    async function startFaceLogin() {
        faceModal.style.display = 'flex';
        setMessage('info', 'Demande d\'acces a la camera...');
        captureFaceBtn.disabled = true;

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            setMessage('error', 'Camera non supportee par ce navigateur.');
            return;
        }

        if (!window.isSecureContext && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
            setMessage('error', 'La camera demande HTTPS ou localhost.');
            return;
        }

        try {
            mediaStream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' }
            });

            faceVideo.srcObject = mediaStream;
            await new Promise((resolve) => {
                faceVideo.onloadedmetadata = resolve;
            });
            await faceVideo.play();

            captureFaceBtn.disabled = false;
            setMessage('success', 'Camera activee. Cliquez sur "Scanner mon visage".');
        } catch (err) {
            setMessage('error', 'Impossible d\'acceder a la camera : ' + err.message);
        }
    }

    function closeModal() {
        faceModal.style.display = 'none';
        if (mediaStream) {
            mediaStream.getTracks().forEach(track => track.stop());
            mediaStream = null;
        }
        faceVideo.srcObject = null;
        captureFaceBtn.disabled = true;
        setMessage('info', 'Activation de la camera...');
    }

    window.openFaceLoginModal = async function (event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        await startFaceLogin();
    };

    if (faceLoginBtn) {
        faceLoginBtn.addEventListener('click', window.openFaceLoginModal);
    }

    captureFaceBtn.addEventListener('click', function () {
        if (!mediaStream) {
            setMessage('error', 'Camera non disponible.');
            return;
        }

        const ctx = faceCanvas.getContext('2d');
        faceCanvas.width = faceVideo.videoWidth;
        faceCanvas.height = faceVideo.videoHeight;
        ctx.drawImage(faceVideo, 0, 0, faceCanvas.width, faceCanvas.height);

        const imageData = faceCanvas.toDataURL('image/jpeg');
        captureFaceBtn.disabled = true;
        setMessage('loading', 'Analyse du visage en cours...');

        fetch('{{ path('face_recognize') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: imageData })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                setMessage('success', data.message || 'Connexion reussie. Redirection...');
                setTimeout(() => {
                    window.location.href = data.redirect;
                }, 1500);
            } else {
                setMessage('error', data.message || 'Visage non reconnu.');
                captureFaceBtn.disabled = false;
            }
        })
        .catch(() => {
            setMessage('error', 'Erreur lors de la reconnaissance. Reessayez.');
            captureFaceBtn.disabled = false;
        });
    });

    closeModalBtn.addEventListener('click', closeModal);
    faceModal.addEventListener('click', function (event) {
        if (event.target === faceModal) {
            closeModal();
        }
    });
});
</script>
{% endblock %}
