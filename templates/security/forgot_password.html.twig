
{% block title %}Mot de passe oublié{% endblock %}

{% block stylesheets %}
    
    <style>
        .auth-page {
            background: none;
            min-height: 100vh;
            color: #6c757d;
        }
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .auth-card {
            width: 100%;
            max-width: 450px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 24px;
            padding: 34px 32px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
        }
        .auth-card h2 {
            margin-bottom: 0.5rem;
            font-size: 1.8rem;
            font-weight: 700;
            color: #1e3c72;
        }
        .auth-card p {
            color: #6c757d;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
        }
        .form-group {
            margin-bottom: 1rem;
        }
        .auth-card .form-control {
            background: #ffffff;
            border: 1px solid #dee2e6;
            color: #495057;
            border-radius: 12px;
            padding: 12px 16px;
            width: 100%;
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        .auth-card .form-control:focus {
            border-color: #2ec4b6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(46, 196, 182, 0.1);
        }
        .auth-card label {
            display: block;
            margin-bottom: 0.5rem;
            color: #495057;
            font-weight: 500;
            font-size: 0.85rem;
        }
        .form-text {
            display: block;
            margin-top: 0.25rem;
            font-size: 0.75rem;
            color: #6c757d;
        }
        .text-danger {
            color: #dc3545 !important;
        }
        .auth-card .btn {
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            width: 100%;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9rem;
        }
        .auth-card .btn-primary {
            background: linear-gradient(135deg, #2ec4b6, #1b9aaa);
            color: white;
        }
        .auth-card .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(46, 196, 182, 0.3);
        }
        .auth-card .text-center {
            text-align: center;
            margin-top: 1rem;
        }
        .auth-card .text-center a {
            color: #2ec4b6;
            text-decoration: none;
            font-size: 0.85rem;
        }
        .auth-card .text-center a:hover {
            text-decoration: underline;
        }
        .video-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }
        .alert {
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }
        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
    </style>
{% endblock %}

{% block body %}
<video autoplay muted loop class="video-bg">
    <source src="/assets/images/video-bg.mp4" type="video/mp4">
</video>
<div class="auth-container auth-page">
    <div class="auth-card">
        <h2>Mot de passe oublié</h2>
        <p>Saisissez votre email pour recevoir un lien de réinitialisation</p>

        {% for msg in app.flashes('success') %}
            <div class="alert alert-success">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="alert alert-danger">{{ msg }}</div>
        {% endfor %}

        <form method="post" novalidate id="forgotForm">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" class="form-control" placeholder="exemple@gmail.com" required>
                <div id="emailError" class="text-danger" style="font-size:0.85rem; display:none; margin-top:5px;"></div>
                <small class="form-text text-muted">Seules les adresses Gmail sont acceptées</small>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3">
                Envoyer le lien de réinitialisation
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="{{ path('app_signIn') }}">Retour à la connexion</a>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('forgotForm');
    const emailInput = document.getElementById('email');
    const emailError = document.getElementById('emailError');

    if (!form || !emailInput || !emailError) {
        return;
    }

    form.addEventListener('submit', function (event) {
        const email = emailInput.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        emailError.style.display = 'none';
        emailError.textContent = '';

        if (!email) {
            event.preventDefault();
            emailError.textContent = "L'email est obligatoire.";
            emailError.style.display = 'block';
            return;
        }

        if (!emailRegex.test(email)) {
            event.preventDefault();
            emailError.textContent = 'Veuillez entrer une adresse email valide.';
            emailError.style.display = 'block';
            return;
        }

        if (!email.endsWith('@gmail.com')) {
            event.preventDefault();
            emailError.textContent = 'Seules les adresses Gmail sont acceptées.';
            emailError.style.display = 'block';
        }
    });
});
</script>
{% endblock %}
