{% block body %}
<video autoplay muted loop class="video-bg">
    <source src="/assets/images/video-bg.mp4" type="video/mp4">
</video>
<div class="auth-container auth-page">
    <div class="auth-card">
        <h2>🔑 Nouveau mot de passe</h2>
        <p>Choisissez un mot de passe sécurisé pour votre compte</p>

        {% for msg in app.flashes('error') %}
            <div class="alert alert-danger">{{ msg }}</div>
        {% endfor %}
        
        {% for msg in app.flashes('success') %}
            <div class="alert alert-success">{{ msg }}</div>
        {% endfor %}

        <form method="post" novalidate id="resetForm">
            <div class="form-group">
                <label for="password">Nouveau mot de passe</label>
                <input type="password" name="password" id="password" class="form-control" placeholder="Minimum 8 caractères" required>
                <div id="passwordError" class="text-danger" style="font-size:0.85rem; display:none; margin-top:5px;"></div>
                <div id="passwordStrength" class="password-strength mt-1"></div>
            </div>
            
            <div class="form-group mt-3">
                <label for="confirm_password">Confirmer le mot de passe</label>
                <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Répétez le mot de passe" required>
                <div id="confirmError" class="text-danger" style="font-size:0.85rem; display:none; margin-top:5px;"></div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                🔐 Réinitialiser le mot de passe
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="{{ path('app_signIn') }}">← Retour à la connexion</a>
        </div>
    </div>
</div>

<style>
    .auth-page {
        background: none;
        min-height: 100vh;
        color: #6c757d;
    }
    .auth-container {
        min-height: calc(100vh - 0px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }
    .auth-card {
        width: 100%;
        max-width: 450px;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 24px;
        padding: 34px 32px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
    }
    .auth-card h2 {
        margin-bottom: 0.5rem;
        font-size: 1.8rem;
        font-weight: 700;
        color: #1e3c72;
    }
    .auth-card p {
        color: #6c757d;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }
    .form-group {
        margin-bottom: 0.5rem;
    }
    .auth-card .form-control {
        background: #ffffff;
        border: 1px solid #dee2e6;
        color: #495057;
        border-radius: 12px;
        padding: 12px 16px;
        width: 100%;
        font-size: 0.9rem;
        transition: all 0.3s;
    }
    .auth-card .form-control:focus {
        border-color: #2ec4b6;
        outline: none;
        box-shadow: 0 0 0 3px rgba(46, 196, 182, 0.1);
    }
    .auth-card label {
        display: block;
        margin-bottom: 0.5rem;
        color: #495057;
        font-weight: 500;
        font-size: 0.85rem;
    }
    .form-text {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.75rem;
        color: #6c757d;
    }
    .text-danger {
        color: #dc3545 !important;
    }
    .password-strength {
        margin-top: 5px;
        font-size: 0.75rem;
    }
    .auth-card .btn {
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 600;
        width: 100%;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
    }
    .auth-card .btn-primary {
        background: linear-gradient(135deg, #2ec4b6, #1b9aaa);
        color: white;
    }
    .auth-card .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(46, 196, 182, 0.3);
    }
    .auth-card .text-center {
        text-align: center;
        margin-top: 1rem;
    }
    .auth-card .text-center a {
        color: #2ec4b6;
        text-decoration: none;
        font-size: 0.85rem;
    }
    .auth-card .text-center a:hover {
        text-decoration: underline;
    }
    .video-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }
    .alert {
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 1rem;
        font-size: 0.85rem;
    }
    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    .mt-1 { margin-top: 0.25rem; }
    .mt-2 { margin-top: 0.5rem; }
    .mt-3 { margin-top: 1rem; }
    .mt-4 { margin-top: 1.5rem; }
    .mb-3 { margin-bottom: 1rem; }
</style>

<script>
document.getElementById('password').addEventListener('input', function() {
    const password = this.value;
    const strengthDiv = document.getElementById('passwordStrength');
    
    if (password.length === 0) { 
        strengthDiv.textContent = ''; 
        return; 
    }
    
    let score = 0;
    if (password.length >= 8) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;
    
    let strengthText = '';
    let strengthColor = '';
    
    if (score === 1) { strengthText = '🔴 Faible'; strengthColor = '#dc3545'; }
    else if (score === 2) { strengthText = '🟠 Moyen'; strengthColor = '#fd7e14'; }
    else if (score === 3) { strengthText = '🟡 Bon'; strengthColor = '#e6b800'; }
    else if (score >= 4) { strengthText = '🟢 Très fort'; strengthColor = '#28a745'; }
    
    strengthDiv.textContent = 'Force : ' + strengthText;
    strengthDiv.style.color = strengthColor;
});

document.getElementById('resetForm').addEventListener('submit', function(e) {
    const password = document.getElementById('password').value;
    const confirm = document.getElementById('confirm_password').value;
    const passwordError = document.getElementById('passwordError');
    const confirmError = document.getElementById('confirmError');
    
    passwordError.style.display = 'none';
    confirmError.style.display = 'none';

    if (password.length < 8) {
        e.preventDefault();
        passwordError.textContent = 'Le mot de passe doit contenir au moins 8 caractères.';
        passwordError.style.display = 'block';
        return;
    }

    if (!/[A-Z]/.test(password)) {
        e.preventDefault();
        passwordError.textContent = 'Le mot de passe doit contenir au moins une majuscule.';
        passwordError.style.display = 'block';
        return;
    }

    if (!/[0-9]/.test(password)) {
        e.preventDefault();
        passwordError.textContent = 'Le mot de passe doit contenir au moins un chiffre.';
        passwordError.style.display = 'block';
        return;
    }

    if (password !== confirm) {
        e.preventDefault();
        confirmError.textContent = 'Les mots de passe ne correspondent pas.';
        confirmError.style.display = 'block';
        return;
    }
});
</script>
{% endblock %}