{{ form_start(form) }}
    <div class="form-grid">
        <div class="form-group-settings {% if form.espece.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.espece, null, {'label_attr': {'class': 'form-label'}}) }}
            <span class="form-required">*</span>
            {{ form_widget(form.espece, {'attr': {'class': 'form-input', 'required': 'required'}}) }}
            {% if form.espece.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.espece) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings {% if form.etat.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.etat, null, {'label_attr': {'class': 'form-label'}}) }}
            <span class="form-required">*</span>
            {{ form_widget(form.etat, {'attr': {'class': 'form-input form-select', 'required': 'required'}}) }}
            {% if form.etat.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.etat) }}
                </div>
            {% endif %}
        </div>

        <div class="form-group-settings full-width {% if form.description.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-input', 'rows': 5}}) }}
            <small class="form-help-text">Maximum 500 mots (~3000 caractères)</small>
            {% if form.description.vars.errors|length > 0 %}
                <div class="form-error-message">
                    {{ form_errors(form.description) }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="btn-group">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('app_faune_marine_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>

    {{ form_rest(form) }}
{{ form_end(form) }}
