{% extends 'base.html.twig' %}

{% block title %}Statistiques Déchets{% endblock %}

{% block body %}
    <section class="glass-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Statistiques pollution</h2>
                <p class="card-subtitle">Vue d’ensemble moderne des signalements de déchets.</p>
            </div>
            <div class="btn-group">
                <a href="{{ path('app_dechet_index') }}" class="btn btn-secondary">Retour à la liste</a>
                <a href="{{ path('app_dechet_export_csv') }}" class="btn btn-secondary">Exporter CSV</a>
                <button onclick="window.print()" class="btn btn-primary" type="button">Imprimer</button>
            </div>
        </div>

        <div class="glass-card" style="margin-bottom: 20px; border-left: 4px solid #3b82f6;">
            <h3>💡 Insight intelligent</h3>
            <p>{{ insight }}</p>
        </div>

        <div class="table-wrapper" style="margin-bottom: 20px;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Total des signalements</th>
                        <th>Quantité totale signalée</th>
                        <th>Type le plus fréquent</th>
                        <th>Zone la plus touchée</th>
                        <th>Progression nettoyage</th>
                        <th>Impact visuel</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ totalDechets }}</td>
                        <td>{{ totalQuantite }}</td>
                        <td>{{ topType }}</td>
                        <td>{{ topZone }}</td>
                        <td>{{ progressionNettoyage }}%</td>
                        <td>
                            {% if impact == 'Critique' %}
                                <span class="btn btn-primary">Critique</span>
                            {% elseif impact == 'Modéré' %}
                                <span class="btn btn-secondary">Modéré</span>
                            {% else %}
                                <span class="btn btn-secondary">Faible</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="table-wrapper" style="margin-bottom: 20px;">
            <h3>🏖️ Top 3 zones les plus polluées</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Rang</th>
                        <th>Zone</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody>
                    {% set rang = 1 %}
                    {% for zone, nombre in zoneRanking %}
                        <tr>
                            <td>#{{ rang }}</td>
                            <td>{{ zone }}</td>
                            <td>{{ nombre }}</td>
                        </tr>
                        {% set rang = rang + 1 %}
                    {% else %}
                        <tr>
                            <td colspan="3">Aucune donnée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="glass-card" style="margin-bottom: 20px;">
            <canvas id="dechetChart" height="100"></canvas>
        </div>

        <div class="table-wrapper" style="margin-top: 20px;">
            <h3>Répartition par type</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody>
                    {% for type, nombre in parType %}
                        <tr>
                            <td>{{ type }}</td>
                            <td>{{ nombre }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2">Aucune donnée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="table-wrapper" style="margin-top: 20px;">
            <h3>Répartition par zone</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Zone</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody>
                    {% for zone, nombre in parZone %}
                        <tr>
                            <td>{{ zone }}</td>
                            <td>{{ nombre }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2">Aucune donnée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="table-wrapper" style="margin-top: 20px;">
            <h3>Répartition par statut</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Statut</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody>
                    {% for statut, nombre in parStatut %}
                        <tr>
                            <td>{{ statut }}</td>
                            <td>{{ nombre }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2">Aucune donnée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('dechetChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: {{ chartLabels|json_encode|raw }},
                    datasets: [{
                        label: 'Déchets par type',
                        data: {{ chartValues|json_encode|raw }}
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true }
                    }
                }
            });
        }
    </script>
{% endblock %}