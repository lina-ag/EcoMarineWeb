{% extends 'base.html.twig' %}

{% block title %}Gestion des déchets{% endblock %}

{% block body %}
    <section class="glass-card">
        <div class="card-header" style="display:flex; flex-wrap:wrap; gap:20px; align-items:flex-start; justify-content:space-between;">
            <div style="min-width:260px; flex:1 1 320px;">
                <h2 class="card-title">Gestion des déchets</h2>
                <p class="card-subtitle">Suivi moderne des signalements sur les plages.</p>
            </div>

            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; flex:1 1 700px; max-width:900px;">
                <a href="{{ path('app_dechet_new') }}" class="btn btn-primary">+ Ajouter un signalement</a>
                <a href="{{ path('app_dechet_stats') }}" class="btn btn-secondary">Statistiques</a>
                <a href="{{ path('app_dechet_export_csv') }}" class="btn btn-secondary">Exporter CSV</a>
                <a href="{{ path('app_dechet_index', {'demo': 1}) }}" class="btn btn-secondary">Mode démo</a>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="glass-card" style="margin-bottom: 16px; border-left: 4px solid #22c55e;">
                <strong>Succès :</strong> {{ message }}
            </div>
        {% endfor %}

        <div class="table-wrapper" style="margin-bottom: 24px; overflow-x:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Total signalements</th>
                        <th>Quantité totale</th>
                        <th>Zones touchées</th>
                        <th>Pollution élevée</th>
                        <th>Progression nettoyage</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ statsCards.totalSignalements }}</td>
                        <td>{{ statsCards.totalQuantite }}</td>
                        <td>{{ statsCards.zonesTouchees }}</td>
                        <td>{{ statsCards.pollutionElevee }}</td>
                        <td>{{ statsCards.progressionNettoyage }}%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="table-wrapper" style="margin-bottom: 24px; overflow-x:auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Signalé</th>
                        <th>En cours</th>
                        <th>Traité</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ statusCounts.signale }}</td>
                        <td>{{ statusCounts.en_cours }}</td>
                        <td>{{ statusCounts.traite }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <form method="get" style="margin-bottom:24px;">
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px;">
                <input type="text" name="q" value="{{ filters.q }}" placeholder="Recherche globale..." class="form-input">

                <select name="type" class="form-input" style="color:#ffffff;background:rgba(255,255,255,0.08);font-weight:600;">
                    <option value="">🧩 Tous les types</option>
                    <option value="plastique" {% if filters.type == 'plastique' %}selected{% endif %}>♻️ Plastique</option>
                    <option value="verre" {% if filters.type == 'verre' %}selected{% endif %}>🧴 Verre</option>
                    <option value="metal" {% if filters.type == 'metal' %}selected{% endif %}>🔩 Métal</option>
                    <option value="organique" {% if filters.type == 'organique' %}selected{% endif %}>🍃 Organique</option>
                    <option value="papier" {% if filters.type == 'papier' %}selected{% endif %}>📄 Papier</option>
                    <option value="autre" {% if filters.type == 'autre' %}selected{% endif %}>🗑️ Autre</option>
                </select>

                <select name="statut" class="form-input" style="color:#ffffff;background:rgba(255,255,255,0.08);font-weight:600;">
                    <option value="">📌 Tous les statuts</option>
                    <option value="signale" {% if filters.statut == 'signale' %}selected{% endif %}>🚨 Signalé</option>
                    <option value="en_cours" {% if filters.statut == 'en_cours' %}selected{% endif %}>⏳ En cours</option>
                    <option value="traite" {% if filters.statut == 'traite' %}selected{% endif %}>✅ Traité</option>
                </select>

                <input type="text" name="zone" value="{{ filters.zone }}" placeholder="Filtrer par zone..." class="form-input">

                <select name="sort" class="form-input" style="color:#ffffff;background:rgba(255,255,255,0.08);font-weight:600;">
                    <option value="date" {% if filters.sort == 'date' %}selected{% endif %}>📅 Trier par date</option>
                    <option value="type" {% if filters.sort == 'type' %}selected{% endif %}>🧩 Trier par type</option>
                    <option value="quantite" {% if filters.sort == 'quantite' %}selected{% endif %}>📦 Trier par quantité</option>
                    <option value="zone" {% if filters.sort == 'zone' %}selected{% endif %}>🏖️ Trier par zone</option>
                    <option value="statut" {% if filters.sort == 'statut' %}selected{% endif %}>📌 Trier par statut</option>
                </select>

                <select name="direction" class="form-input" style="color:#ffffff;background:rgba(255,255,255,0.08);font-weight:600;">
                    <option value="desc" {% if filters.direction == 'desc' %}selected{% endif %}>⬇️ Desc</option>
                    <option value="asc" {% if filters.direction == 'asc' %}selected{% endif %}>⬆️ Asc</option>
                </select>
            </div>

            <div class="btn-group" style="margin-top:16px; display:flex; flex-wrap:wrap; gap:12px;">
                <button class="btn btn-primary" type="submit">Filtrer</button>
                <a href="{{ path('app_dechet_index') }}" class="btn btn-secondary">Réinitialiser</a>
            </div>
        </form>

        {% if dechets is empty %}
            <div class="glass-card" style="text-align:center;">
                <h3>🗑️ Aucun signalement trouvé</h3>
                <p>Commencez par ajouter un nouveau signalement de déchet.</p>
                <a href="{{ path('app_dechet_new') }}" class="btn btn-primary">Ajouter un signalement</a>
            </div>
        {% else %}
            <div class="table-wrapper" style="overflow-x:auto;">
                <table class="data-table" style="min-width:1200px;">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Type</th>
                            <th>Quantité</th>
                            <th>Zone</th>
                            <th>Date</th>
                            <th>Signalement</th>
                            <th>Statut</th>
                            <th>Niveau pollution</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for dechet in dechets %}
                        {% set quantite = dechet.quantite ?? 0 %}
                        {% set daysOld = dechet.dateSignalement ? date().diff(dechet.dateSignalement).days : 0 %}
                        {% set freshness = quantite > 15 ? 'Urgent' : (daysOld <= 2 ? 'Récent' : 'Ancien') %}
                        {% set niveau = quantite <= 5 ? 'Faible' : (quantite <= 15 ? 'Moyenne' : 'Élevée') %}
                        {% set typeIcon = {
                            'plastique': '♻️',
                            'verre': '🧴',
                            'metal': '🔩',
                            'organique': '🍃',
                            'papier': '📄',
                            'autre': '🗑️'
                        }[dechet.type] ?? '🗑️' %}

                        <tr>
                            <td>{{ dechet.idDechet }}</td>
                            <td>
                                {% if dechet.type == 'plastique' %}
                                    <span class="btn btn-primary">{{ typeIcon }} {{ dechet.type|capitalize }}</span>
                                {% else %}
                                    <span class="btn btn-secondary">{{ typeIcon }} {{ dechet.type|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td>{{ dechet.quantite }}</td>
                            <td>{{ dechet.zone }}</td>
                            <td>{{ dechet.dateSignalement ? dechet.dateSignalement|date('Y-m-d') : '' }}</td>
                            <td>
                                {% if freshness == 'Urgent' %}
                                    <span class="btn btn-primary">Urgent</span>
                                {% elseif freshness == 'Récent' %}
                                    <span class="btn btn-secondary">Récent</span>
                                {% else %}
                                    <span class="btn btn-secondary">Ancien</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if dechet.statut == 'signale' %}
                                    <span class="btn btn-secondary">Signalé</span>
                                {% elseif dechet.statut == 'en_cours' %}
                                    <span class="btn btn-secondary">En cours</span>
                                {% else %}
                                    <span class="btn btn-primary">Traité</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if niveau == 'Faible' %}
                                    <span class="btn btn-secondary">Faible</span>
                                {% elseif niveau == 'Moyenne' %}
                                    <span class="btn btn-secondary">Moyenne</span>
                                {% else %}
                                    <span class="btn btn-primary">Élevée</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                    <a href="{{ path('app_dechet_show', {'id_dechet': dechet.id_dechet}) }}" class="btn btn-secondary">Voir</a>
                                    <a href="{{ path('app_dechet_edit', {'id_dechet': dechet.id_dechet}) }}" class="btn btn-primary">Modifier</a>

                                    {% if dechet.statut != 'traite' %}
                                        <form method="post" action="{{ path('app_dechet_traiter', {'id_dechet': dechet.id_dechet}) }}" style="display:inline-block;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('traiter' ~ dechet.id_dechet) }}">
                                            <button class="btn btn-primary" type="submit">Marquer traité</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}