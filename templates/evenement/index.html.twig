{% extends 'base.html.twig' %}

{% block title %}Evenements{% endblock %}

{% block body %}
<link rel="stylesheet" href="/assets_admin/module-plage.css">
<style>
    .event-page { display: grid; gap: 24px; }
    .event-hero { position: relative; overflow: hidden; min-height: 440px; padding: 42px; display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 28px; align-items: center; border-radius: 30px; border: 1px solid rgba(167, 139, 250, .22); background: linear-gradient(135deg, rgba(10, 20, 48, .92), rgba(30, 41, 94, .74)), radial-gradient(circle at 82% 18%, rgba(250, 204, 21, .2), transparent 30%), radial-gradient(circle at 18% 80%, rgba(34, 211, 238, .18), transparent 34%); box-shadow: 0 28px 90px rgba(2, 8, 23, .42); }
    .event-kicker { color: #fde68a; font-size: 12px; font-weight: 950; letter-spacing: .18em; text-transform: uppercase; }
    .event-hero h1 { margin: 10px 0 14px; color: #fff; font-size: clamp(42px, 7vw, 76px); line-height: .96; font-weight: 950; }
    .event-hero p { max-width: 720px; color: #e0e7ff; font-size: 18px; line-height: 1.7; }
    .event-stage { position: relative; min-height: 320px; border-radius: 28px; border: 1px solid rgba(255,255,255,.12); background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.025)); overflow: hidden; }
    .event-stage::before { content: ""; position: absolute; inset: auto 8% 12% 8%; height: 36%; border-radius: 50% 50% 0 0; background: linear-gradient(135deg, rgba(34,211,238,.28), rgba(124,58,237,.36)); }
    .event-stage span { position: absolute; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 26px; color: #fff; font-weight: 950; background: linear-gradient(145deg, #f59e0b, #ef4444, #7c3aed); box-shadow: 0 22px 48px rgba(124,58,237,.3); }
    .event-stage span:nth-child(1) { top: 16%; left: 12%; } .event-stage span:nth-child(2) { top: 28%; right: 12%; } .event-stage span:nth-child(3) { bottom: 14%; left: 38%; }
    .event-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .event-kpi, .event-card, .event-insight { border-radius: 22px; padding: 20px; border: 1px solid rgba(148, 163, 184, .16); background: rgba(15, 23, 42, .5); box-shadow: inset 0 1px 0 rgba(255,255,255,.06); }
    .event-kpi .label, .event-insight .label { color: #c4b5fd; font-size: 12px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
    .event-kpi .value { margin-top: 12px; color: #fff; font-size: 40px; font-weight: 950; }
    .event-layout { display: grid; grid-template-columns: minmax(280px, .78fr) minmax(0, 1.22fr); gap: 18px; }
    .event-timeline { display: grid; gap: 12px; }
    .event-step { padding: 16px; border-radius: 18px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1); }
    .event-step strong { color: #fff; display: block; margin-bottom: 6px; } .event-step span { color: #cbd5e1; font-size: 14px; }
    .event-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .event-card { position: relative; overflow: hidden; } .event-card::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 5px; background: linear-gradient(180deg, #f59e0b, #8b5cf6); }
    .event-date { width: fit-content; padding: 8px 12px; border-radius: 999px; color: #fff7ed; background: rgba(245, 158, 11, .16); border: 1px solid rgba(245, 158, 11, .3); font-weight: 850; }
    .event-card h3 { color: #fff; margin: 14px 0 8px; } .event-card p { color: #cbd5e1; line-height: 1.55; }
    .event-location { margin: 12px 0; color: #bfdbfe; font-weight: 850; }
    @media (max-width: 1150px) { .event-hero, .event-layout { grid-template-columns: 1fr; } .event-kpis, .event-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 680px) { .event-hero { padding: 24px; } .event-kpis, .event-grid { grid-template-columns: 1fr; } }
</style>

{% set zones = {} %}
{% set described = 0 %}
{% for evenement in evenements %}
    {% if evenement.lieu %}{% set zones = zones|merge({(evenement.lieu): true}) %}{% endif %}
    {% if evenement.description %}{% set described = described + 1 %}{% endif %}
{% endfor %}

<section class="module-shell event-page">
    <div class="event-hero">
        <div>
            <div class="event-kicker">Agenda bleu</div>
            <h1>Evenements du littoral</h1>
            <p>Organisez les rencontres, ateliers, campagnes de sensibilisation et moments citoyens qui transforment la protection marine en experience collective.</p>
            <div class="module-actions"><a href="{{ path('app_evenement_new') }}" class="btn btn-primary">+ Ajouter un evenement</a><a href="#event-agenda" class="btn btn-secondary">Voir l agenda</a></div>
        </div>
        <div class="event-stage" aria-hidden="true"><span>Atelier</span><span>Plage</span><span>Impact</span></div>
    </div>

    <div class="event-kpis">
        <div class="event-kpi"><div class="label">Evenements</div><div class="value">{{ evenements|length }}</div></div>
        <div class="event-kpi"><div class="label">Lieux actifs</div><div class="value">{{ zones|length }}</div></div>
        <div class="event-kpi"><div class="label">Fiches detaillees</div><div class="value">{{ described }}</div></div>
        <div class="event-kpi"><div class="label">Taux contenu</div><div class="value">{{ evenements|length > 0 ? ((described / evenements|length) * 100)|round : 0 }}%</div></div>
    </div>

    <div class="event-layout" id="event-agenda">
        <aside class="event-insight">
            <div class="label">Parcours evenement</div>
            <h3 style="color:#fff;margin:10px 0 14px;">De l idee a l impact</h3>
            <div class="event-timeline">
                <div class="event-step"><strong>1. Mobiliser</strong><span>Definir le lieu, le public cible et le message principal.</span></div>
                <div class="event-step"><strong>2. Sensibiliser</strong><span>Creer un moment clair, vivant et facile a partager.</span></div>
                <div class="event-step"><strong>3. Mesurer</strong><span>Relier l evenement aux observations, dechets et retours terrain.</span></div>
            </div>
        </aside>

        <div class="glass-card">
            {% if evenements is empty %}
                <div class="empty-state"><h3>Aucun evenement trouve</h3><p>Ajoutez un premier rendez-vous pour lancer l agenda.</p></div>
            {% else %}
                <div class="event-grid">
                    {% for evenement in evenements %}
                        <article class="event-card">
                            <div class="event-date">{{ evenement.date }}</div>
                            <h3>{{ evenement.nom }}</h3>
                            <div class="event-location">{{ evenement.lieu }}</div>
                            <p>{{ evenement.description ?: 'Description a completer pour presenter l objectif, le public et les actions prevues.' }}</p>
                            <div class="entity-actions"><a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-secondary">Voir</a><a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">Modifier</a></div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
