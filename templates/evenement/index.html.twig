{% extends 'base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
<link rel="stylesheet" href="/assets_admin/module-plage.css">

<section class="module-shell">
    <div class="module-hero glass-card">
        <div class="module-title-wrap">
            <h1>Événements</h1>
            <p>Tous les événements liés à la plage.</p>
        </div>
        <div class="module-actions">
            <a href="{{ path('app_evenement_new') }}" class="btn btn-primary">+ Ajouter un événement</a>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="label">Total événements</div>
            <div class="value">{{ evenements|length }}</div>
        </div>
    </div>

    <div class="glass-card">
        {% if evenements is empty %}
            <div class="empty-state">
                <h3>Aucun événement trouvé</h3>
            </div>
        {% else %}
            <div class="module-grid">
                {% for evenement in evenements %}
                    <div class="entity-card">
                        <div class="entity-id">{{ evenement.id }}</div>

                        <div class="entity-main">
                            <h3>{{ evenement.nom }}</h3>
                            <p><strong>Lieu :</strong> {{ evenement.lieu }}</p>
                            <p><strong>Description :</strong> {{ evenement.description }}</p>
                            <div class="badge-row">
                                <span class="type-badge">?? Événement</span>
                            </div>
                        </div>

                        <div class="entity-meta">
                            <p><strong>Date :</strong> {{ evenement.date }}</p>
                        </div>

                        <div class="entity-actions">
                            <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-secondary">Voir</a>
                            <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">Modifier</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
