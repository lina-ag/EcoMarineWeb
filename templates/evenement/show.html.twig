{% extends 'base.html.twig' %}

{% block title %}Événement{% endblock %}

{% block body %}
<link rel="stylesheet" href="/assets_admin/module-plage.css">

<section class="module-shell">
    <div class="module-hero glass-card">
        <div class="module-title-wrap">
            <h1>{{ evenement.nom }}</h1>
            <p>Détail complet de l'événement.</p>
        </div>
        <div class="module-actions">
            <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">Modifier</a>
            <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <div class="glass-card">
        <table class="details-table">
            <tr><th>ID</th><td>{{ evenement.id }}</td></tr>
            <tr><th>Nom</th><td>{{ evenement.nom }}</td></tr>
            <tr><th>Date</th><td>{{ evenement.date }}</td></tr>
            <tr><th>Lieu</th><td>{{ evenement.lieu }}</td></tr>
            <tr><th>Description</th><td>{{ evenement.description }}</td></tr>
        </table>
    </div>
</section>
{% endblock %}
