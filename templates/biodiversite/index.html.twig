{% extends 'base.html.twig' %}

{% block title %}Biodiversité{% endblock %}

{% block body %}
<link rel="stylesheet" href="/assets_admin/module-plage.css">

<section class="module-shell">
    <div class="module-hero glass-card">
        <div class="module-title-wrap">
            <h1>Biodiversité</h1>
            <p>Suivi des espèces et observations.</p>
        </div>
        <div class="module-actions">
            <a href="{{ path('app_biodiversite_new') }}" class="btn btn-primary">+ Ajouter une observation</a>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="label">Total observations</div>
            <div class="value">{{ biodiversites|length }}</div>
        </div>
    </div>

    <div class="glass-card">
        {% if biodiversites is empty %}
            <div class="empty-state">
                <h3>Aucune observation trouvée</h3>
            </div>
        {% else %}
            <div class="module-grid">
                {% for biodiversite in biodiversites %}
                    <div class="entity-card">
                        <div class="entity-id">{{ biodiversite.id }}</div>

                        <div class="entity-main">
                            <h3>{{ biodiversite.espece }}</h3>
                            <p><strong>Zone :</strong> {{ biodiversite.zone }}</p>
                            <div class="badge-row">
                                <span class="type-badge">?? Observation</span>
                            </div>
                        </div>

                        <div class="entity-meta">
                            <p><strong>Nombre :</strong> {{ biodiversite.nombre }}</p>
                            <p><strong>Date :</strong> {{ biodiversite.date }}</p>
                        </div>

                        <div class="entity-actions">
                            <a href="{{ path('app_biodiversite_show', {'id': biodiversite.id}) }}" class="btn btn-secondary">Voir</a>
                            <a href="{{ path('app_biodiversite_edit', {'id': biodiversite.id}) }}" class="btn btn-primary">Modifier</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
