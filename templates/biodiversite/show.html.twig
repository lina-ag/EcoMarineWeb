{% extends 'base.html.twig' %}

{% block title %}Biodiversité{% endblock %}

{% block body %}
<link rel="stylesheet" href="/assets_admin/module-plage.css">

<section class="module-shell">
    <div class="module-hero glass-card">
        <div class="module-title-wrap">
            <h1>{{ biodiversite.espece }}</h1>
            <p>Détail complet de l'observation.</p>
        </div>
        <div class="module-actions">
            <a href="{{ path('app_biodiversite_edit', {'id': biodiversite.id}) }}" class="btn btn-primary">Modifier</a>
            <a href="{{ path('app_biodiversite_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <div class="glass-card">
        <table class="details-table">
            <tr><th>ID</th><td>{{ biodiversite.id }}</td></tr>
            <tr><th>Espèce</th><td>{{ biodiversite.espece }}</td></tr>
            <tr><th>Zone</th><td>{{ biodiversite.zone }}</td></tr>
            <tr><th>Nombre</th><td>{{ biodiversite.nombre }}</td></tr>
            <tr><th>Date</th><td>{{ biodiversite.date }}</td></tr>
        </table>
    </div>
</section>
{% endblock %}
