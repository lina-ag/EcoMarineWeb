{{ form_start(form) }}
    <div class="module-form-card">
        <div class="module-form-grid">
            <div>
                {{ form_label(form.espece) }}
                {{ form_widget(form.espece) }}
                {{ form_errors(form.espece) }}
            </div>

            <div>
                {{ form_label(form.zone) }}
                {{ form_widget(form.zone) }}
                {{ form_errors(form.zone) }}
            </div>

            <div>
                {{ form_label(form.nombre) }}
                {{ form_widget(form.nombre) }}
                {{ form_errors(form.nombre) }}
            </div>

            <div>
                {{ form_label(form.date) }}
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>
        </div>

        <div class="module-form-actions">
            <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
            <a href="{{ path('app_biodiversite_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>
{{ form_end(form) }}
