<div id="cleaning-actions-panel" class="cleaning-actions-panel" data-pagination-panel>
    {% if actions_nettoyage is defined and actions_nettoyage is not empty %}
        <div class="table-responsive cleaning-table-shell">
            <table class="table table-dark table-hover cleaning-table">
                <thead>
                    <tr>
                        <th>Lieu</th>
                        <th>Date</th>
                        <th>Places</th>
                        <th>Statut</th>
                        <th>Participation</th>
                    </tr>
                </thead>

                <tbody>
                    {% for action in actions_nettoyage %}
                        {% set dejaInscrit = inscriptions_utilisateur is defined and action.getIdAction() in inscriptions_utilisateur %}

                        <tr>
                            <td>{{ action.lieu }}</td>
                            <td>{{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}</td>
                            <td>{{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}</td>
                            <td>
                                {% if action.estComplete() %}
                                    <span class="badge bg-danger">Complet</span>
                                {% else %}
                                    <span class="badge bg-success">Disponible</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if dejaInscrit %}
                                    <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': action.getIdAction()}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ action.getIdAction()) }}">
                                        <button type="submit" class="btn btn-danger btn-sm">Annuler</button>
                                    </form>
                                {% elseif action.estComplete() %}
                                    <button class="btn btn-secondary btn-sm" disabled>Complet</button>
                                {% else %}
                                    <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': action.getIdAction()}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ action.getIdAction()) }}">
                                        <button type="submit" class="btn btn-outline-success btn-sm">Participer</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-4">
            {{ knp_pagination_render(actions_nettoyage, 'home/_pagination.html.twig') }}
        </div>
    {% else %}
        <p class="cleaning-empty">Aucune action de nettoyage disponible pour le moment.</p>
    {% endif %}
</div>
