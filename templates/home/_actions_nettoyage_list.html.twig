{% if actions_nettoyage is defined and actions_nettoyage is not empty %}
    <div class="table-responsive cleaning-table-shell">
        <table class="table table-dark table-hover cleaning-table">
            <thead>
                <tr>
                    <th>Lieu</th>
                    <th>Date</th>
                    <th>Places</th>
                    <th>Participation</th>
                </tr>
            </thead>
            <tbody>
                {% for action in actions_nettoyage %}
                    {% set isRegistered = action.getIdAction() in (inscriptions_utilisateur|default([])) %}
                    {% set isComplete = action.estComplete() %}
                    <tr>
                        <td>{{ action.lieu }}</td>
                        <td>{{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non definie' }}</td>
                        <td>
                            {{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}
                            {% if isComplete %}
                                <span class="badge bg-danger ms-2">Complet</span>
                            {% else %}
                                <span class="badge bg-success ms-2">Disponible</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if app.user is null %}
                                <a href="{{ path('app_signIn') }}" class="btn btn-outline-success btn-sm">Se connecter</a>
                            {% elseif isRegistered %}
                                <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': action.getIdAction()}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ action.getIdAction()) }}">
                                    <button type="submit" class="btn btn-secondary btn-sm">Annuler</button>
                                </form>
                            {% elseif isComplete %}
                                <button type="button" class="btn btn-danger btn-sm" disabled>Complet</button>
                            {% else %}
                                <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': action.getIdAction()}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ action.getIdAction()) }}">
                                    <button type="submit" class="btn btn-success btn-sm">Participer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="cleaning-pagination">
        {{ knp_pagination_render(actions_nettoyage) }}
    </div>
{% else %}
    <p class="cleaning-empty">Aucune action de nettoyage disponible pour le moment.</p>
{% endif %}
