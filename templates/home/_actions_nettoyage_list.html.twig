{% set inscriptions = inscriptions_utilisateur|default([]) %}

{% if actions_nettoyage is empty %}
    <p class="cleaning-empty">Aucune action de nettoyage disponible pour le moment.</p>
{% else %}
    <div class="table-responsive">
        <table class="table table-striped align-middle cleaning-table">
            <thead>
                <tr>
                    <th>Lieu</th>
                    <th>Date</th>
                    <th>Places</th>
                    <th>Statut</th>
                    <th>Participation</th>
                </tr>
            </thead>
            <tbody>
                {% for action in actions_nettoyage %}
                    {% set actionId = action.getIdAction is defined ? action.getIdAction() : (action.idAction is defined ? action.idAction : null) %}
                    {% set dejaInscrit = actionId in inscriptions %}
                    {% set estComplete = action.estComplete() %}
                    <tr>
                        <td>{{ action.lieu ?: 'Non défini' }}</td>
                        <td>{{ (action.getDateAction is defined and action.getDateAction()) ? action.getDateAction()|date('d/m/Y') : (action.dateAction ? action.dateAction|date('d/m/Y') : 'Non définie') }}</td>
                        <td>
                            {{ (action.getNombreVolontaires is defined ? action.getNombreVolontaires() : (action.nombreVolontaires is defined ? action.nombreVolontaires : '-')) }} / {{ action.limiteBenevoles }}
                        </td>
                        <td>
                            {% if estComplete %}
                                <span class="badge bg-danger">Complet</span>
                            {% else %}
                                <span class="badge bg-success">Disponible</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if app.user is null %}
                                <a href="{{ path('app_signIn') }}" class="btn btn-outline-success btn-sm">Se connecter</a>
                            {% elseif dejaInscrit %}
                                <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': actionId}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ actionId) }}">
                                    <button type="submit" class="btn btn-secondary btn-sm">Annuler</button>
                                </form>
                            {% elseif estComplete %}
                                <button type="button" class="btn btn-danger btn-sm" disabled>Complet</button>
                            {% else %}
                                <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': actionId}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ actionId) }}">
                                    <button type="submit" class="btn btn-success btn-sm">Participer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if actions_nettoyage is defined and actions_nettoyage.getPaginationData is defined %}
        <div class="mt-3">
            {{ knp_pagination_render(actions_nettoyage, 'home/_cleaning_pagination.html.twig') }}
        </div>
    {% elseif actions_nettoyage is defined and actions_nettoyage|length > 0 %}
        <div class="cleaning-pagination">
            {{ knp_pagination_render(actions_nettoyage) }}
        </div>
    {% endif %}
{% endif %}
