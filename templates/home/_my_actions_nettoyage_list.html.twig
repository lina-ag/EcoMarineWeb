{% if app.user is null %}
    <p class="cleaning-empty">Connectez-vous pour consulter vos participations.</p>
{% elseif mes_inscriptions_nettoyage is empty %}
    <p class="cleaning-empty">Vous ne participez à aucune action de nettoyage pour le moment.</p>
{% else %}
    <div class="table-responsive">
        <table class="table table-striped align-middle cleaning-table">
            <thead>
                <tr>
                    <th>Lieu</th>
                    <th>Date</th>
                    <th>Places</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for inscription in mes_inscriptions_nettoyage %}
                    {% set action = inscription.getIdAction() is defined ? inscription.getIdAction() : (inscription.idAction is defined ? inscription.idAction : null) %}
                    {% if action %}
                        {% set actionId = action.getIdAction is defined ? action.getIdAction() : (action.idAction is defined ? action.idAction : null) %}
                        <tr>
                            <td>{{ action.lieu ?: 'Action supprimée' }}</td>
                            <td>{{ (action.getDateAction is defined and action.getDateAction()) ? action.getDateAction()|date('d/m/Y') : (action.dateAction ? action.dateAction|date('d/m/Y') : 'Non définie') }}</td>
                            <td>
                                {{ (action.getNombreVolontaires is defined ? action.getNombreVolontaires() : (action.nombreVolontaires is defined ? action.nombreVolontaires : '-')) }}
                                {% if action.limiteBenevoles is defined %}
                                    / {{ action.limiteBenevoles }}
                                {% endif %}
                            </td>
                            <td>
                                {% if actionId is not null %}
                                    <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': actionId}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ actionId) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Annuler</button>
                                    </form>
                                {% else %}
                                    <span class="cleaning-note">Indisponible</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>Action supprimée</td>
                            <td>Non définie</td>
                            <td>-</td>
                            <td><span class="cleaning-note">Indisponible</span></td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if mes_inscriptions_nettoyage is defined and mes_inscriptions_nettoyage.getPaginationData is defined %}
        <div class="mt-3">
            {{ knp_pagination_render(mes_inscriptions_nettoyage, 'home/_cleaning_pagination.html.twig') }}
        </div>
    {% elseif mes_inscriptions_nettoyage is defined and mes_inscriptions_nettoyage|length > 0 %}
        <div class="cleaning-pagination">
            {{ knp_pagination_render(mes_inscriptions_nettoyage) }}
        </div>
    {% endif %}
{% endif %}
