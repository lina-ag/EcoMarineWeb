{% extends 'base.html.twig' %}

{% block title %}EcoMarine - Écotourisme à Kuriat{% endblock %}

{% block body %}

{% set flash_messages = app.flashes %}

{% if flash_messages is not empty %}
    <div class="flash-stack" id="flashStack">
        {% for label, messages in flash_messages %}
            {% for message in messages %}
                <div class="flash-toast flash-{{ label }}" data-flash-toast>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

<style>
    .flash-stack {
        position: fixed;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: min(92vw, 720px);
        pointer-events: none;
    }

    .flash-toast {
        padding: 18px 24px;
        border-radius: 20px;
        color: #fff;
        text-align: center;
        font-size: 1rem;
        line-height: 1.4;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.22);
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .flash-toast.is-hiding {
        opacity: 0;
        transform: translateY(-14px);
    }

    .flash-success {
        background: #198754;
    }

    .flash-danger,
    .flash-error {
        background: #dc3545;
    }

    .flash-warning {
        background: #ffc107;
        color: #1f2937;
    }

    .flash-info {
        background: #0d6efd;
    }

    #nav-form-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        color: #ffffff;
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 0.01em;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.3s ease;
        vertical-align: middle;
        flex-shrink: 0;
        border: none;
        padding: 0.5rem 0.8rem;
        border-radius: 4px;
    }

    #nav-form-btn:hover,
    #nav-form-btn:focus-visible {
        background: rgba(255, 255, 255, 0.1);
        transform: none;
        filter: none;
        box-shadow: none;
        outline: none;
    }

    #nav-form-badge {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 0.08rem 0.5rem;
        font-size: 0.7rem;
        font-weight: 500;
        margin-left: 0.2rem;
    }

    .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        padding: 0.5rem 1rem;
    }

    .navigation-row {
        display: flex;
        align-items: center;
        flex: 1;
        justify-content: flex-end;
    }

    #navigation {
        display: flex;
        align-items: center;
        width: auto;
    }

    .nav-box {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .navigation-menu {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
        list-style: none;
        gap: 0.2rem;
        flex-wrap: wrap;
    }

    .navigation-menu li {
        margin: 0;
    }

    .navigation-menu li a {
        display: inline-block;
        padding: 0.5rem 0.8rem;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 500;
        border-radius: 4px;
    }

    .navigation-menu li a:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .navbar-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .badge {
        display: inline-block;
        padding: 0.35rem 0.6rem;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .bg-success {
        background: #198754;
        color: #fff;
    }

    .bg-danger {
        background: #dc3545;
        color: #fff;
    }

    .btn-success {
        background: #198754;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .btn-outline-success {
        background: transparent;
        color: #198754;
        border: 1px solid #198754;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .btn-danger {
        background: #dc3545;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.22);
        color: #ffffff;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .cleaning-actions-panel {
        display: block;
    }

    #cleaning-actions-wrapper.is-loading {
        opacity: 0.7;
        transition: opacity 0.2s ease;
    }

    .cleaning-card {
        position: relative;
        overflow: hidden;
        padding: 28px 28px 24px;
        border-radius: 28px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background:
            linear-gradient(145deg, rgba(7, 30, 52, 0.74), rgba(9, 45, 73, 0.56)),
            rgba(255, 255, 255, 0.08);
        box-shadow: 0 28px 60px rgba(2, 18, 35, 0.24);
        backdrop-filter: blur(16px);
        text-align: left;
    }

    .cleaning-card::before {
        content: '';
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, rgba(33, 211, 238, 0.95), rgba(14, 165, 233, 0.25));
    }

    .cleaning-card h3 {
        margin-bottom: 10px;
        font-size: 1.9rem;
        letter-spacing: 0.04em;
    }

    .cleaning-card .form-subtitle {
        margin-bottom: 24px;
        color: rgba(235, 248, 255, 0.84);
        font-size: 1rem;
    }

    .cleaning-table-shell {
        border-radius: 24px;
        border: 1px solid rgba(178, 245, 255, 0.24);
        background:
            linear-gradient(180deg, rgba(38, 118, 146, 0.24), rgba(34, 166, 179, 0.18)),
            rgba(42, 103, 126, 0.12);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.12),
            0 16px 34px rgba(4, 59, 94, 0.16);
        overflow: hidden;
    }

    .cleaning-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        color: #f7fbff;
        text-align: left;
    }

    .cleaning-table thead th {
        padding: 18px 20px;
        border: none;
        background: linear-gradient(180deg, rgba(28, 118, 145, 0.52), rgba(34, 170, 192, 0.3));
        color: #ffffff;
        font-size: 0.98rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        text-shadow: 0 1px 0 rgba(0, 0, 0, 0.12);
    }

    .cleaning-table tbody td {
        padding: 20px;
        border: none;
        border-top: 1px solid rgba(192, 244, 255, 0.16);
        background: rgba(52, 110, 132, 0.16);
        color: rgba(247, 252, 255, 0.98);
        font-size: 1.02rem;
        vertical-align: middle;
    }

    .cleaning-table tbody tr {
        transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .cleaning-table tbody tr:nth-child(even) td {
        background: rgba(61, 126, 150, 0.2);
    }

    .cleaning-table tbody tr:hover {
        background: rgba(54, 182, 212, 0.18);
    }

    .cleaning-table tbody tr:hover td {
        background: rgba(79, 173, 198, 0.24);
    }

    .cleaning-table td:last-child,
    .cleaning-table th:last-child {
        text-align: center;
    }

    .cleaning-table td:nth-child(3),
    .cleaning-table th:nth-child(3),
    .cleaning-table td:nth-child(4),
    .cleaning-table th:nth-child(4) {
        text-align: center;
    }

    .cleaning-card .badge {
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        font-size: 0.78rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .cleaning-card .bg-success {
        background: linear-gradient(135deg, #32d583, #16a34a);
        color: #ffffff;
    }

    .cleaning-card .bg-danger {
        background: linear-gradient(135deg, #ff6b81, #dc3545);
        color: #ffffff;
    }

    .cleaning-card .btn {
        min-width: 168px;
        min-height: 54px;
        border-radius: 18px;
        font-size: 0.95rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .cleaning-card .btn-success {
        background: linear-gradient(135deg, #26d97e, #0f9f61);
        border: none;
        color: #fff;
        box-shadow: 0 14px 24px rgba(15, 159, 97, 0.22);
    }

    .cleaning-card .btn-outline-success {
        background: rgba(29, 141, 112, 0.18);
        border: 1px solid rgba(52, 211, 153, 0.7);
        color: #d1fae5;
    }

    .cleaning-card .btn-outline-success:hover,
    .cleaning-card .btn-outline-success:focus {
        background: rgba(37, 217, 126, 0.26);
        border-color: rgba(115, 240, 178, 0.95);
        color: #ffffff;
    }

    .cleaning-card .btn-danger {
        background: rgba(153, 57, 76, 0.2);
        border: 1px solid rgba(251, 113, 133, 0.62);
        color: #ffe4e6;
    }

    .cleaning-card .btn-danger:hover,
    .cleaning-card .btn-danger:focus {
        background: rgba(255, 134, 159, 0.28);
        border-color: rgba(255, 164, 176, 0.75);
        color: #fff;
    }

    .cleaning-card .btn-secondary {
        background: rgba(111, 139, 155, 0.22);
        border: 1px solid rgba(186, 208, 219, 0.2);
        color: rgba(241, 245, 249, 0.82);
    }

    .cleaning-note {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(47, 162, 195, 0.22), rgba(77, 124, 232, 0.18));
        color: #e0f2fe;
        font-size: 0.84rem;
        font-weight: 600;
        user-select: text;
    }

    .cleaning-filters {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        align-items: end;
        margin-bottom: 22px;
        padding: 18px;
        border-radius: 20px;
        border: 1px solid rgba(191, 245, 255, 0.16);
        background: rgba(229, 249, 255, 0.08);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .cleaning-filter-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .cleaning-filter-label {
        color: rgba(233, 248, 255, 0.92);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .cleaning-filter-control {
        width: 100%;
        min-height: 50px;
        padding: 0 16px;
        border-radius: 14px;
        border: 1px solid rgba(167, 239, 255, 0.25);
        background: rgba(7, 35, 56, 0.48);
        color: #f6fcff;
        font-size: 0.96rem;
        outline: none;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .cleaning-filter-control:focus {
        border-color: rgba(73, 212, 255, 0.76);
        background: rgba(10, 48, 76, 0.68);
        box-shadow: 0 0 0 3px rgba(35, 200, 255, 0.14);
    }

    .cleaning-filter-control option {
        background: #113450;
        color: #f6fcff;
    }

    .cleaning-filter-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        align-items: center;
    }

    .cleaning-filter-actions .btn {
        min-width: 0;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 14px;
    }

    .cleaning-filter-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 14px;
        border: 1px solid rgba(174, 236, 255, 0.24);
        background: rgba(255, 255, 255, 0.08);
        color: #f6fcff;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .cleaning-filter-reset:hover,
    .cleaning-filter-reset:focus {
        background: rgba(255, 255, 255, 0.14);
        color: #ffffff;
        text-decoration: none;
    }

    .cleaning-empty {
        padding: 18px 20px;
        border-radius: 18px;
        border: 1px dashed rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(240, 249, 255, 0.82);
        text-align: center;
    }

    .cleaning-pagination {
        display: flex !important;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    .cleaning-pagination .cleaning-pagination__link {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        height: 44px;
        padding: 0 12px;
        margin: 0;
        border-radius: 14px;
        background: rgba(6, 24, 44, 0.34);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #f8fbff;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
    }

    .cleaning-pagination a.cleaning-pagination__link:hover {
        background: rgba(21, 101, 192, 0.32);
        border-color: rgba(88, 166, 255, 0.48);
        transform: translateY(-1px);
    }

    .cleaning-pagination .current.cleaning-pagination__link {
        background: linear-gradient(135deg, #23c8ff 0%, #1184ff 100%);
        color: #042544;
        box-shadow: 0 14px 28px rgba(17, 132, 255, 0.28);
    }

    .cleaning-pagination .disabled.cleaning-pagination__link {
        opacity: 0.35;
    }

    @media (max-width: 768px) {
        .cleaning-card {
            padding: 22px 16px 18px;
            border-radius: 22px;
        }

        .cleaning-card h3 {
            font-size: 1.45rem;
        }

        .cleaning-table thead th,
        .cleaning-table tbody td {
            padding: 14px 12px;
            font-size: 0.92rem;
        }

        .cleaning-card .btn {
            min-width: 130px;
            min-height: 46px;
            font-size: 0.84rem;
        }

        .cleaning-filters {
            grid-template-columns: 1fr;
            padding: 16px;
        }

        .cleaning-filter-actions {
            justify-content: stretch;
            flex-direction: column;
        }

        .cleaning-filter-actions .btn,
        .cleaning-filter-reset {
            width: 100%;
        }
    }

    .btn-sm {
        font-size: 0.85rem;
    }

    select.form-input option {
        background-color: #1a1a2e;
        color: #ffffff;
        padding: 0.75rem;
    }

    select.form-input option:checked {
        background: linear-gradient(135deg, #16c2e2 0%, #5268e4 100%);
        background-color: #5268e4;
        color: #ffffff;
    }

    select.form-input option:hover {
        background-color: #2d2d44;
    }

    @media (max-width: 992px) {
        .navbar-toggle {
            display: block;
        }

        .nav-box {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.95);
            flex-direction: column;
            padding: 1rem;
            z-index: 1000;
        }

        .nav-box.active {
            display: flex;
        }

        .navigation-menu {
            flex-direction: column;
            width: 100%;
            text-align: center;
        }

        .navigation-menu li {
            width: 100%;
        }

        .navigation-menu li a {
            display: block;
            padding: 0.8rem;
        }
    }

    @media (max-width: 1024px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .glass-card {
            padding: 28px;
        }
    }
</style>

