                            <span>Gérer les zones</span>
                            <h2>Ajouter une zone protégée</h2>
                        </div>

                        <div class="reservations-section">
                            <div class="row">
                                <div class="col-md-8 offset-md-2 animate" data-animate="fadeInUp">
                                    <div class="form-card">
                                        <h3>Créer une zone protégée</h3>
                                        <p class="form-subtitle">Renseignez les informations de la nouvelle zone</p>
                                        {{ include('zonep/_form.html.twig', {
                                            'form': form_zonep,
                                            'button_label': 'Créer la zone',
                                            'form_action': path('app_zonep_new'),
                                            'show_back_button': false
                                        }) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 10 — Surveillance -->
        <div class="section animated-row" data-section="slide10" data-anchor="slide10">
            <div class="section-inner">
                <div class="row justify-content-center">
                    <div class="col-md-10 wide-col-laptop">
                        <div class="title-block animate" data-animate="fadeInUp">
                            <span>Suivi terrain</span>
                            <h2>Ajouter une surveillance de zone</h2>
                        </div>

                        <div class="reservations-section">
                            <div class="row">
                                <div class="col-md-8 offset-md-2 animate" data-animate="fadeInUp">
                                    <div class="form-card">
                                        <h3>Créer une fiche de surveillance</h3>
                                        <p class="form-subtitle">Enregistrez la date, la zone et vos observations</p>
                                        {{ include('survzone/_form.html.twig', {
                                            'form': form_survzone,
                                            'button_label': 'Créer la surveillance',
                                            'form_action': path('app_survzone_new'),
                                            'show_back_button': false
                                        }) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 12 — Nettoyage -->
        <div class="section animated-row" data-section="slide12" data-anchor="slide12">
            <div class="section-inner">
                <div class="row justify-content-center">
                    <div class="col-md-10 wide-col-laptop">

                        <div class="title-block animate" data-animate="fadeInUp">
                            <span>Actions de nettoyage</span>
                            <h2>Participez à la protection du littoral</h2>
                        </div>

                        <!-- Bloc : Actions recommandées -->
                        <div class="form-card animate" data-animate="fadeInUp">
                            <h3>Actions recommandées pour vous</h3>
                            <p class="form-subtitle">
                                Recommandations personnalisées sur les actions de nettoyage disponibles.
                            </p>

                            {% if current_user is not null %}
                                {% if actions_recommandees is defined and actions_recommandees is not empty %}
                                    <div class="table-responsive">
                                        <table class="table table-dark table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Lieu</th>
                                                    <th>Date</th>
                                                    <th>Places</th>
                                                    <th>Raison</th>
                                                    <th>Participation</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for rec in actions_recommandees %}
                                                    {% set action = rec.action %}
                                                    <tr>
                                                        <td>{{ action.lieu }}</td>
                                                        <td>{{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}</td>
                                                        <td>{{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}</td>
                                                        <td>{{ rec.raison }}</td>
                                                        <td>
                                                            <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': action.getIdAction()}) }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ action.getIdAction()) }}">
                                                                <button type="submit" class="btn btn-success btn-sm">Participer</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <p>Aucune recommandation disponible pour le moment.</p>
                                {% endif %}
                            {% else %}
                                <p>Connectez-vous pour recevoir des recommandations personnalisées.</p>
                            {% endif %}
                        </div>

                        <!-- Bloc : Actions disponibles -->
                        <div class="form-card mt-4 animate" data-animate="fadeInUp">
                            <h3>Actions disponibles</h3>
                            <p class="form-subtitle">
                                Consultez les actions de nettoyage disponibles et participez comme bénévole.
                            </p>

                            {% if actions_nettoyage is defined and actions_nettoyage is not empty %}
                                <div class="table-responsive">
                                    <table class="table table-dark table-hover">
                                        <thead>
                                            <tr>
                                                <th>Lieu</th>
                                                <th>Date</th>
                                                <th>Places</th>
                                                <th>Statut</th>
                                                <th>Participation</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            {% for action in actions_nettoyage %}
                                                {% set dejaInscrit = inscriptions_utilisateur is defined and action.getIdAction() in inscriptions_utilisateur %}

                                                <tr>
                                                    <td>{{ action.lieu }}</td>
                                                    <td>{{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}</td>
                                                    <td>{{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}</td>
                                                    <td>
                                                        {% if action.estComplete() %}
                                                            <span class="badge bg-danger">Complet</span>
                                                        {% else %}
                                                            <span class="badge bg-success">Disponible</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if dejaInscrit %}
                                                            <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': action.getIdAction()}) }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ action.getIdAction()) }}">
                                                                <button type="submit" class="btn btn-danger btn-sm">Annuler</button>
                                                            </form>
                                                        {% elseif action.estComplete() %}
                                                            <button class="btn btn-secondary btn-sm" disabled>Complet</button>
                                                        {% else %}
                                                            <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': action.getIdAction()}) }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ action.getIdAction()) }}">
                                                                <button type="submit" class="btn btn-success btn-sm">Participer</button>
                                                            </form>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <p>Aucune action de nettoyage disponible pour le moment.</p>
                            {% endif %}
                        </div>

                        <!-- Bloc : Mes participations -->
                        <div class="form-card mt-4 animate" data-animate="fadeInUp">
                            <h3>Mes actions de nettoyage</h3>
                            <p class="form-subtitle">
                                Retrouvez les actions de nettoyage auxquelles vous participez déjà.
                            </p>

                            {% if mes_inscriptions_nettoyage is defined and mes_inscriptions_nettoyage is not empty %}
                                <div class="table-responsive">
                                    <table class="table table-dark table-hover">
                                        <thead>
                                            <tr>
                                                <th>Lieu</th>
                                                <th>Date</th>
                                                <th>Places</th>
                                                <th>Statut</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            {% for inscription in mes_inscriptions_nettoyage %}
                                                {% set action = inscription.getIdAction() %}

                                                {% if action %}
                                                    <tr>
                                                        <td>{{ action.lieu }}</td>
                                                        <td>{{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}</td>
                                                        <td>{{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}</td>
                                                        <td>
                                                            {% if action.estComplete() %}
                                                                <span class="badge bg-danger">Complet</span>
                                                            {% else %}
                                                                <span class="badge bg-success">Disponible</span>
                                                            {% endif %}
                                                        </td>
                                                        <td>
                                                            <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': action.getIdAction()}) }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ action.getIdAction()) }}">
                                                                <button type="submit" class="btn btn-danger btn-sm">Annuler ma participation</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endif %}
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <p>Vous ne participez encore à aucune action de nettoyage.</p>
                            {% endif %}
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>{# fin #fullpage #}

    <!-- Réseaux sociaux -->
    <div id="social-icons">
        <div class="text-right">
            <ul class="social-icons">
                <li><a href="#" title="Facebook"><i class="fa fa-facebook"></i></a></li>
                <li><a href="#" title="Instagram"><i class="fa fa-instagram"></i></a></li>
                <li><a href="#" title="Twitter"><i class="fa fa-twitter"></i></a></li>
                <li><a href="#" title="LinkedIn"><i class="fa fa-linkedin"></i></a></li>
            </ul>
        </div>
    </div>

</div>{# fin #video #}

<script>
    (function () {
        var flashToasts = document.querySelectorAll('[data-flash-toast]');

        flashToasts.forEach(function (toast, index) {
            var visibleDelay = 3200 + (index * 250);

            window.setTimeout(function () {
                toast.classList.add('is-hiding');

                window.setTimeout(function () {
                    if (toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }

                    var flashStack = document.getElementById('flashStack');
                    if (flashStack && flashStack.children.length === 0) {
                        flashStack.remove();
                    }
                }, 450);
            }, visibleDelay);
        });
    })();

    var navbarToggle = document.querySelector('.navbar-toggle');
    var navBox = document.querySelector('.nav-box');

    if (navbarToggle && navBox) {
        navbarToggle.addEventListener('click', function () {
            navBox.classList.toggle('active');
        });
    }

    (function () {
        var FORMS = [
            { anchor: 'slide08', label: 'Réservations' },
            { anchor: 'slide09', label: 'Activité Éco.' },
            { anchor: 'slide11', label: 'Zone Protégée' },
            { anchor: 'slide10', label: 'Surveillance' },
            { anchor: 'slide12', label: 'Nettoyage' },
            { anchor: 'slide209b', label: 'Nvl. Activité' },
            { anchor: 'slide210', label: 'Faune Marine' },
            { anchor: 'slide211', label: 'Observation' },
            { anchor: 'slide212', label: 'Prédiction' },
            { anchor: 'slide213', label: 'Mission Drone' },
            { anchor: 'slide214', label: 'Détection Drone' }
        ];

        var btn = document.getElementById('nav-form-btn');
        var labelEl = document.getElementById('nav-form-label');
        var badgeEl = document.getElementById('nav-form-badge');
        var total = FORMS.length;
        var nextIdx = 0;

        if (!btn || !labelEl || !badgeEl) return;

        function getCurrentFormIndex() {
            var hash = window.location.hash ? window.location.hash.replace('#', '') : '';
            for (var i = 0; i < total; i++) {
                if (FORMS[i].anchor === hash) return i;
            }
            return -1;
        }

        function updateBtn() {
            var idx = getCurrentFormIndex();
            nextIdx = (idx >= 0) ? (idx + 1) % total : 0;
            labelEl.textContent = FORMS[nextIdx].label;
            badgeEl.textContent = (nextIdx + 1) + '/' + total;
        }

        btn.addEventListener('click', function () {
            window.location.hash = '#' + FORMS[nextIdx].anchor;
            setTimeout(updateBtn, 80);
        });

        window.addEventListener('hashchange', updateBtn);
        updateBtn();
    })();
</script>

{% endblock %}
