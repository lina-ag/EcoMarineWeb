        <!-- SLIDE 10 — Surveillance -->
        <div class="section animated-row" data-section="slide10" data-anchor="slide10">
            <div class="section-inner">
                <div class="row justify-content-center">
                    <div class="col-md-10 wide-col-laptop">
                        <div class="title-block animate" data-animate="fadeInUp">
                            <span>Suivi terrain</span>
                            <h2>Ajouter une surveillance de zone</h2>
                        </div>
                        <div class="reservations-section">
                            <div class="row">
                                <!-- Formulaire Survzone -->
                                <div class="col-md-8 offset-md-2 animate" data-animate="fadeInUp">
                                    <div class="form-card">
                                        <h3>Créer une fiche de surveillance</h3>
                                        <p class="form-subtitle">Enregistrez la date, la zone et vos observations</p>
                                        {{ include('survzone/_form.html.twig', {
                                            'form': form_survzone,
                                            'button_label': 'Créer la surveillance',
                                            'form_action': path('app_survzone_new'),
                                            'show_back_button': false
                                        }) }}
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-group-settings">
                                        {{ form_label(survzoneForm.dateSurv, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(survzoneForm.dateSurv, {'attr': {'class': 'form-input'}}) }}
                                        {{ form_errors(survzoneForm.dateSurv) }}
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-group-settings full-width">
                                        {{ form_label(survzoneForm.observation, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(survzoneForm.observation, {'attr': {'class': 'form-input', 'rows': 5, 'placeholder': 'Détails de la surveillance'}}) }}
                                        {{ form_errors(survzoneForm.observation) }}
                                    </div>
                                </div>

                                <div class="btn-group">
                                    <button class="btn btn-primary" type="submit">Ajouter la surveillance</button>
                                </div>

                                {{ form_rest(survzoneForm) }}
                                {{ form_end(survzoneForm) }}
                            </section>
