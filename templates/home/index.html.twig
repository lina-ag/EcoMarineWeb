{% extends 'base.html.twig' %}

{% block title %}EcoMarine - Écotourisme à Kuriat{% endblock %}

{% block body %}

{% set flash_messages = app.flashes %}

{% if flash_messages is not empty %}
    <div class="flash-stack" id="flashStack">
        {% for label, messages in flash_messages %}
            {% for message in messages %}
                <div class="flash-toast flash-{{ label }}" data-flash-toast>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

<style>
    .flash-stack {
        position: fixed;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: min(92vw, 720px);
        pointer-events: none;
    }

    .flash-toast {
        padding: 18px 24px;
        border-radius: 20px;
        color: #fff;
        text-align: center;
        font-size: 1rem;
        line-height: 1.4;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.22);
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .flash-toast.is-hiding {
        opacity: 0;
        transform: translateY(-14px);
    }

    .flash-success {
        background: #198754;
    }

    .flash-danger,
    .flash-error {
        background: #dc3545;
    }

    .flash-warning {
        background: #ffc107;
        color: #1f2937;
    }

    .flash-info {
        background: #0d6efd;
    }

    #nav-form-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        color: #ffffff;
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 0.01em;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.3s ease;
        vertical-align: middle;
        flex-shrink: 0;
        border: none;
        padding: 0.5rem 0.8rem;
        border-radius: 4px;
    }

    #nav-form-btn:hover,
    #nav-form-btn:focus-visible {
        background: rgba(255, 255, 255, 0.1);
        transform: none;
        filter: none;
        box-shadow: none;
        outline: none;
    }

    #nav-form-badge {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 0.08rem 0.5rem;
        font-size: 0.7rem;
        font-weight: 500;
        margin-left: 0.2rem;
    }

    .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        padding: 0.5rem 1rem;
    }

    .navigation-row {
        display: flex;
        align-items: center;
        flex: 1;
        justify-content: flex-end;
    }

    #navigation {
        display: flex;
        align-items: center;
        width: auto;
    }

    .nav-box {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .navigation-menu {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
        list-style: none;
        gap: 0.2rem;
        flex-wrap: wrap;
    }

    .navigation-menu li {
        margin: 0;
    }

    .navigation-menu li a {
        display: inline-block;
        padding: 0.5rem 0.8rem;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 500;
        border-radius: 4px;
    }

    .navigation-menu li a:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .navbar-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .badge {
        display: inline-block;
        padding: 0.35rem 0.6rem;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .bg-success {
        background: #198754;
        color: #fff;
    }

    .bg-danger {
        background: #dc3545;
        color: #fff;
    }

    .btn-success {
        background: #198754;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .btn-danger {
        background: #dc3545;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.22);
        color: #ffffff;
        border-radius: 8px;
        padding: 0.45rem 0.8rem;
    }

    .btn-sm {
        font-size: 0.85rem;
    }

    select.form-input option {
        background-color: #1a1a2e;
        color: #ffffff;
        padding: 0.75rem;
    }

    select.form-input option:checked {
        background: linear-gradient(135deg, #16c2e2 0%, #5268e4 100%);
        background-color: #5268e4;
        color: #ffffff;
    }

    select.form-input option:hover {
        background-color: #2d2d44;
    }

    @media (max-width: 992px) {
        .navbar-toggle {
            display: block;
        }

        .nav-box {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.95);
            flex-direction: column;
            padding: 1rem;
            z-index: 1000;
        }

        .nav-box.active {
            display: flex;
        }

        .navigation-menu {
            flex-direction: column;
            width: 100%;
            text-align: center;
        }

        .navigation-menu li {
            width: 100%;
        }

        .navigation-menu li a {
            display: block;
            padding: 0.8rem;
        }
    }

    @media (max-width: 1024px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .glass-card {
            padding: 28px;
        }
    }
</style>

