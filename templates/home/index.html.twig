{% extends 'base.html.twig' %}

{% block title %}Gestion des dechets{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('assets_admin/home-eco.css') }}">
<link rel="stylesheet" href="{{ asset('assets_admin/module-plage.css') }}">

<<<<<<< HEAD
<section class="home-shell">
    <div class="home-container">
        <span class="home-badge">Developpement durable</span>
        <h1 class="home-title">Gestion des dechets</h1>

        <nav class="home-tabs">
            <a href="{{ path('app_home', {'tab': 'overview'}) }}" class="home-tab {{ activeTab == 'overview' ? 'active' : '' }}">Overview</a>
            <a href="{{ path('app_home', {'tab': 'latest'}) }}" class="home-tab {{ activeTab == 'latest' ? 'active' : '' }}">Latest</a>
            <a href="{{ path('app_home', {'tab': 'documents'}) }}" class="home-tab {{ activeTab == 'documents' ? 'active' : '' }}">Documents</a>
            <a href="{{ path('app_home', {'tab': 'contact'}) }}" class="home-tab {{ activeTab == 'contact' ? 'active' : '' }}">Contact</a>
        </nav>

        {% if activeTab == 'overview' %}
            <div class="home-grid">
                <div class="home-panel">
                    <h2>Vue generale</h2>
                    <p>Bienvenue dans le module de gestion des dechets. Cette page devient maintenant la page d'accueil du module et donne acces aux signalements, statistiques et details intelligents.</p>

                    <div class="overview-list">
                        <div class="overview-item"><strong>Objectif :</strong> centraliser les signalements et leur suivi intelligent.</div>
                        <div class="overview-item"><strong>Fonctions :</strong> image, localisation, meteo, IA, priorite et recommandation automatique.</div>
                        <div class="overview-item"><strong>Navigation :</strong> utilisez Latest pour voir les dechets deja travailles en detail.</div>
                    </div>
                </div>

                <div class="home-panel">
                    <h2>Quick links</h2>
                    <p>Gestion des dechets resources:</p>

                    <div class="quick-links">
                        <a href="{{ path('app_home', {'tab': 'latest'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Latest</div>
                                <div class="quick-card-desc">Signalements detailles, image, meteo, IA et priorite.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>

                        <a href="{{ path('app_home', {'tab': 'documents'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Documents</div>
                                <div class="quick-card-desc">Rapports, cartes, syntheses et ressources.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>

                        <a href="{{ path('app_home', {'tab': 'contact'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Contacts</div>
                                <div class="quick-card-desc">Contact principal du module dechets.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>
                    </div>
                </div>
            </div>

        {% elseif activeTab == 'latest' %}

            <section class="module-shell">
                <div class="module-hero glass-card">
                    <div class="module-title-wrap">
                        <h1>Gestion des dechets intelligents</h1>
                        <p>Partie detaillee du module avec image, API, IA, score de priorite et recommandation automatique.</p>
                    </div>

                    <div style="display:flex; gap:12px; flex-wrap:wrap;">
                        <a href="{{ path('app_dechet_new') }}" class="btn btn-primary">+ Ajouter un signalement</a>
                        <a href="{{ path('app_dechet_stats') }}" class="btn btn-secondary">Statistiques</a>
                    </div>
                </div>

                <div class="feature-grid">
                    <div class="feature-card">
                        <div class="feature-icon">📦</div>
                        <h3>Bundle UX Dropzone</h3>
                        <p>Ajout d'image moderne dans le formulaire Symfony.</p>
                        <div class="smart-badge-row">
                            <span class="bundle-badge">UX Dropzone</span>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">🗺️</div>
                        <h3>API Carte</h3>
                        <p>Chaque signalement est place sur la carte avec latitude et longitude.</p>
                        <div class="smart-badge-row">
                            <span class="api-badge">Leaflet Maps</span>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">🌦️</div>
                        <h3>API Meteo</h3>
                        <p>La meteo et le vent enrichissent l'analyse du signalement.</p>
                        <div class="smart-badge-row">
                            <span class="weather-badge">OpenWeather</span>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">🤖</div>
                        <h3>IA + Smart metier</h3>
                        <p>Type suggere par IA, score de priorite et recommandation automatique.</p>
                        <div class="smart-badge-row">
                            <span class="ai-badge">OpenAI Vision</span>
                            <span class="priority-badge priority-moyenne">Moteur metier</span>
                        </div>
                    </div>
                </div>

                <div class="kpi-grid">
                    <div class="kpi-card">
                        <div class="label">Total signalements</div>
                        <div class="value">{{ statsCards.totalSignalements|default(dechets|length) }}</div>
                    </div>
                    <div class="kpi-card">
                        <div class="label">Quantite totale</div>
                        <div class="value">{{ statsCards.totalQuantite|default(0) }}</div>
                    </div>
                    <div class="kpi-card">
                        <div class="label">Zones touchees</div>
                        <div class="value">{{ statsCards.zonesTouchees|default(0) }}</div>
                    </div>
                    <div class="kpi-card">
                        <div class="label">Progression nettoyage</div>
                        <div class="value">{{ statsCards.progressionNettoyage|default(0) }}%</div>
                    </div>
                </div>

                <div class="glass-card">
                    <h3 class="section-title">Signalements detailles</h3>

                    {% if dechets is empty %}
                        <div class="smart-item" style="margin-top:16px;">Aucun signalement disponible.</div>
                    {% else %}
                        <div class="smart-list" style="margin-top:18px;">
                            {% for dechet in dechets %}
                                {% set priorityClass = 'priority-faible' %}
                                {% set label = dechet.priorityLabel|default('faible') %}

                                {% if label == 'moyenne' %}
                                    {% set priorityClass = 'priority-moyenne' %}
                                {% elseif label == 'élevée' or label == 'elevee' %}
                                    {% set priorityClass = 'priority-elevee' %}
                                {% elseif label == 'critique' %}
                                    {% set priorityClass = 'priority-critique' %}
                                {% endif %}

                                <div class="smart-card">
                                    <div style="display:grid; grid-template-columns: 120px 1.4fr 1fr auto; gap:18px; align-items:center;">
                                        <div>
                                            {% if dechet.photo %}
                                                <img src="{{ asset('uploads/dechets/' ~ dechet.photo) }}" alt="Photo dechet" style="width:110px; height:110px; object-fit:cover; border-radius:18px;">
                                            {% else %}
                                                <div style="width:110px; height:110px; border-radius:18px; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.06); color:#dce7ff; font-weight:700;">
                                                    Pas d'image
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div>
                                            <h3 style="margin:0 0 10px;">{{ dechet.type|default('Dechet')|capitalize }} - {{ dechet.zone|default('Zone inconnue') }}</h3>
                                            <div class="smart-item" style="padding:12px 14px;">
                                                <strong>Quantite :</strong> {{ dechet.quantite|default(0) }}<br>
                                                <strong>Date :</strong> {{ dechet.dateSignalement ? dechet.dateSignalement|date('Y-m-d') : 'N/A' }}<br>
                                                <strong>Description :</strong> {{ dechet.description ?: 'Aucune description' }}<br>
                                                <strong>Latitude :</strong> {{ dechet.latitude ?: 'N/A' }}<br>
                                                <strong>Longitude :</strong> {{ dechet.longitude ?: 'N/A' }}
                                            </div>
                                        </div>

                                        <div>
                                            <div class="smart-list">
                                                <div class="smart-item"><strong>Meteo :</strong> {{ dechet.weatherMain ?: 'Non disponible' }}</div>
                                                <div class="smart-item"><strong>Vent :</strong> {{ dechet.weatherWind ?: 0 }} m/s</div>
                                                <div class="smart-item"><strong>Type IA :</strong> {{ dechet.aiTypeSuggestion ?: 'Non detecte' }}</div>
                                                <div class="smart-item"><strong>Confiance IA :</strong> {{ dechet.aiConfidence is not null ? dechet.aiConfidence : 0 }}</div>
                                                <div class="smart-item"><strong>Score :</strong> {{ dechet.priorityScore is not null ? dechet.priorityScore ~ '/100' : 'N/A' }}</div>
                                            </div>
                                        </div>

                                        <div style="display:flex; flex-direction:column; gap:10px; align-items:flex-end;">
                                            <span class="priority-badge {{ priorityClass }}">{{ label }}</span>
                                            <span class="smart-badge">{{ dechet.statut ?: 'inconnu' }}</span>
                                            <a href="{{ path('app_dechet_show', {'id_dechet': dechet.idDechet}) }}" class="btn btn-secondary">Voir le detail</a>
                                        </div>
                                    </div>

                                    <div class="smart-item" style="margin-top:14px;">
                                        <strong>Recommandation automatique :</strong>
                                        {{ dechet.recommendedAction ?: 'Aucune recommandation disponible.' }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </section>

        {% elseif activeTab == 'documents' %}
            <div class="home-grid">
                <div class="home-panel">
                    <h2>Documents</h2>
                    <p>Meeting minutes, maps, reports et documents utiles pour le module dechets.</p>

                    <div class="overview-list">
                        <div class="overview-item"><strong>Rapports :</strong> syntheses sur les zones, volumes et priorites.</div>
                        <div class="overview-item"><strong>Cartes :</strong> localisation des signalements et des zones sensibles.</div>
                        <div class="overview-item"><strong>Ressources :</strong> fiches techniques et supports du module.</div>
                    </div>
                </div>

                <div class="home-panel">
                    <h2>Quick links</h2>
                    <div class="quick-links">
                        <a href="{{ path('app_home', {'tab': 'latest'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Latest</div>
                                <div class="quick-card-desc">Voir les signalements detailles.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>

                        <a href="{{ path('app_home', {'tab': 'contact'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Contacts</div>
                                <div class="quick-card-desc">Contact du module dechets.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>
                    </div>
                </div>
            </div>

        {% elseif activeTab == 'contact' %}
            <div class="home-grid">
                <div class="home-panel">
                    <h2>Regionale</h2>

                    <div class="contact-card">
                        <div class="contact-name">{{ contact.name }}</div>
                        <div class="contact-role">{{ contact.role }}</div>
                        <a class="contact-mail" href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                        <div class="contact-region">{{ contact.region }}</div>
                    </div>
                </div>

                <div class="home-panel">
                    <h2>Quick links</h2>
                    <div class="quick-links">
                        <a href="{{ path('app_home', {'tab': 'latest'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Latest</div>
                                <div class="quick-card-desc">Voir les signalements detailles.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>

                        <a href="{{ path('app_home', {'tab': 'documents'}) }}" class="quick-card">
                            <div>
                                <div class="quick-card-title">Documents</div>
                                <div class="quick-card-desc">Rapports, cartes et ressources.</div>
                            </div>
                            <div class="quick-arrow">›</div>
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
