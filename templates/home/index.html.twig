                                       data-cleaning-filter-reset>Réinitialiser</a>
                                </div>
                            </form>

                            <div id="cleaning-actions-wrapper" data-cleaning-pagination-root>
                                {{ include('home/_actions_nettoyage_list.html.twig', {
