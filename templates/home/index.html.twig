                                        <thead>
                                            <tr>
                                                <th>Lieu</th>
                                                <th>Date</th>
                                                <th>Places</th>
                                                <th>Raison</th>
                                                <th>Participation</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for rec in actions_recommandees %}
                                                {% set action = rec.action %}
                                                <tr>
                                                    <td>{{ action.lieu }}</td>
                                                    <td>{{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}</td>
                                                    <td>{{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}</td>
                                                    <td>{{ rec.raison }}</td>
                                                    <td>
                                                        <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': action.getIdAction()}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ action.getIdAction()) }}">
                                                            <button type="submit" class="btn btn-success btn-sm">
                                                                Participer
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <p>Aucune recommandation disponible pour le moment.</p>
                            {% endif %}
                        {% else %}
                            <p>Connectez-vous pour recevoir des recommandations personnalisées.</p>
                        {% endif %}
                    </div>

                    <!-- Bloc 1 : Actions disponibles -->
                    <div class="form-card animate" data-animate="fadeInUp">
                        <h3>Actions disponibles</h3>
                        <p class="form-subtitle">
                            Consultez les actions de nettoyage disponibles et participez comme bénévole.
                        </p>

                        {% if actions_nettoyage is defined and actions_nettoyage is not empty %}
                            <div class="table-responsive">
                                <table class="table table-dark table-hover">
                                    <thead>
                                        <tr>
                                            <th>Lieu</th>
                                            <th>Date</th>
                                            <th>Places</th>
                                            <th>Statut</th>
                                            <th>Participation</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        {% for action in actions_nettoyage %}
                                            {% set dejaInscrit = inscriptions_utilisateur is defined and action.getIdAction() in inscriptions_utilisateur %}

                                            <tr>
                                                <td>{{ action.lieu }}</td>

                                                <td>
                                                    {{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}
                                                </td>

                                                <td>
                                                    {{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}
                                                </td>

                                                <td>
                                                    {% if action.estComplete() %}
                                                        <span class="badge bg-danger">Complet</span>
                                                    {% else %}
                                                        <span class="badge bg-success">Disponible</span>
                                                    {% endif %}
                                                </td>

                                                <td>
                                                    {% if dejaInscrit %}
                                                        <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': action.getIdAction()}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ action.getIdAction()) }}">

                                                            <button type="submit" class="btn btn-danger btn-sm">
                                                                Annuler
                                                            </button>
                                                        </form>
                                                    {% elseif action.estComplete() %}
                                                        <button class="btn btn-secondary btn-sm" disabled>
                                                            Complet
                                                        </button>
                                                    {% else %}
                                                        <form method="post" action="{{ path('app_action_nettoyage_participer', {'id_action': action.getIdAction()}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('participer' ~ action.getIdAction()) }}">

                                                            <button type="submit" class="btn btn-success btn-sm">
                                                                Participer
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p>Aucune action de nettoyage disponible pour le moment.</p>
                        {% endif %}
                    </div>

                    <!-- Bloc 2 : Mes participations -->
                    <div class="form-card mt-4 animate" data-animate="fadeInUp">
                        <h3>Mes actions de nettoyage</h3>
                        <p class="form-subtitle">
                            Retrouvez les actions de nettoyage auxquelles vous participez déjà.
                        </p>

                        {% if mes_inscriptions_nettoyage is defined and mes_inscriptions_nettoyage is not empty %}
                            <div class="table-responsive">
                                <table class="table table-dark table-hover">
                                    <thead>
                                        <tr>
                                            <th>Lieu</th>
                                            <th>Date</th>
                                            <th>Places</th>
                                            <th>Statut</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        {% for inscription in mes_inscriptions_nettoyage %}
                                            {% set action = inscription.getIdAction() %}

                                            {% if action %}
                                                <tr>
                                                    <td>{{ action.lieu }}</td>

                                                    <td>
                                                        {{ action.getDateAction() ? action.getDateAction()|date('d/m/Y') : 'Non définie' }}
                                                    </td>

                                                    <td>
                                                        {{ action.getNombreVolontaires() }} / {{ action.limiteBenevoles }}
                                                    </td>

                                                    <td>
                                                        {% if action.estComplete() %}
                                                            <span class="badge bg-danger">Complet</span>
                                                        {% else %}
                                                            <span class="badge bg-success">Disponible</span>
                                                        {% endif %}
                                                    </td>

                                                    <td>
                                                        <form method="post" action="{{ path('app_action_nettoyage_annuler_participation', {'id_action': action.getIdAction()}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('annuler_participation' ~ action.getIdAction()) }}">

                                                            <button type="submit" class="btn btn-danger btn-sm">
                                                                Annuler ma participation
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p>Vous ne participez encore à aucune action de nettoyage.</p>
                        {% endif %}
                    </div>

                </div>  
            </div>
        </div>
    </div>
 </div>{# fin #fullpage #}
    <!-- Réseaux sociaux -->
    <div id="social-icons">
        <div class="text-right">
            <ul class="social-icons">
                <li><a href="#" title="Facebook"><i class="fa fa-facebook"></i></a></li>
                <li><a href="#" title="Instagram"><i class="fa fa-instagram"></i></a></li>
                <li><a href="#" title="Twitter"><i class="fa fa-twitter"></i></a></li>
                <li><a href="#" title="LinkedIn"><i class="fa fa-linkedin"></i></a></li>
            </ul>
        </div>
    </div>

</div>{# fin #video #}

{% endblock %}