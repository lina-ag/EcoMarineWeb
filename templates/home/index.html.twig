{% extends 'base.html.twig' %}

{% block title %}EcoMarine - Écotourisme à Kuriat{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.18);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 28px;
            padding: 36px;
        }

        .card-header {
            margin-bottom: 24px;
        }

        .card-title {
            font-size: 2.3rem;
            margin-bottom: .4rem;
            color: #ffffff;
        }

        .card-subtitle {
            color: rgba(255, 255, 255, 0.78);
            line-height: 1.6;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.5rem;
        }

        .form-group-settings {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .form-group-settings.full-width {
            grid-column: 1 / -1;
        }

        .form-label {
            display: block;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: #f5f7ff;
        }

        .form-input {
            width: 100%;
            min-height: 52px;
            padding: 1rem 1.1rem;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 18px;
            color: #ffffff;
            transition: all 0.25s ease;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
        }

        .form-input:focus,
        .form-input:focus-visible {
            outline: none;
            border-color: rgba(255, 255, 255, 0.7);
            background: rgba(255, 255, 255, 0.18);
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.12);
        }

        textarea.form-input {
            min-height: 170px;
            resize: vertical;
        }

        ::placeholder {
            color: rgba(255, 255, 255, 0.68);
            opacity: 1;
        }

        .btn-group {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #16c2e2 0%, #5268e4 100%);
            border: none;
            color: #ffffff;
            padding: 1rem 1.6rem;
            border-radius: 16px;
            min-width: 180px;
            font-weight: 700;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 18px 30px rgba(22, 194, 226, 0.22);
        }

        .btn-primary:hover,
        .btn-primary:focus {
            transform: translateY(-1px);
            box-shadow: 0 22px 40px rgba(22, 194, 226, 0.28);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.22);
            color: #ffffff;
        }

        .btn-secondary:hover,
        .btn-secondary:focus {
            background: rgba(255, 255, 255, 0.16);
        }

        .form-errors,
        .form-errors li {
            color: #ffccd5;
            margin-top: 0.35rem;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        /* Styles pour les select/dropdown */
        .form-input[type="select"],
        select.form-input {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1.5em 1.5em;
            padding-right: 3rem;
        }

        select.form-input option {
            background-color: #1a1a2e;
            color: #ffffff;
            padding: 0.75rem;
        }

        select.form-input option:checked {
            background: linear-gradient(135deg, #16c2e2 0%, #5268e4 100%);
            background-color: #5268e4;
            color: #ffffff;
        }

        select.form-input option:hover {
            background-color: #2d2d44;
        }

        @media (max-width: 1024px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .glass-card {
                padding: 28px;
            }
        }
    </style>
{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div style="
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            padding: 15px 20px;
            border-radius: 12px;
            color: white;
            background:
                {% if label == 'success' %}#198754
                {% elseif label == 'danger' %}#dc3545
                {% elseif label == 'warning' %}#ffc107
                {% else %}#0d6efd
                {% endif %};
        ">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

