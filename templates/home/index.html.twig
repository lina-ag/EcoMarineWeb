{% extends 'base.html.twig' %}

{% block title %}EcoMarine - Ecotourisme a Kuriat{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
        {{ message }}
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
        {{ message }}
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
{% endfor %}

<style>
    .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        padding: 0.5rem 1rem;
    }

    .navigation-row {
        display: flex;
        align-items: center;
        flex: 1;
        justify-content: flex-end;
    }

    #navigation {
        display: flex;
        align-items: center;
        width: auto;
    }

    .nav-box {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .navigation-menu {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
        list-style: none;
        gap: 0.2rem;
        flex-wrap: wrap;
    }

    .navigation-menu li {
        margin: 0;
    }

    .navigation-menu li a {
        display: inline-block;
        padding: 0.5rem 0.8rem;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 500;
        border-radius: 4px;
    }

    .navigation-menu li a:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .navigation-menu li .nav-action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.38);
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        font-weight: 700;
        cursor: pointer;
    }

    .navigation-menu li .nav-action-link:hover {
        background: rgba(255, 255, 255, 0.22);
        transform: translateY(-1px);
    }

    .navbar-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.5rem;
        cursor: pointer;
    }

    @media (max-width: 992px) {
        .navbar-toggle {
            display: block;
        }

        .nav-box {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.95);
            flex-direction: column;
            padding: 1rem;
            z-index: 1000;
        }

        .nav-box.active {
            display: flex;
        }

        .navigation-menu {
            flex-direction: column;
            width: 100%;
            text-align: center;
        }

        .navigation-menu li {
            width: 100%;
        }

        .navigation-menu li a {
            display: block;
            padding: 0.8rem;
        }

    }
</style>

