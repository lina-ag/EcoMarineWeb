{% extends 'base.html.twig' %}

{% block title %}EcoMarine - Écotourisme à Kuriat{% endblock %}

{% block body %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
        {{ message }}
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
{% endfor %}

<div id="video">

    <!-- Preloader -->
    <div class="preloader">
        <div class="preloader-bounce">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>

    <!-- Header / Navbar -->
    <header id="header">
        <div class="container-fluid">
            <div class="navbar">
                <a href="#" id="logo" title="EcoMarine">
                    <img src="/assets/images/logoEco.png" alt="EcoMarine" style="height: 110px; width: auto; vertical-align: middle;">
                </a>
                <div class="navigation-row">
                    <nav id="navigation">
                        <button type="button" class="navbar-toggle">
                            <i class="fa fa-bars"></i>
                        </button>
                        <div class="nav-box navbar-collapse">
                            <ul class="navigation-menu nav navbar-nav navbars" id="nav">
                                <li data-menuanchor="slide01" class="active"><a href="#slide01">Accueil</a></li>
                                <li data-menuanchor="slide02"><a href="#slide02">À Propos</a></li>
                                <li data-menuanchor="slide03"><a href="#slide03">Activités</a></li>
                                <li data-menuanchor="slide04"><a href="#slide04">Notre Mission</a></li>
                                <li data-menuanchor="slide05"><a href="#slide05">Galerie</a></li>
                                <li data-menuanchor="slide06"><a href="#slide06">Témoignages</a></li>
                                <li data-menuanchor="slide07"><a href="#slide07">Contact</a></li>
                                <li data-menuanchor="slide08"><a href="#slide08">Réservations</a></li>
                                <li data-menuanchor="slide09"><a href="#slide09">Activités Écologiques</a></li>
                                <li data-menuanchor="slide10"><a href="#slide10">Surveillance</a></li>
                                <li data-menuanchor="slide11"><a href="#slide11">Zones Protégées</a></li>
                            </ul>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>

    <!-- Vidéo de fond -->
    <video autoplay muted loop id="myVideo">
        <source src="/assets/images/video-bg.mp4" type="video/mp4">
    </video>

    <div id="fullpage" class="fullpage-default">

        <!-- SLIDE 01 — Accueil -->
        <div class="section animated-row" data-section="slide01" style="background-color: rgba(255, 255, 255, 0.05);">
