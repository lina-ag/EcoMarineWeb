{% set flash_messages = app.flashes %}

{% if flash_messages is not empty %}
    <div class="flash-stack" id="flashStack">
        {% for label, messages in flash_messages %}
            {% for message in messages %}
                <div class="flash-toast flash-{{ label }}" data-flash-toast>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

<style>
    .flash-stack {
        position: fixed;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: min(92vw, 720px);
        pointer-events: none;
    }

    .flash-toast {
        padding: 18px 24px;
        border-radius: 20px;
        color: #fff;
        text-align: center;
        font-size: 1rem;
        line-height: 1.4;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.22);
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .flash-toast.is-hiding {
        opacity: 0;
        transform: translateY(-14px);
    }

    .flash-success {
        background: #198754;
    }

    .flash-danger,
    .flash-error {
        background: #dc3545;
    }

    .flash-warning {
        background: #ffc107;
        color: #1f2937;
    }

    .flash-info {
        background: #0d6efd;
    }

