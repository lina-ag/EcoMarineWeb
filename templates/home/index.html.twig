                                    <label class="cleaning-filter-label" for="cleaningLieu">Filtrer par lieu</label>
                                    <select id="cleaningLieu" name="cleaning_lieu" class="cleaning-filter-control">
                                        <option value="">Tous les lieux</option>
                                        {% for lieu in cleaning_available_lieux|default([]) %}
                                            <option value="{{ lieu }}" {% if cleaning_filter_lieu|default('') == lieu %}selected{% endif %}>
