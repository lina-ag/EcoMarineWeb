{% set summary = this.summary %}

<div {{ attributes.defaults({class: 'activity-live-preview'}) }}>
    <input type="hidden" class="js-live-activity-name" data-model="activityName" value="{{ activityName }}">
    <input type="hidden" class="js-live-activity-date" data-model="activityDate" value="{{ activityDate }}">
    <input type="hidden" class="js-live-activity-capacity" data-model="capacity" value="{{ capacity }}">
    <input type="hidden" class="js-live-activity-description" data-model="description" value="{{ description }}">
    <input type="hidden" class="js-live-activity-recurring" data-model="isRecurring" value="{{ isRecurring }}">
    <input type="hidden" class="js-live-activity-end-date" data-model="recurrenceEndDate" value="{{ recurrenceEndDate }}">
    <input type="hidden" class="js-live-activity-days" data-model="selectedDays" value="{{ selectedDays }}">

    <div class="activity-live-preview-head">
        <div>
            <div class="activity-live-preview-kicker">Studio activite</div>
            <div class="activity-live-preview-title">{{ summary.title }}</div>
        </div>
        <span class="activity-live-preview-pill">{{ summary.status_label }}</span>
    </div>

    <div class="activity-live-preview-banner">
        <div>
            <span>Date</span>
            <strong>{{ summary.date_label }}</strong>
        </div>
        <div>
            <span>Saison</span>
            <strong>{{ summary.season_label }}</strong>
        </div>
        <div>
            <span>Format</span>
            <strong>{{ summary.tone }}</strong>
        </div>
    </div>

    <div class="activity-live-preview-grid">
        <div class="activity-live-preview-card">
            <span>Capacite</span>
            <strong>{{ summary.capacity }}</strong>
            <small>participants maximum</small>
        </div>
        <div class="activity-live-preview-card">
            <span>Description</span>
            <strong>{{ summary.description_length }}</strong>
            <small>{{ summary.description_quality }}</small>
        </div>
        <div class="activity-live-preview-card">
            <span>Recurrence</span>
            <strong>{{ summary.recurring ? 'Active' : 'Simple' }}</strong>
            <small>{{ summary.recurring ? summary.occurrence_count ~ ' occurrence(s)' : 'Une seule session' }}</small>
        </div>
    </div>

    <div class="activity-live-preview-recurrence">
        <span>Jours selectionnes</span>
        <strong>{{ summary.days_label }}</strong>
        <small>Fin de serie: {{ summary.end_date_label }}</small>
    </div>
</div>

<style>
    .activity-live-preview {
        margin-top: 1.1rem;
        padding: 1.15rem;
        border-radius: 22px;
        border: 1px solid rgba(186, 230, 253, 0.9);
        background:
            linear-gradient(135deg, rgba(236, 253, 245, 0.95), rgba(239, 246, 255, 0.95)),
            radial-gradient(circle at top left, rgba(16, 185, 129, 0.15), transparent 36%);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    .activity-live-preview-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.8rem;
        margin-bottom: 0.95rem;
    }

    .activity-live-preview-kicker {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #0f766e;
    }

    .activity-live-preview-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0f172a;
    }

    .activity-live-preview-pill {
        padding: 0.42rem 0.75rem;
        border-radius: 999px;
        background: rgba(15, 118, 110, 0.12);
        color: #115e59;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .activity-live-preview-banner {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 0.95rem;
    }

    .activity-live-preview-banner div,
    .activity-live-preview-card,
    .activity-live-preview-recurrence {
        padding: 0.9rem 1rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(191, 219, 254, 0.6);
    }

    .activity-live-preview-banner span,
    .activity-live-preview-card span,
    .activity-live-preview-recurrence span {
        display: block;
        margin-bottom: 0.22rem;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #64748b;
    }

    .activity-live-preview-banner strong,
    .activity-live-preview-card strong,
    .activity-live-preview-recurrence strong {
        display: block;
        color: #0f172a;
    }

    .activity-live-preview-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 0.95rem;
    }

    .activity-live-preview-card strong {
        font-size: 1.2rem;
    }

    .activity-live-preview-card small,
    .activity-live-preview-recurrence small {
        display: block;
        margin-top: 0.2rem;
        color: #64748b;
    }

    @media (max-width: 768px) {
        .activity-live-preview-banner,
        .activity-live-preview-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
